<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.distribution.dao.DmsMerchantLedgerDao">
  <resultMap id="Base" type="com.macro.mall.distribution.entity.DmsMerchantLedger">
    <id column="id" property="id"/><result column="tenant_id" property="tenantId"/><result column="merchant_id" property="merchantId"/><result column="merchant_name" property="merchantName"/>
    <result column="ledger_no" property="ledgerNo"/><result column="biz_type" property="bizType"/><result column="biz_id" property="bizId"/><result column="summary" property="summary"/>
    <result column="pending_delta" property="pendingDelta"/><result column="available_delta" property="availableDelta"/><result column="frozen_delta" property="frozenDelta"/><result column="deposit_delta" property="depositDelta"/><result column="debt_delta" property="debtDelta"/><result column="paid_delta" property="paidDelta"/>
    <result column="pending_after" property="pendingAfter"/><result column="available_after" property="availableAfter"/><result column="frozen_after" property="frozenAfter"/><result column="deposit_after" property="depositAfter"/><result column="debt_after" property="debtAfter"/><result column="paid_after" property="paidAfter"/>
    <result column="operator_id" property="operatorId"/><result column="operator_name" property="operatorName"/><result column="create_time" property="createTime"/>
  </resultMap>
  <sql id="cols">l.id,l.tenant_id,l.merchant_id,COALESCE(l.merchant_name,m.merchant_name) merchant_name,l.ledger_no,l.biz_type,l.biz_id,l.summary,l.pending_delta,l.available_delta,l.frozen_delta,l.deposit_delta,l.debt_delta,l.paid_delta,l.pending_after,l.available_after,l.frozen_after,l.deposit_after,l.debt_after,l.paid_after,l.operator_id,l.operator_name,l.create_time</sql>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO dms_merchant_ledger(tenant_id,merchant_id,merchant_name,ledger_no,biz_type,biz_id,summary,pending_delta,available_delta,frozen_delta,deposit_delta,debt_delta,paid_delta,pending_after,available_after,frozen_after,deposit_after,debt_after,paid_after,operator_id,operator_name) VALUES(#{tenantId},#{merchantId},#{merchantName},#{ledgerNo},#{bizType},#{bizId},#{summary},#{pendingDelta},#{availableDelta},#{frozenDelta},#{depositDelta},#{debtDelta},#{paidDelta},#{pendingAfter},#{availableAfter},#{frozenAfter},#{depositAfter},#{debtAfter},#{paidAfter},#{operatorId},#{operatorName})</insert>
  <select id="selectList" resultMap="Base">SELECT <include refid="cols"/> FROM dms_merchant_ledger l LEFT JOIN dms_merchant m ON m.id=l.merchant_id WHERE l.tenant_id=#{tenantId}<if test="merchantId != null"> AND l.merchant_id=#{merchantId}</if><if test="bizType != null and bizType != ''"> AND l.biz_type=#{bizType}</if> ORDER BY l.id DESC</select>
</mapper>
