<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.distribution.dao.DmsErpIntegrationDao">
  <resultMap id="base" type="com.macro.mall.distribution.entity.DmsErpIntegration"><id column="id" property="id"/><result column="tenant_id" property="tenantId"/><result column="provider_code" property="providerCode"/><result column="integration_name" property="integrationName"/><result column="app_key" property="appKey"/><result column="app_secret" property="appSecret"/><result column="callback_token" property="callbackToken"/><result column="create_time" property="createTime"/><result column="update_time" property="updateTime"/></resultMap>
  <sql id="columns">id,tenant_id,provider_code,integration_name,enabled,environment,endpoint,app_key,app_secret,callback_token,remark,create_time,update_time</sql>
  <select id="selectById" resultMap="base">SELECT <include refid="columns"/> FROM dms_erp_integration WHERE id=#{id}</select>
  <select id="selectByTenantAndProvider" resultMap="base">SELECT <include refid="columns"/> FROM dms_erp_integration WHERE tenant_id=#{tenantId} AND provider_code=#{providerCode}</select>
  <select id="selectEnabled" resultMap="base">SELECT <include refid="columns"/> FROM dms_erp_integration WHERE tenant_id=#{tenantId} AND enabled=1</select>
  <select id="selectList" resultMap="base">SELECT <include refid="columns"/> FROM dms_erp_integration WHERE tenant_id=#{tenantId} ORDER BY id DESC</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO dms_erp_integration(tenant_id,provider_code,integration_name,enabled,environment,endpoint,app_key,app_secret,callback_token,remark) VALUES(#{tenantId},#{providerCode},#{integrationName},#{enabled},#{environment},#{endpoint},#{appKey},#{appSecret},#{callbackToken},#{remark})</insert>
  <update id="update">UPDATE dms_erp_integration SET integration_name=#{integrationName},enabled=#{enabled},environment=#{environment},endpoint=#{endpoint},app_key=#{appKey},app_secret=COALESCE(#{appSecret},app_secret),callback_token=COALESCE(#{callbackToken},callback_token),remark=#{remark},update_time=NOW() WHERE id=#{id}</update>
</mapper>
