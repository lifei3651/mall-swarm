<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.distribution.dao.DmsOrderPvDetailDao">

    <resultMap id="BaseResultMap" type="com.macro.mall.distribution.entity.DmsOrderPvDetail">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="product_id" property="productId"/>
        <result column="sku_id" property="skuId"/>
        <result column="product_name" property="productName"/>
        <result column="quantity" property="quantity"/>
        <result column="pay_amount" property="payAmount"/>
        <result column="pv_value" property="pvValue"/>
        <result column="total_pv" property="totalPv"/>
        <result column="bv_value" property="bvValue"/>
        <result column="total_bv" property="totalBv"/>
        <result column="cost_amount" property="costAmount"/>
        <result column="total_cost" property="totalCost"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT id, tenant_id, order_id, order_no, product_id, sku_id, product_name, quantity,
               pay_amount, pv_value, total_pv, bv_value, total_bv, cost_amount, total_cost, create_time
        FROM dms_order_pv_detail
        WHERE order_id = #{orderId}
        ORDER BY id ASC
    </select>

    <insert id="insert" parameterType="com.macro.mall.distribution.entity.DmsOrderPvDetail" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dms_order_pv_detail
        (tenant_id, order_id, order_no, product_id, sku_id, product_name, quantity, pay_amount,
         pv_value, total_pv, bv_value, total_bv, cost_amount, total_cost)
        VALUES
        (#{tenantId}, #{orderId}, #{orderNo}, #{productId}, #{skuId}, #{productName}, #{quantity}, #{payAmount},
         #{pvValue}, #{totalPv}, #{bvValue}, #{totalBv}, #{costAmount}, #{totalCost})
    </insert>
</mapper>
