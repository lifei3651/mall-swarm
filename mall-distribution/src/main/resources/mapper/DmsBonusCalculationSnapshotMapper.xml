<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.distribution.dao.DmsBonusCalculationSnapshotDao">

    <resultMap id="BaseResultMap" type="com.macro.mall.distribution.entity.DmsBonusCalculationSnapshot">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="rule_version_id" property="ruleVersionId"/>
        <result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="input_json" property="inputJson"/>
        <result column="result_json" property="resultJson"/>
        <result column="total_pv" property="totalPv"/>
        <result column="total_bonus" property="totalBonus"/>
        <result column="risk_status" property="riskStatus"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT id, tenant_id, rule_version_id, order_id, order_no, input_json, result_json,
               total_pv, total_bonus, risk_status, create_time
        FROM dms_bonus_calculation_snapshot
        WHERE order_id = #{orderId}
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="com.macro.mall.distribution.entity.DmsBonusCalculationSnapshot" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dms_bonus_calculation_snapshot
        (tenant_id, rule_version_id, order_id, order_no, input_json, result_json, total_pv, total_bonus, risk_status)
        VALUES
        (#{tenantId}, #{ruleVersionId}, #{orderId}, #{orderNo}, #{inputJson}, #{resultJson}, #{totalPv}, #{totalBonus}, #{riskStatus})
    </insert>
</mapper>
