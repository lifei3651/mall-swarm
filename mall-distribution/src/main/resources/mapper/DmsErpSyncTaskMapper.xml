<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.distribution.dao.DmsErpSyncTaskDao">
  <resultMap id="base" type="com.macro.mall.distribution.entity.DmsErpSyncTask"><id column="id" property="id"/><result column="task_no" property="taskNo"/><result column="integration_id" property="integrationId"/><result column="tenant_id" property="tenantId"/><result column="provider_code" property="providerCode"/><result column="biz_type" property="bizType"/><result column="biz_id" property="bizId"/><result column="status" property="status"/><result column="retry_count" property="retryCount"/><result column="next_retry_time" property="nextRetryTime"/><result column="request_summary" property="requestSummary"/><result column="response_summary" property="responseSummary"/><result column="last_error" property="lastError"/><result column="create_time" property="createTime"/><result column="update_time" property="updateTime"/></resultMap>
  <sql id="columns">id,task_no,integration_id,tenant_id,provider_code,biz_type,biz_id,status,retry_count,next_retry_time,request_summary,response_summary,last_error,create_time,update_time</sql>
  <select id="selectById" resultMap="base">SELECT <include refid="columns"/> FROM dms_erp_sync_task WHERE id=#{id}</select>
  <select id="selectByUnique" resultMap="base">SELECT <include refid="columns"/> FROM dms_erp_sync_task WHERE integration_id=#{integrationId} AND biz_type=#{bizType} AND biz_id=#{bizId}</select>
  <select id="selectList" resultMap="base">
    SELECT <include refid="columns"/> FROM dms_erp_sync_task WHERE 1=1
    <if test="integrationId != null"> AND integration_id=#{integrationId}</if>
    <if test="status != null"> AND status=#{status}</if>
    ORDER BY id DESC
  </select>
  <select id="selectRetryable" resultMap="base">SELECT <include refid="columns"/> FROM dms_erp_sync_task WHERE status IN (0,2) AND retry_count &lt; #{maxRetryCount} AND (next_retry_time IS NULL OR next_retry_time &lt;= #{now}) ORDER BY id ASC LIMIT #{limit}</select>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO dms_erp_sync_task(task_no,integration_id,tenant_id,provider_code,biz_type,biz_id,status,retry_count,request_summary) VALUES(#{taskNo},#{integrationId},#{tenantId},#{providerCode},#{bizType},#{bizId},#{status},#{retryCount},#{requestSummary})</insert>
  <update id="markSuccess">UPDATE dms_erp_sync_task SET status=1,response_summary=#{response},last_error=NULL,next_retry_time=NULL,update_time=NOW() WHERE id=#{id}</update>
  <update id="stopExceededRetries">UPDATE dms_erp_sync_task SET status=3,next_retry_time=NULL,last_error=CONCAT('已达到自动重试上限（',#{maxRetryCount},'次）：',COALESCE(last_error,'ERP推送失败')),update_time=NOW() WHERE status=2 AND retry_count &gt;= #{maxRetryCount}</update>
  <update id="markFailure">UPDATE dms_erp_sync_task SET status=#{status},retry_count=#{retryCount},next_retry_time=#{nextRetryTime},last_error=#{error},update_time=NOW() WHERE id=#{id}</update>
</mapper>
