<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.distribution.dao.DmsFreightTemplateDao">

    <resultMap id="BaseResultMap" type="com.macro.mall.distribution.entity.DmsFreightTemplate">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="template_name" property="templateName"/>
        <result column="default_mode" property="defaultMode"/>
        <result column="default_freight_amount" property="defaultFreightAmount"/>
        <result column="rules_json" property="rulesJson"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Columns">id,tenant_id,template_name,default_mode,default_freight_amount,rules_json,status,create_time,update_time</sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Columns"/> FROM dms_freight_template WHERE id=#{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Columns"/> FROM dms_freight_template
        WHERE tenant_id=#{tenantId}
        <if test="status != null">AND status=#{status}</if>
        ORDER BY status DESC,id DESC
    </select>

    <insert id="insert" parameterType="com.macro.mall.distribution.entity.DmsFreightTemplate" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dms_freight_template
          (tenant_id,template_name,default_mode,default_freight_amount,rules_json,status)
        VALUES
          (#{tenantId},#{templateName},#{defaultMode},#{defaultFreightAmount},#{rulesJson},#{status})
    </insert>

    <update id="update" parameterType="com.macro.mall.distribution.entity.DmsFreightTemplate">
        UPDATE dms_freight_template
        SET template_name=#{templateName},default_mode=#{defaultMode},
            default_freight_amount=#{defaultFreightAmount},rules_json=#{rulesJson},status=#{status},
            update_time=CURRENT_TIMESTAMP
        WHERE id=#{id} AND tenant_id=#{tenantId}
    </update>
</mapper>
