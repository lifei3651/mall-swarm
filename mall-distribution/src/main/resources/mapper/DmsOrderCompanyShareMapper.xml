<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.distribution.dao.DmsOrderCompanyShareDao">

    <resultMap id="BaseResultMap" type="com.macro.mall.distribution.entity.DmsOrderCompanyShare">
        <id column="id" property="id"/>
        <result column="order_id" property="orderId"/>
        <result column="order_no" property="orderNo"/>
        <result column="account_id" property="accountId"/>
        <result column="account_name" property="accountName"/>
        <result column="share_rate" property="shareRate"/>
        <result column="share_amount" property="shareAmount"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <resultMap id="SummaryResultMap" type="com.macro.mall.distribution.vo.CompanyShareSummaryVO">
        <result column="account_id" property="accountId"/>
        <result column="account_name" property="accountName"/>
        <result column="order_count" property="orderCount"/>
        <result column="share_amount" property="shareAmount"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT id, order_id, order_no, account_id, account_name, share_rate, share_amount,
               remark, create_time, update_time
        FROM dms_order_company_share
        WHERE order_id = #{orderId}
        ORDER BY id ASC
    </select>

    <select id="selectSummary" resultMap="SummaryResultMap">
        SELECT account_id, account_name, COUNT(DISTINCT order_id) AS order_count,
               IFNULL(SUM(share_amount), 0) AS share_amount
        FROM dms_order_company_share
        WHERE 1 = 1
        <if test="startTime != null">
            AND create_time &gt;= #{startTime}
        </if>
        <if test="endTime != null">
            AND create_time &lt; #{endTime}
        </if>
        GROUP BY account_id, account_name
        ORDER BY share_amount DESC
    </select>

    <insert id="insert" parameterType="com.macro.mall.distribution.entity.DmsOrderCompanyShare" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO dms_order_company_share (order_id, order_no, account_id, account_name, share_rate, share_amount, remark)
        VALUES (#{orderId}, #{orderNo}, #{accountId}, #{accountName}, #{shareRate}, #{shareAmount}, #{remark})
    </insert>

    <delete id="deleteByOrderId">
        DELETE FROM dms_order_company_share WHERE order_id = #{orderId}
    </delete>
</mapper>
