# 支付宝（密钥内容建议通过容器 Secret 注入，不要提交真实值）
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.example/api/pay/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.example/api/pay/alipay/return
ALIPAY_CONNECT_TIMEOUT_MS=5000
ALIPAY_READ_TIMEOUT_MS=10000

# 微信支付 API v3
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechatpay/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://your-domain.example/wxpay/notify

# 微信小程序登录（公共代码、客户独立资质）。未完成客户主体、隐私政策和域名审核时保持关闭。
WECHAT_MINI_PROGRAM_ENABLED=false
WECHAT_MINI_PROGRAM_PHONE_AUTH_ENABLED=false
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_APP_SECRET=
WECHAT_MINI_PROGRAM_PRIVACY_VERSION=MINI_PROGRAM_PRIVACY_V1
WECHAT_MINI_PROGRAM_CONNECT_TIMEOUT_MS=5000
WECHAT_MINI_PROGRAM_READ_TIMEOUT_MS=10000

# 阿里云短信（请使用仅有短信发送权限的 RAM 用户）
SMS_PROVIDER_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_REGISTER=
ALIYUN_SMS_TEMPLATE_LOGIN=
ALIYUN_SMS_TEMPLATE_RESET_PASSWORD=

# 私域直播：未接云直播时保持 EXTERNAL；启用 TENCENT 后下列三项必须由服务器受限环境文件提供。
SHOP_LIVE_PROVIDER=EXTERNAL
LIVE_PLAYBACK_ORIGIN=
TENCENT_LIVE_PUSH_DOMAIN=
TENCENT_LIVE_PLAY_DOMAIN=
TENCENT_LIVE_APP_NAME=live
TENCENT_LIVE_PUSH_AUTH_KEY=
TENCENT_LIVE_CALLBACK_AUTH_KEY=
TENCENT_LIVE_CREDENTIAL_SECONDS=7200

# 生产数据库传输加密。远程数据库建议 VERIFY_IDENTITY；仅本机回环数据库可按部署核验结果使用 REQUIRED。
DB_SSL_MODE=VERIFY_IDENTITY
