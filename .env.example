# 支付宝（密钥内容建议通过容器 Secret 注入，不要提交真实值）
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_APP_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://your-domain.example/alipay/notify
ALIPAY_RETURN_URL=https://your-domain.example/pay/result

# 微信支付 API v3
WECHAT_PAY_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechatpay/apiclient_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=https://your-domain.example/wxpay/notify

# 阿里云短信（请使用仅有短信发送权限的 RAM 用户）
SMS_PROVIDER_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_REGISTER=
ALIYUN_SMS_TEMPLATE_LOGIN=
ALIYUN_SMS_TEMPLATE_RESET_PASSWORD=

# 生产数据库传输加密。远程数据库建议 VERIFY_IDENTITY；仅本机回环数据库可按部署核验结果使用 REQUIRED。
DB_SSL_MODE=VERIFY_IDENTITY
