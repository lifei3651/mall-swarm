.balance-mask { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: flex-end; background: rgba(15,23,42,.45); }.balance-sheet { box-sizing: border-box; width: 100%; max-height: 88vh; overflow-y: auto; padding: 38rpx 32rpx calc(32rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: var(--paper); }.balance-title { text-align: center; font-size: 34rpx; font-weight: 600; }.balance-pay-amount { display: block; margin: 20rpx 0; text-align: center; font-size: 48rpx; font-weight: 700; }.balance-pay-hint { display: block; color: var(--muted); font-size: 24rpx; line-height: 1.65; margin: 20rpx 0; }.balance-label { display: block; font-size: 27rpx; margin-bottom: 16rpx; }.balance-password-input { height: 88rpx; padding: 0 24rpx; margin: 16rpx 0 28rpx; border: 1rpx solid var(--line); border-radius: 16rpx; font-size: 30rpx; }.balance-sheet .primary-button { width: 100%; }.balance-close { color: var(--muted); background: transparent; margin: 20rpx 0 0; font-size: 26rpx; }
.balance-setup-label { display:block; margin:18rpx 0 8rpx; color:var(--ink); font-size:25rpx; }
.balance-setup-input { box-sizing:border-box; width:100%; height:72rpx; padding:0 18rpx; border:1rpx solid var(--line); border-radius:14rpx; background:var(--paper); font-size:26rpx; }
.balance-setup-sms { display:flex; align-items:center; gap:14rpx; }
.balance-setup-sms .balance-setup-input { flex:1; min-width:0; }
.balance-setup-sms button { flex:none; width:auto; margin:0; padding:12rpx 20rpx; font-size:24rpx; }
.balance-setup-help { width:auto; margin:10rpx 0 0; padding:10rpx 18rpx; font-size:23rpx; }
.balance-setup-error { display:block; margin:14rpx 0; color:#b42318; font-size:24rpx; }
.balance-setup-notice { display:block; margin:12rpx 0; color:var(--brand); font-size:24rpx; }
