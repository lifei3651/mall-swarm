.sku-overlay { position: fixed; inset: 0; z-index: 200; display: flex; align-items: flex-end; background: rgba(20,25,35,.45); }
.sku-sheet { width: 100%; max-height: 85vh; padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: var(--paper); }
.sku-heading { display: flex; align-items: center; justify-content: space-between; font-size: 34rpx; font-weight: 650; }
.sku-heading .sku-close { width: auto; min-height: 80rpx; margin: 0; padding: 18rpx 12rpx; color: var(--muted); background: transparent; font-size: 26rpx; line-height: 40rpx; }
.sku-product-name { margin-top: 16rpx; font-size: 28rpx; line-height: 42rpx; }
.sku-price { margin: 16rpx 0 24rpx; color: var(--price); font-size: 30rpx; }
.sku-options { max-height: 32vh; }
.sku-options .sku-option { width: 100%; min-height: 88rpx; margin: 0 0 16rpx; padding: 20rpx; border: 1rpx solid var(--line); border-radius: 16rpx; color: var(--ink); background: var(--canvas); font-size: 26rpx; line-height: 42rpx; text-align: left; }
.sku-options .selected { color: var(--accent); border-color: var(--accent); background: var(--brand-soft); }
.sku-options .sku-option.is-disabled { color: #8a919c; background: #f2f3f5; }
.sku-sheet .sku-confirm { margin-top: 24rpx; }
