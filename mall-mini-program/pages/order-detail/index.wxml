<view class="detail-page">
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>
  <view wx:elif="{{error}}" class="empty-state">
    <text>{{error}}</text>
    <button class="secondary-button" bindtap="openOrders">查看我的订单</button>
  </view>
  <view wx:elif="{{!rows.length}}" class="empty-state">
    <text>没有找到对应订单</text>
    <button class="secondary-button" bindtap="openOrders">查看我的订单</button>
  </view>
  <block wx:else>
    <view class="payment-summary">
      <text class="summary-label">微信支付订单</text>
      <view class="summary-amount">¥{{totalText}}</view>
      <text class="summary-meta">本次付款包含 {{rows.length}} 个履约订单</text>
      <text class="summary-no">商户单号 {{paymentNo}}</text>
    </view>
    <view class="order-card" wx:for="{{rows}}" wx:key="key">
      <view class="order-head">
        <view>
          <text class="merchant-name">{{item.order.merchantName || '商城订单'}}</text>
          <text class="order-no">订单号 {{item.order.orderNo}}</text>
        </view>
        <text class="order-status">{{item.order.statusText}}</text>
      </view>
      <view class="order-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="line">
        <image src="{{line.productCover}}" mode="aspectFill" />
        <view class="item-copy">
          <text class="item-name">{{line.productName}}</text>
          <text class="item-spec">{{line.skuName || '默认规格'}} × {{line.quantity}}</text>
        </view>
        <text class="item-price">¥{{line.priceText}}</text>
      </view>
      <view class="recipient" wx:if="{{item.order.addressText}}">
        <text>{{item.order.receiverName}} {{item.order.receiverPhone}}</text>
        <text>{{item.order.addressText}}</text>
      </view>
      <block wx:if="{{item.shipments.length}}">
        <view class="shipment" wx:for="{{item.shipments}}" wx:key="id" wx:for-item="shipment">
          <view><text>物流</text><text>{{shipment.deliveryCompany || '物流公司待更新'}}</text></view>
          <view><text>运单号</text><text>{{shipment.deliveryNo || '-'}}</text></view>
          <view wx:if="{{shipment.deliveryTimeText}}"><text>发货时间</text><text>{{shipment.deliveryTimeText}}</text></view>
        </view>
      </block>
      <view class="order-info">
        <view><text>下单时间</text><text>{{item.order.createTimeText || '-'}}</text></view>
        <view><text>付款时间</text><text>{{item.order.payTimeText || '-'}}</text></view>
        <view><text>实付金额</text><text class="paid-amount">¥{{item.order.amountText}}</text></view>
      </view>
      <button wx:if="{{item.order.status === 2}}" class="primary-button receive-button"
        data-id="{{item.order.id}}" loading="{{actingId === item.order.id}}" disabled="{{actingId !== null}}"
        bindtap="receive">确认收货</button>
    </view>
    <button class="secondary-button all-orders" bindtap="openOrders">查看全部订单</button>
  </block>
</view>
