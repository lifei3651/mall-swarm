<view class="detail-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>
  <view wx:elif="{{error}}" class="empty-state">
    <text>{{error}}</text>
    <button class="secondary-button" bindtap="openOrders">查看我的订单</button>
  </view>
  <view wx:elif="{{!rows.length}}" class="empty-state">
    <text>没有找到对应订单</text>
    <button class="secondary-button" bindtap="openOrders">查看我的订单</button>
  </view>
  <block wx:else>
    <view class="status-hero">
      <text class="status-eyebrow">订单进度</text>
      <text class="status-title">{{pageStatusTitle}}</text>
      <text class="status-description">{{pageStatusDescription}}</text>
      <view class="status-summary">
        <view><text class="status-amount-label">{{summaryLabel}}</text><text class="status-amount">¥{{totalText}}</text></view>
        <text class="status-count">{{summaryMeta}}</text>
      </view>
      <text class="status-number">商户单号 {{paymentNo}}</text>
      <text wx:if="{{paymentHint}}" class="payment-hint">{{paymentHint}}</text>
      <button wx:if="{{payOrderId}}" class="primary-button continue-payment" bindtap="pay" loading="{{paying}}" disabled="{{actingId !== null}}">{{paying ? '正在确认支付…' : rows.length > 1 ? '合并支付' : '继续支付'}}</button>
    </view>

    <block wx:for="{{rows}}" wx:key="key">
      <view wx:if="{{item.shipments.length}}" class="section-card logistics-card">
        <view class="section-heading">
          <view class="section-heading-main">
            <image class="section-icon" src="/assets/profile/truck.png" mode="aspectFit" />
            <view>
              <text class="section-title">物流信息</text>
              <text class="section-subtitle">{{item.shipments.length > 1 ? '本订单分为 ' + item.shipments.length + ' 个包裹' : item.order.status === 3 ? '订单已签收' : '商品已交由承运商配送'}}</text>
            </view>
          </view>
          <button class="text-action" data-id="{{item.order.id}}" bindtap="loadTracking" loading="{{trackingLoading && trackingOrderId === item.order.id}}" disabled="{{trackingLoading}}">{{trackingOrderId === item.order.id ? '刷新物流' : '查看轨迹'}}</button>
        </view>
        <view class="shipment-list">
          <view class="shipment-row" wx:for="{{item.shipments}}" wx:key="key" wx:for-item="shipment">
            <view class="shipment-main">
              <text class="package-label">{{shipment.packageLabel}}</text>
              <text class="shipment-company">{{shipment.deliveryCompany || '物流公司待更新'}}</text>
              <text class="shipment-number">运单号 {{shipment.deliveryNo || '-'}}</text>
              <text wx:if="{{shipment.deliveryTimeText}}" class="shipment-time">发货时间 {{shipment.deliveryTimeText}}</text>
            </view>
            <button wx:if="{{shipment.deliveryNo}}" class="copy-inline" data-number="{{shipment.deliveryNo}}" bindtap="copyDeliveryNo">复制</button>
          </view>
        </view>
        <view wx:if="{{trackingOrderId === item.order.id}}" class="tracking-panel">
          <text wx:if="{{trackingError}}" class="shipment-error">{{trackingError}}</text>
          <text wx:if="{{!trackingLoading && !trackingError && !trackingRows.length}}" class="tracking-empty">暂未查到新的物流节点，可先复制运单号向承运商查询。</text>
          <view wx:for="{{trackingRows}}" wx:key="deliveryNo" wx:for-item="tracking" class="tracking-record">
            <view class="tracking-state {{tracking.configured ? 'is-live' : 'is-pending'}}"><text>{{tracking.statusText}}</text><text>{{tracking.statusHint}}</text></view>
            <view wx:for="{{tracking.events}}" wx:key="index" wx:for-item="progress" class="tracking-event"><text>{{progress.description}}{{progress.location ? ' · ' + progress.location : ''}}</text><text>{{progress.time}}</text></view>
          </view>
        </view>
      </view>

      <view wx:if="{{item.order.addressText}}" class="section-card address-card">
        <view class="section-heading-main">
          <image class="section-icon" src="/assets/profile/map-pin.png" mode="aspectFit" />
          <view class="recipient-copy"><text class="recipient-name">{{item.order.receiverName}}  {{item.order.receiverPhone}}</text><text class="recipient-address">{{item.order.addressText}}</text></view>
        </view>
      </view>

      <view class="section-card product-card">
        <view class="order-head"><view><text class="merchant-name">{{item.order.merchantName || '商城订单'}}</text><text class="order-no">订单号 {{item.order.orderNo}}</text></view><text class="order-status">{{item.order.statusText}}</text></view>
        <view class="order-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="line">
          <image src="{{line.productCover}}" mode="aspectFill" />
          <view class="item-copy"><text class="item-name">{{line.productName}}</text><text class="item-spec">{{line.skuName || '默认规格'}} × {{line.quantity}}</text></view>
          <text class="item-price">¥{{line.priceText}}</text>
        </view>
        <view class="product-footer"><button class="copy-order" data-id="{{item.order.id}}" bindtap="copyOrderNo">复制订单号</button><view><text>{{item.itemQuantity}} 件商品  {{item.order.amountLabel}} </text><text class="paid-amount">¥{{item.order.amountText}}</text></view></view>
      </view>

      <view wx:if="{{item.afterSales.length}}" class="section-card after-sale-list">
        <view class="section-title">退款 / 售后进度</view>
        <view class="after-sale-record" wx:for="{{item.afterSales}}" wx:key="id" wx:for-item="sale">
          <view class="after-sale-head"><view><text>{{sale.typeText}}</text><text>{{sale.afterSaleNo}}</text></view><text>{{sale.statusText}}</text></view>
          <view class="after-sale-meta"><text>{{sale.createTimeText}}</text><text wx:if="{{sale.applyType !== 3}}">¥{{sale.amountText}}</text></view>
          <text wx:if="{{sale.nextActionHint}}" class="next-action">{{sale.nextActionHint}}</text>
          <text wx:if="{{sale.auditRemark}}" class="audit-remark">处理说明：{{sale.auditRemark}}</text>
          <view wx:if="{{sale.canReturn}}" class="return-info">
            <text class="next-action">退货地址：{{sale.returnAddress || '等待商家提供退货地址，请勿自行寄回'}}</text>
            <text wx:if="{{sale.returnDeliveryNo}}" class="next-action">已寄回：{{sale.returnDeliveryCompany}} {{sale.returnDeliveryNo}}</text>
            <button class="secondary-button sale-action" data-id="{{sale.id}}" bindtap="editShipment">{{sale.status === 5 ? '修改退货物流' : '填写退货物流'}}</button>
          </view>
          <text wx:if="{{sale.exchangeDeliveryNo}}" class="next-action">换货物流：{{sale.exchangeDeliveryCompany}} {{sale.exchangeDeliveryNo}}</text>
          <button wx:if="{{sale.exchangeDeliveryNo}}" class="secondary-button sale-action" data-number="{{sale.exchangeDeliveryNo}}" bindtap="copyDeliveryNo">复制换货运单号</button>
          <view wx:for="{{sale.items}}" wx:key="id" wx:for-item="saleLine" class="sale-item"><text>{{saleLine.productName}} {{saleLine.skuName}}</text><text>× {{saleLine.refundQuantity}}</text></view>
          <button wx:if="{{sale.canReapply}}" class="secondary-button sale-action" data-id="{{sale.orderId}}" bindtap="applyAfterSale">补充凭证重新申请</button>
          <button wx:if="{{sale.canReceiveExchange}}" class="primary-button sale-action" data-id="{{sale.id}}" loading="{{cancellingAfterSaleId === sale.id}}" disabled="{{cancellingAfterSaleId !== null}}" bindtap="receiveExchange">确认收到换货商品</button>
          <view wx:if="{{editingSaleId === sale.id}}" class="shipment-form">
            <text class="form-label">快递公司</text>
            <picker range="{{carriers}}" bindchange="selectCarrier" disabled="{{submittingShipment}}" aria-label="选择退货快递"><view class="shipment-input ui-select-row"><text>{{deliveryCompany || '从常用快递中选择'}}</text><image class="ui-select-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" /></view></picker>
            <input class="shipment-input" value="{{deliveryCompany}}" data-field="deliveryCompany" bindinput="shipmentInput" maxlength="50" placeholder="例如：顺丰速运" disabled="{{submittingShipment}}" aria-label="退货快递公司" />
            <text class="form-label">快递单号</text>
            <input class="shipment-input" value="{{deliveryNo}}" data-field="deliveryNo" bindinput="shipmentInput" maxlength="64" placeholder="请输入4至64位快递单号" disabled="{{submittingShipment}}" aria-label="退货快递单号" />
            <text wx:if="{{shipmentError}}" class="shipment-error">{{shipmentError}}</text>
            <button class="primary-button sale-action" bindtap="submitShipment" loading="{{submittingShipment}}" disabled="{{submittingShipment}}">保存退货物流</button>
            <button class="secondary-button sale-action" bindtap="closeShipment" disabled="{{submittingShipment}}">暂不填写</button>
          </view>
          <button wx:if="{{sale.cancellable}}" class="secondary-button cancel-after-sale" data-id="{{sale.id}}" loading="{{cancellingAfterSaleId === sale.id}}" disabled="{{cancellingAfterSaleId !== null}}" bindtap="cancelAfterSale">取消申请</button>
        </view>
      </view>

      <view class="section-card amount-card">
        <view class="amount-row"><text>商品金额</text><text>¥{{item.order.totalText}}</text></view>
        <view wx:if="{{item.order.freightAmount !== null && item.order.freightAmount !== undefined}}" class="amount-row"><text>运费</text><text>¥{{item.order.freightText}}</text></view>
        <view wx:if="{{item.order.couponClaimId}}" class="amount-row discount"><text>优惠券 · {{item.order.couponTitle}}</text><text>−¥{{item.order.discountAmount}}</text></view>
        <view class="amount-row amount-total"><text>{{item.order.amountLabel}}</text><text>¥{{item.order.amountText}}</text></view>
      </view>

      <view class="section-card order-info">
        <button class="order-info-toggle" data-id="{{item.order.id}}" bindtap="toggleOrderInfo" aria-expanded="{{!!expandedOrders[item.order.id]}}"><text>订单信息</text><text>{{expandedOrders[item.order.id] ? '收起' : '展开'}}</text></button>
        <block wx:if="{{expandedOrders[item.order.id]}}">
          <view><text>订单编号</text><text>{{item.order.orderNo}}</text></view>
          <view><text>下单时间</text><text>{{item.order.createTimeText || '-'}}</text></view>
          <view><text>付款时间</text><text>{{item.order.payTimeText || '-'}}</text></view>
          <view><text>支付方式</text><text>{{item.order.payType === 'BALANCE' ? '余额支付' : item.order.payType === 'WECHAT' ? '微信支付' : item.order.payType === 'ALIPAY' ? '支付宝' : '商城支付'}}</text></view>
        </block>
      </view>

      <view class="detail-actions">
        <button wx:if="{{item.order.status === 0}}" class="secondary-button cancel-order" data-id="{{item.order.id}}" disabled="{{actingId !== null}}" bindtap="cancelOrder">取消订单</button>
        <button wx:if="{{item.pendingReviewProductId && item.pendingReviewOrderItemId}}" class="primary-button" data-id="{{item.order.id}}" bindtap="review">去评价</button>
        <button wx:if="{{item.canApplyAfterSale}}" class="secondary-button" data-id="{{item.order.id}}" bindtap="applyAfterSale">申请售后</button>
        <button wx:if="{{item.canReceive}}" class="primary-button receive-button" data-id="{{item.order.id}}" loading="{{actingId === item.order.id}}" disabled="{{actingId !== null}}" bindtap="receive">确认收货</button>
      </view>
    </block>
  </block>
  <include src="../../templates/balance-payment.wxml" />
</view>
