<view class="detail-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>
  <view wx:elif="{{error}}" class="empty-state">
    <text>{{error}}</text>
    <button class="secondary-button" bindtap="openOrders">查看我的订单</button>
  </view>
  <view wx:elif="{{!rows.length}}" class="empty-state">
    <text>没有找到对应订单</text>
    <button class="secondary-button" bindtap="openOrders">查看我的订单</button>
  </view>
  <block wx:else>
    <view class="status-hero">
      <text class="status-hero-title">{{pageStatusTitle}}</text>
      <text class="status-hero-description">{{pageStatusDescription}}</text>
      <text wx:if="{{paymentHint}}" class="payment-hint">{{paymentHint}}</text>
      <button wx:if="{{payOrderId}}" class="primary-button continue-payment" bindtap="pay" loading="{{paying}}" disabled="{{actingId !== null}}">{{paying ? '正在确认支付…' : rows.length > 1 ? '合并支付' : '继续支付'}}</button>
    </view>

    <block wx:for="{{rows}}" wx:key="key">
      <view wx:if="{{item.memberIncome}}" class="income-card ui-card">
        <button class="income-toggle" data-id="{{item.order.id}}" bindtap="toggleIncome" aria-expanded="{{!!expandedIncome[item.order.id]}}">
          <view class="income-title"><text class="income-coin">¥</text><text>我的结算收入</text></view>
          <view class="income-value"><text class="ui-price">¥{{item.memberIncome.totalText}}</text><text class="income-chevron">{{expandedIncome[item.order.id] ? '⌃' : '›'}}</text></view>
        </button>
        <view wx:if="{{expandedIncome[item.order.id]}}" class="income-details">
          <view class="income-summary"><text>待结算 ¥{{item.memberIncome.pendingText}}</text><text>已结算 ¥{{item.memberIncome.settledText}}</text></view>
          <view wx:for="{{item.memberIncome.details}}" wx:key="index" wx:for-item="incomeLine" class="income-line">
            <view><text>{{incomeLine.bonusType || '结算收入'}}</text><text>{{incomeLine.commissionLevel ? incomeLine.commissionLevel + '级' : ''}} {{incomeLine.statusName}}</text></view>
            <text>¥{{incomeLine.amountText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{item.shipments.length || item.order.addressText}}" class="section-card ui-card fulfillment-card {{item.shipments.length ? 'with-shipments' : ''}}">
        <block wx:if="{{item.shipments.length}}">
          <view class="shipment-list">
            <view class="shipment-row" wx:for="{{item.shipments}}" wx:key="key" wx:for-item="shipment">
              <view class="shipment-main">
                <text wx:if="{{item.shipments.length > 1}}" class="package-label">{{shipment.packageLabel}}</text>
                <button wx:if="{{shipment.deliveryNo}}" class="shipment-company-action" data-id="{{item.order.id}}" data-shipment-id="{{shipment.id}}" bindtap="openWeChatTracking" loading="{{wechatTrackingId === shipment.key}}" disabled="{{!!wechatTrackingId}}" aria-label="查看{{shipment.deliveryCompany || '承运商'}}物流">{{shipment.deliveryCompany || '物流公司待更新'}}<image class="shipment-chevron" src="/assets/profile/chevron-right.png" mode="aspectFit" /></button>
                <text wx:else class="shipment-company">{{shipment.deliveryCompany || '物流公司待更新'}}</text>
                <text class="shipment-number">运单号 {{shipment.deliveryNo || '-'}}</text>
                <text wx:if="{{shipment.deliveryTimeText}}" class="shipment-time">发货时间 {{shipment.deliveryTimeText}}</text>
              </view>
              <button wx:if="{{shipment.deliveryNo}}" size="mini" class="copy-inline ui-copy-action" data-number="{{shipment.deliveryNo}}" bindtap="copyDeliveryNo">复制单号</button>
            </view>
          </view>
        </block>
        <view wx:if="{{item.order.addressText}}" class="recipient-summary">
          <image class="recipient-pin" src="/assets/profile/map-pin.png" mode="aspectFit" />
          <view class="recipient-copy">
            <view class="recipient-head"><text>{{item.order.maskedRecipient || '收货人信息已隐藏'}}</text><button class="ui-copy-action" data-id="{{item.order.id}}" bindtap="copyRecipient">复制</button></view>
            <text>{{expandedAddresses[item.order.id] ? item.order.addressText : item.order.maskedAddress}}</text>
          </view>
          <button class="recipient-expand" data-id="{{item.order.id}}" bindtap="toggleAddress">{{expandedAddresses[item.order.id] ? '收起' : '展开'}}</button>
        </view>
      </view>

      <view class="section-card ui-card product-card">
        <view class="order-head"><text class="merchant-name">{{item.order.merchantName || '商城订单'}}</text><text class="order-status ui-status-pill">{{item.order.statusText}}</text></view>
        <view class="order-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="line">
          <image src="{{line.productCover}}" mode="aspectFill" />
          <view class="item-copy">
            <text class="item-name">{{line.productName}}</text>
            <view class="item-spec"><text>{{line.skuName || '默认规格'}}</text><text>× {{line.quantity}}</text></view>
            <view wx:if="{{line.serviceTags.length}}" class="item-service-tags"><text wx:for="{{line.serviceTags}}" wx:key="title" wx:for-item="tag">{{tag.title}}</text></view>
            <view class="item-prices"><text>零售价 ¥{{line.retailTotalText}}</text><text>实付款 <text class="ui-price">¥{{line.paidAmountText}}</text></text></view>
          </view>
        </view>
        <view wx:if="{{item.afterSaleDeadlineText}}" class="after-sale-deadline">售后期截止时间 {{item.afterSaleDeadlineText}}</view>
        <view wx:if="{{item.canApplyAfterSale || item.pendingReviewProductId && item.pendingReviewOrderItemId || item.order.status === 0 || item.canReceive}}" class="product-actions ui-action-bar">
          <button wx:if="{{item.canApplyAfterSale}}" class="secondary-button ui-action-button compact-action" data-id="{{item.order.id}}" bindtap="applyAfterSale">退换/售后</button>
          <button wx:if="{{item.pendingReviewProductId && item.pendingReviewOrderItemId}}" class="secondary-button ui-action-button compact-action" data-id="{{item.order.id}}" bindtap="review">去评价</button>
          <button wx:if="{{item.order.status === 0}}" class="secondary-button ui-action-button compact-action" data-id="{{item.order.id}}" disabled="{{actingId !== null}}" bindtap="cancelOrder">取消订单</button>
          <button wx:if="{{item.canReceive}}" class="primary-button ui-action-button ui-action-button--primary compact-action" data-id="{{item.order.id}}" loading="{{actingId === item.order.id}}" disabled="{{actingId !== null}}" bindtap="receive">确认收货</button>
        </view>
      </view>

      <view class="section-card ui-card amount-card">
        <view class="amount-row"><text>商品总售价</text><text>¥{{item.order.totalText}}</text></view>
        <view wx:if="{{item.order.freightAmount !== null && item.order.freightAmount !== undefined}}" class="amount-row"><text>运费</text><text>¥{{item.order.freightText}}</text></view>
        <view wx:if="{{item.order.couponClaimId}}" class="amount-row discount"><text>优惠金额</text><text>−¥{{item.order.discountAmount}}</text></view>
        <view class="amount-row amount-paid"><text>{{item.order.amountLabel}}</text><text class="ui-price">¥{{item.order.amountText}}</text></view>
        <button class="all-info-toggle" data-id="{{item.order.id}}" bindtap="toggleOrderInfo" aria-expanded="{{!!expandedOrders[item.order.id]}}"><text>全部订单信息</text><text>{{expandedOrders[item.order.id] ? '⌃' : '⌄'}}</text></button>
      </view>

      <view wx:if="{{expandedOrders[item.order.id]}}" class="section-card ui-card all-order-info">
        <view><text>订单编号</text><view><text>{{item.order.orderNo}}</text><button class="ui-copy-action" data-id="{{item.order.id}}" bindtap="copyOrderNo">复制</button></view></view>
        <view><text>下单时间</text><text>{{item.order.createTimeText || '-'}}</text></view>
        <view><text>付款时间</text><text>{{item.order.payTimeText || '-'}}</text></view>
        <view wx:if="{{item.order.deliveryTimeText}}"><text>发货时间</text><text>{{item.order.deliveryTimeText}}</text></view>
        <view wx:if="{{item.order.receiveTimeText}}"><text>签收时间</text><text>{{item.order.receiveTimeText}}</text></view>
        <view><text>支付方式</text><text>{{item.order.payType === 'BALANCE' ? '余额支付' : item.order.payType === 'WECHAT' ? '微信支付' : item.order.payType === 'ALIPAY' ? '支付宝' : '商城支付'}}</text></view>
        <view><text>商品数量</text><text>{{item.itemQuantity}} 件</text></view>
        <view><text>售后状态</text><text>{{item.canApplyAfterSale ? '售后期内' : '以订单售后记录为准'}}</text></view>
      </view>

      <view wx:if="{{item.afterSales.length}}" class="section-card ui-card after-sale-list">
        <view class="section-title">退款 / 售后进度</view>
        <view class="after-sale-record" wx:for="{{item.afterSales}}" wx:key="id" wx:for-item="sale">
          <view class="after-sale-head"><view><text>{{sale.typeText}}</text><text>{{sale.afterSaleNo}}</text></view><text>{{sale.statusText}}</text></view>
          <view class="after-sale-meta"><text>{{sale.createTimeText}}</text><text wx:if="{{sale.applyType !== 3}}">¥{{sale.amountText}}</text></view>
          <text wx:if="{{sale.nextActionHint}}" class="next-action">{{sale.nextActionHint}}</text>
          <text wx:if="{{sale.auditRemark}}" class="audit-remark">处理说明：{{sale.auditRemark}}</text>
          <view wx:if="{{sale.canReturn}}" class="return-info">
            <text class="next-action">退货地址：{{sale.returnAddress || '等待商家提供退货地址，请勿自行寄回'}}</text>
            <text wx:if="{{sale.returnDeliveryNo}}" class="next-action">已寄回：{{sale.returnDeliveryCompany}} {{sale.returnDeliveryNo}}</text>
          </view>
          <text wx:if="{{sale.exchangeDeliveryNo}}" class="next-action">换货物流：{{sale.exchangeDeliveryCompany}} {{sale.exchangeDeliveryNo}}</text>
          <view wx:for="{{sale.items}}" wx:key="id" wx:for-item="saleLine" class="sale-item"><text>{{saleLine.productName}} {{saleLine.skuName}}</text><text>× {{saleLine.refundQuantity}}</text></view>
          <view class="sale-actions ui-action-bar">
            <button wx:if="{{sale.exchangeDeliveryNo}}" class="ui-copy-action" data-number="{{sale.exchangeDeliveryNo}}" bindtap="copyDeliveryNo">复制运单号</button>
            <button wx:if="{{sale.canReturn}}" class="secondary-button ui-action-button" data-id="{{sale.id}}" bindtap="editShipment">{{sale.status === 5 ? '修改退货物流' : '填写退货物流'}}</button>
            <button wx:if="{{sale.canReapply}}" class="secondary-button ui-action-button" data-id="{{sale.orderId}}" bindtap="applyAfterSale">补充凭证重新申请</button>
            <button wx:if="{{sale.cancellable}}" class="secondary-button ui-action-button" data-id="{{sale.id}}" loading="{{cancellingAfterSaleId === sale.id}}" disabled="{{cancellingAfterSaleId !== null}}" bindtap="cancelAfterSale">取消申请</button>
            <button wx:if="{{sale.canReceiveExchange}}" class="primary-button ui-action-button ui-action-button--primary" data-id="{{sale.id}}" loading="{{cancellingAfterSaleId === sale.id}}" disabled="{{cancellingAfterSaleId !== null}}" bindtap="receiveExchange">确认收到换货商品</button>
          </view>
          <view wx:if="{{editingSaleId === sale.id}}" class="shipment-form">
            <text class="form-label">快递公司</text>
            <choice-sheet title="选择退货快递" value="{{deliveryCompany}}" placeholder="从常用快递中选择" options="{{carriers}}" selected-index="{{carrierIndex}}" disabled="{{submittingShipment}}" bindchange="selectCarrier" />
            <input class="shipment-input" value="{{deliveryCompany}}" data-field="deliveryCompany" bindinput="shipmentInput" maxlength="50" placeholder="例如：顺丰速运" disabled="{{submittingShipment}}" aria-label="退货快递公司" />
            <text class="form-label">快递单号</text>
            <input class="shipment-input" value="{{deliveryNo}}" data-field="deliveryNo" bindinput="shipmentInput" maxlength="64" placeholder="请输入4至64位快递单号" disabled="{{submittingShipment}}" aria-label="退货快递单号" />
            <text wx:if="{{shipmentError}}" class="shipment-error">{{shipmentError}}</text>
            <view class="shipment-form-actions ui-action-bar">
              <button class="secondary-button ui-action-button" bindtap="closeShipment" disabled="{{submittingShipment}}">暂不填写</button>
              <button class="primary-button ui-action-button ui-action-button--primary" bindtap="submitShipment" loading="{{submittingShipment}}" disabled="{{submittingShipment}}">保存退货物流</button>
            </view>
          </view>
        </view>
      </view>

    </block>
  </block>
  <include src="../../templates/balance-payment.wxml" />
</view>
