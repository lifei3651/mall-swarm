@import '../../styles/balance-payment.wxss';

.detail-page { min-height:100vh; padding:20rpx 22rpx calc(44rpx + env(safe-area-inset-bottom)); background:#f5f8f7; }
.empty-state { padding:140rpx 40rpx; text-align:center; color:var(--muted); }
.empty-state text { display:block; line-height:44rpx; }
.empty-state button { width:300rpx; margin-top:34rpx; font-size:25rpx; }

.order-number-card,.section-card { border:1rpx solid rgba(216,224,222,.9); border-radius:24rpx; background:var(--paper); box-shadow:0 8rpx 24rpx rgba(31,45,42,.045); }
.order-number-card { position:relative; display:flex; flex-wrap:wrap; align-items:center; gap:14rpx; min-height:88rpx; padding:17rpx 22rpx; }
.order-number-copy { min-width:0; flex:1; }
.order-number-label,.order-number-value { display:block; }
.order-number-label { color:#8a9492; font-size:20rpx; }
.order-number-value { margin-top:3rpx; overflow:hidden; color:#303a38; font-size:23rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
.copy-order-number { flex:none; }
.compact-status { flex:none; padding:7rpx 12rpx; border-radius:999rpx; background:var(--brand-soft); color:var(--brand); font-size:20rpx; font-weight:650; }
.payment-hint { display:block; width:100%; margin-top:12rpx; color:#7d8786; font-size:23rpx; line-height:36rpx; word-break:break-all; }
.order-number-card .continue-payment { width:100%; margin-top:4rpx; font-size:27rpx; }

.section-card { margin-top:18rpx; padding:25rpx; }
.section-heading,.section-heading-main { display:flex; align-items:center; }
.section-heading { justify-content:space-between; gap:18rpx; }
.section-heading-main { min-width:0; gap:17rpx; }
.section-heading-main > view { min-width:0; }
.section-icon { flex:none; width:39rpx; height:39rpx; opacity:.78; }
.section-title { display:block; color:var(--ink); font-size:28rpx; font-weight:720; }
.section-subtitle { display:block; margin-top:6rpx; color:#7a8583; font-size:21rpx; line-height:31rpx; }
.text-action { min-height:62rpx; margin:0; padding:0 10rpx; border:0; background:transparent; color:var(--brand); font-size:22rpx; font-weight:600; line-height:62rpx; }
.text-action::after { border:0; }

.shipment-list { margin-top:18rpx; }
.shipment-row { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; padding:20rpx 0; border-top:1rpx solid #edf1f0; }
.shipment-main { min-width:0; flex:1; }
.package-label,.shipment-company,.shipment-number,.shipment-time { display:block; }
.package-label { color:#798381; font-size:21rpx; }
.shipment-company { margin-top:7rpx; color:var(--ink); font-size:25rpx; font-weight:650; }
.shipment-number,.shipment-time { margin-top:6rpx; color:#737e7c; font-size:21rpx; line-height:31rpx; word-break:break-all; }
.shipment-actions { flex:none; align-self:center; }
.wechat-track-button,.copy-inline { flex:none; }

.tracking-panel { margin-top:10rpx; padding-top:18rpx; border-top:1rpx solid #edf1f0; }
.shipment-error { display:block; padding:18rpx; border-radius:16rpx; background:#fff1f1; color:#b42318; font-size:22rpx; line-height:35rpx; }
.tracking-record + .tracking-record { margin-top:18rpx; }
.tracking-state { padding:18rpx; border-radius:16rpx; background:#f0f7f5; }
.tracking-state text { display:block; color:#45514f; font-size:22rpx; line-height:35rpx; }
.tracking-state text:first-child { color:var(--brand); font-size:24rpx; font-weight:700; }
.tracking-event { position:relative; margin-left:17rpx; padding:20rpx 0 10rpx 28rpx; border-left:2rpx solid #d9e4e1; }
.tracking-event::before { position:absolute; top:28rpx; left:-7rpx; width:12rpx; height:12rpx; border-radius:50%; background:var(--brand); content:''; }
.tracking-event text { display:block; color:#46514f; font-size:23rpx; line-height:34rpx; }
.tracking-event text:last-child { margin-top:5rpx; color:#89918f; font-size:20rpx; }

.fulfillment-card .address-toggle { padding-top: 18rpx; padding-bottom: 2rpx; }
.fulfillment-card.with-shipments .address-toggle { margin-top: 8rpx; border-top: 1rpx solid #edf1f0; }
.address-toggle { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:88rpx; margin:0; padding:0; background:transparent; color:var(--ink); line-height:1.5; }
.address-toggle::after { border:0; }
.fold-label { color:#7a8583; font-size:22rpx; font-weight:500; }
.recipient-address { display:block; padding:12rpx 0 4rpx 56rpx; color:#65706e; font-size:23rpx; line-height:36rpx; overflow-wrap:anywhere; }

.order-head { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; padding-bottom:19rpx; border-bottom:1rpx solid #edf1f0; }
.merchant-name { display:block; color:var(--ink); font-size:28rpx; font-weight:720; }
.order-status { flex:none; padding:7rpx 13rpx; border-radius:999rpx; background:var(--brand-soft); color:var(--brand); font-size:22rpx; font-weight:650; }
.order-item { display:flex; align-items:flex-start; gap:17rpx; padding:22rpx 0; border-bottom:1rpx solid #edf1f0; }
.order-item image { flex:none; width:128rpx; height:128rpx; border-radius:18rpx; background:#eef1f0; }
.item-copy { min-width:0; flex:1; }
.item-name { display:-webkit-box; overflow:hidden; color:var(--ink); font-size:26rpx; font-weight:650; line-height:37rpx; -webkit-box-orient:vertical; -webkit-line-clamp:2; }
.item-spec { display:block; margin-top:9rpx; color:#7b8583; font-size:22rpx; }
.item-price { flex:none; color:#303a38; font-size:23rpx; }
.product-footer { display:flex; align-items:center; justify-content:space-between; gap:16rpx; padding:17rpx 0; color:#7a8583; font-size:21rpx; }
.product-footer > view { min-width:0; text-align:right; }
.paid-amount { color:var(--brand); font-size:27rpx; font-weight:750; }

.after-sale-list .section-title { margin-bottom:14rpx; }
.after-sale-record { margin-top:14rpx; padding:20rpx; border-radius:18rpx; background:#fff8ed; }
.after-sale-head,.after-sale-meta { display:flex; align-items:flex-start; justify-content:space-between; gap:20rpx; }
.after-sale-head > view text { display:block; }
.after-sale-head > view text:first-child { font-weight:700; }
.after-sale-head > view text:last-child { margin-top:6rpx; color:#8a92a0; font-size:21rpx; }
.after-sale-head > text { flex:none; color:#a25b15; font-size:24rpx; font-weight:700; }
.after-sale-meta { margin-top:14rpx; color:#737c8b; font-size:22rpx; }
.next-action,.audit-remark { display:block; margin-top:14rpx; color:#6c5630; font-size:23rpx; line-height:36rpx; }
.audit-remark { padding-top:12rpx; border-top:1rpx solid #f2dfc3; }
.sale-item { display:flex; justify-content:space-between; gap:18rpx; margin:12rpx 0; color:#667085; font-size:24rpx; }
.sale-item text:first-child { min-width:0; overflow-wrap:anywhere; }
.sale-actions { margin-top:16rpx; }
.shipment-form { margin-top:18rpx; padding:20rpx; border-radius:18rpx; background:var(--paper); }
.shipment-form-actions { margin-top:18rpx; }
.form-label { display:block; margin:18rpx 0 12rpx; color:var(--ink); font-size:24rpx; }
.shipment-input { min-height:84rpx; padding:0 16rpx; border:1rpx solid var(--line); border-radius:12rpx; color:var(--ink); font-size:26rpx; }
.shipment-input.ui-select-row { margin-bottom:16rpx; }

.amount-summary { padding:11rpx 0; border-top:1rpx solid #e9eeed; }
.amount-row { display:flex; justify-content:space-between; gap:22rpx; padding:10rpx 0; color:#606b69; font-size:23rpx; line-height:34rpx; }
.amount-row text:last-child { color:#26312f; text-align:right; }
.amount-row.discount text:last-child { color:#c94b4b; }
.order-info-inline { margin-top:8rpx; border-top:1rpx solid #e9eeed; }
.order-info-toggle { display:flex; align-items:center; justify-content:space-between; width:100%; min-height:76rpx; margin:0; padding:0; background:transparent; color:var(--ink); font-size:26rpx; font-weight:700; line-height:1.5; }
.order-info-toggle::after { border:0; }
.order-info-toggle text:last-child { color:#7a8583; font-size:22rpx; font-weight:500; }
.order-info-inline > view { display:flex; justify-content:space-between; gap:22rpx; margin-top:10rpx; color:#75807e; font-size:22rpx; line-height:34rpx; }
.order-info-inline > view text:last-child { min-width:0; color:#303a38; text-align:right; word-break:break-all; }

.detail-actions { margin:18rpx 0 8rpx; padding:8rpx 0; }
.balance-sheet { color:var(--ink); }
