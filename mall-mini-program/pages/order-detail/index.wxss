.detail-page { min-height: 100vh; padding: 22rpx 22rpx 56rpx; }
.empty-state { padding: 140rpx 40rpx; text-align: center; color: var(--muted); }
.empty-state text { display: block; line-height: 44rpx; }
.empty-state button { width: 300rpx; margin-top: 34rpx; font-size: 25rpx; }
.payment-summary { padding: 30rpx; border-radius: 26rpx; background: linear-gradient(135deg, #fff 0%, #fff5f7 100%); box-shadow: 0 8rpx 28rpx rgba(42, 50, 66, .05); }
.summary-label { color: var(--muted); font-size: 24rpx; }
.summary-amount { margin-top: 8rpx; color: var(--brand); font-size: 48rpx; font-weight: 750; }
.summary-meta, .summary-no { display: block; margin-top: 12rpx; color: #737c8b; font-size: 23rpx; line-height: 34rpx; word-break: break-all; }
.order-card { margin-top: 20rpx; padding: 26rpx; border: 1rpx solid #e8eaf0; border-radius: 26rpx; background: #fff; box-shadow: var(--shadow); }
.order-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--line); }
.order-head view { min-width: 0; }
.merchant-name { display: block; font-weight: 700; }
.order-no { display: block; margin-top: 8rpx; color: var(--muted); font-size: 22rpx; word-break: break-all; }
.order-status { flex: none; color: var(--brand); font-size: 25rpx; }
.order-item { display: flex; align-items: flex-start; gap: 18rpx; padding: 22rpx 0; border-bottom: 1rpx solid #f1f2f5; }
.order-item image { flex: none; width: 126rpx; height: 126rpx; border-radius: 16rpx; background: #eef0f3; }
.item-copy { min-width: 0; flex: 1; }
.item-name { display: -webkit-box; overflow: hidden; font-weight: 600; line-height: 38rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.item-spec { display: block; margin-top: 10rpx; color: var(--muted); font-size: 23rpx; }
.item-price { flex: none; font-size: 24rpx; }
.recipient { margin-top: 22rpx; padding: 20rpx; border-radius: 18rpx; background: #f7f8fa; }
.recipient text { display: block; color: #596272; font-size: 24rpx; line-height: 38rpx; }
.recipient text:first-child { color: var(--ink); font-weight: 600; }
.shipment { margin-top: 18rpx; padding: 20rpx; border: 1rpx solid #edf0f3; border-radius: 18rpx; }
.shipment view, .order-info view { display: flex; justify-content: space-between; gap: 22rpx; margin-top: 10rpx; color: #687180; font-size: 23rpx; line-height: 34rpx; }
.shipment view:first-child, .order-info view:first-child { margin-top: 0; }
.shipment view text:last-child, .order-info view text:last-child { min-width: 0; color: #343c4a; text-align: right; word-break: break-all; }
.order-info { margin-top: 22rpx; }
.order-info .paid-amount { color: var(--brand); font-size: 29rpx; font-weight: 700; }
.section-title { margin-bottom: 14rpx; font-weight: 700; }
.after-sale-list { margin-top: 22rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.after-sale-record { margin-top: 14rpx; padding: 20rpx; border-radius: 18rpx; background: #fff8ed; }
.after-sale-head, .after-sale-meta { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.after-sale-head > view text { display: block; }
.after-sale-head > view text:first-child { font-weight: 700; }
.after-sale-head > view text:last-child { margin-top: 6rpx; color: #8a92a0; font-size: 21rpx; }
.after-sale-head > text { flex: none; color: #a25b15; font-size: 24rpx; font-weight: 700; }
.after-sale-meta { margin-top: 14rpx; color: #737c8b; font-size: 22rpx; }
.next-action, .audit-remark { display: block; margin-top: 14rpx; color: #6c5630; font-size: 23rpx; line-height: 36rpx; }
.audit-remark { padding-top: 12rpx; border-top: 1rpx solid #f2dfc3; }
.cancel-after-sale { width: 190rpx; margin: 18rpx 0 0 auto; font-size: 23rpx; }
.detail-actions { display: flex; justify-content: flex-end; gap: 14rpx; margin-top: 24rpx; }
.detail-actions button { width: 220rpx; margin: 0; font-size: 25rpx; }
.all-orders { margin-top: 24rpx; font-size: 26rpx; }
