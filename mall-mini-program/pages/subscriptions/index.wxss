.subscription-page { min-height: 100vh; padding: 24rpx; }
.intro-card { padding: 32rpx; border-radius: 26rpx; background: linear-gradient(135deg, #232a38, #e7193f); color: #fff; }
.intro-card view { font-size: 38rpx; font-weight: 700; }
.intro-card text { display: block; margin-top: 14rpx; color: rgba(255,255,255,.76); font-size: 24rpx; line-height: 40rpx; }
.template-card { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding: 28rpx; border-radius: 22rpx; background: #fff; }
.template-card view text { display: block; }
.template-card view text:first-child { font-weight: 700; }
.template-card view text:last-child { margin-top: 8rpx; color: #9097a4; font-size: 23rpx; }
.template-card>text { color: var(--brand); font-size: 23rpx; }
.subscribe-button { margin-top: 34rpx; font-size: 27rpx; }
.notice { display: block; margin: 24rpx 12rpx; color: #777f8e; font-size: 23rpx; line-height: 40rpx; }
