<view class="page home-page layout-{{layoutTemplate}}" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{loading}}" class="empty">正在加载商城…</view>
  <view wx:elif="{{error}}" class="empty">
    <view>{{error}}</view>
    <button class="secondary-button retry" bindtap="retry">重新加载</button>
  </view>
  <block wx:else>
    <button wx:if="{{shareError}}" class="secondary-button" bindtap="retryShare">{{shareError}}</button>
    <view class="brand-head">
      <view class="brand-logo-shell">
        <image wx:if="{{home.logoUrl && !logoFailed}}" class="brand-logo" src="{{home.logoUrl}}" mode="aspectFit" binderror="logoError" />
        <image wx:else class="brand-logo brand-logo-fallback" src="/assets/lingqi-logo-mark.png" mode="aspectFit" />
      </view>
      <view class="brand-copy">
        <view class="brand-name">{{home.brandName || '商城'}}</view>
        <view class="brand-note">好商品，放心选</view>
      </view>
      <button wx:if="{{brandCultureEnabled}}" class="culture-link" data-type="culture" bindtap="openContent">品牌文化 ›</button>
    </view>

    <view class="search-box">
      <image class="search-icon" src="/assets/icons/search.png" mode="aspectFit" />
      <input value="{{keyword}}" bindinput="onKeywordInput" bindconfirm="search" confirm-type="search" placeholder="搜索商品" />
      <button bindtap="search">搜索</button>
    </view>

    <block wx:for="{{homeModules}}" wx:key="type" wx:for-item="module">
    <swiper wx:if="{{module.type === 'banner' && home.banners && home.banners.length}}" class="banner" indicator-dots autoplay circular interval="4500">
      <swiper-item wx:for="{{home.banners}}" wx:key="id" data-type="{{item.linkType}}" data-value="{{item.linkValue}}" bindtap="openBanner" aria-role="button" aria-label="{{item.title || '商城活动'}}">
        <view wx:if="{{!item.imageUrl || item.imageFailed}}" class="banner-fallback media-fallback"><image src="/assets/lingqi-logo-mark.png" mode="aspectFit" /></view>
        <image wx:else src="{{item.imageUrl}}" mode="aspectFill" data-index="{{index}}" binderror="bannerImageError" />
      </swiper-item>
    </swiper>

    <scroll-view wx:if="{{module.type === 'category' && home.categoryList && home.categoryList.length}}" class="categories" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-row">
        <view class="category-item" wx:for="{{home.categoryList}}" wx:key="id" data-name="{{item.categoryName}}" bindtap="openCategory" aria-role="button" aria-label="查看{{item.categoryName}}分类">
          <view class="category-icon">
            <view class="category-placeholder">{{item.initial}}</view>
            <image wx:if="{{item.iconUrl && !item.iconFailed}}" src="{{item.iconUrl}}" mode="aspectFill" data-index="{{index}}" binderror="categoryIconError" />
          </view>
          <text>{{item.categoryName}}</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{module.type === 'notice' && home.notices && home.notices.length}}" class="notice card" bindtap="notices" aria-role="button" aria-label="查看商城全部公告">
      <text class="notice-label">公告</text>
      <text class="notice-text">{{home.notices[0].title}}</text>
    </view>

    <view wx:if="{{module.type === 'newArrivals' && home.newArrivals.length}}">
      <view class="section-head" data-type="newArrivals" bindtap="openContent"><text>新品速递</text><text class="muted">查看全部 ›</text></view>
      <scroll-view class="arrival-scroll" scroll-x>
        <view class="arrival-row">
          <view class="arrival-card card" wx:for="{{home.newArrivals}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct">
            <image wx:if="{{item.coverUrl && !item.imageFailed}}" src="{{item.coverUrl}}" mode="aspectFill" data-index="{{index}}" binderror="arrivalImageError" />
            <view wx:else class="arrival-placeholder media-fallback">新品</view>
            <view class="product-copy"><view class="product-title">{{item.productName}}</view><view class="product-price">¥{{item.priceText}}</view></view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view wx:if="{{module.type === 'live' && home.liveRooms.length}}">
      <view class="section-head" data-type="live" bindtap="openContent"><text>直播广场</text><text class="muted">查看全部 ›</text></view>
      <view class="live-card card" wx:for="{{home.liveRooms}}" wx:key="room.id" data-id="{{item.room.id}}" bindtap="openLive">
        <image wx:if="{{item.room.coverUrl}}" src="{{item.room.coverUrl}}" mode="aspectFill" />
        <view><text class="live-label">{{item.roomState === 'LIVE' ? '直播中' : item.roomState === 'ENDED' ? '已结束' : '直播预告'}}</text><view>{{item.room.title}}</view><text class="muted">{{item.room.anchorName}}</text></view>
      </view>
    </view>
    <view wx:if="{{module.type === 'trust'}}" class="trust-strip card">
      <text>订单可查询</text><text>售后可申请</text><text wx:if="{{home.legalConfig.servicePhone}}">客服 {{home.legalConfig.servicePhone}}</text>
    </view>
    <block wx:if="{{module.type === 'products'}}">
    <button wx:if="{{layoutTemplate === 'campaign-feed' && campaignError}}" class="secondary-button campaign-retry" bindtap="retryCampaigns">{{campaignError}}</button>
    <view class="section-head"><text>精选好物</text><text class="muted">为你推荐 · {{products.length}}件</text></view>
    <view wx:if="{{products.length}}" class="product-grid">
      <view class="product-card" wx:for="{{products}}" wx:key="id" data-id="{{item.id}}" bindtap="openProduct" aria-role="button" aria-label="{{item.productName}}，价格{{item.priceText}}元">
        <view class="product-media">
          <view wx:if="{{!item.coverUrl || item.imageFailed}}" class="product-cover media-fallback"><image src="/assets/lingqi-logo-mark.png" mode="aspectFit" /></view>
          <image wx:else class="product-cover" src="{{item.coverUrl}}" mode="aspectFill" lazy-load data-index="{{index}}" binderror="productImageError" />
        </view>
        <view wx:if="{{item.campaign}}" class="campaign-activity-band"><text class="campaign-label">{{item.campaign.label}}</text><text class="campaign-countdown">{{item.campaign.countdown}}</text></view>
        <view class="product-copy">
          <view class="product-title">{{item.productName}}</view>
          <view wx:if="{{item.subtitle}}" class="product-subtitle">{{item.subtitle}}</view>
          <view class="home-purchase-row">
            <view class="product-price"><text>¥</text>{{item.priceText}}</view>
            <button wx:if="{{item.campaign}}" class="campaign-buy-button" data-id="{{item.campaign.id}}" catchtap="campaign" aria-label="{{item.campaign.actionLabel + '：' + item.productName}}">{{item.campaign.actionLabel}}</button>
            <button wx:else class="home-quick-cart {{item.soldOut || !!addingId ? 'is-disabled' : ''}}" data-id="{{item.id}}" catchtap="quickAdd" disabled="{{item.soldOut || !!addingId}}" loading="{{addingId === '' + item.id}}" aria-label="{{item.soldOut ? '已售罄' : '加入购物车：' + item.productName}}"><text wx:if="{{item.soldOut}}">售罄</text><image wx:else src="/assets/tabbar/cart.png" mode="aspectFit" /></button>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="empty">当前还没有上架商品</view>
    <button wx:if="{{products.length}}" class="secondary-button all-products-button" bindtap="allProducts">查看全部商品</button>
    </block>
    </block>
  </block>
  <include src="/templates/quick-cart.wxml" />
</view>
