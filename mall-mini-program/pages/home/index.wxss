.brand-head { display: flex; align-items: center; padding: 8rpx 4rpx 24rpx; }
.brand-logo { width: 76rpx; height: 76rpx; border-radius: 20rpx; background: #fff; }
.brand-copy { margin-left: 18rpx; }
.brand-name { font-size: 38rpx; font-weight: 800; }
.brand-note { margin-top: 6rpx; color: #9299a8; font-size: 23rpx; }
.search-box { height: 82rpx; padding-left: 24rpx; display: flex; align-items: center; border: 2rpx solid var(--brand); border-radius: 999rpx; background: #fff; overflow: hidden; }
.search-icon { font-size: 38rpx; color: #99a0ae; }
.search-box input { flex: 1; height: 100%; margin-left: 14rpx; }
.search-box button { width: 126rpx; height: 82rpx; line-height: 82rpx; border-radius: 0; padding: 0; background: var(--brand); color: #fff; font-size: 27rpx; }
.banner { height: 318rpx; margin-top: 24rpx; border-radius: 26rpx; overflow: hidden; background: #eceef2; }
.banner image { width: 100%; height: 100%; }
.categories { margin: 26rpx -24rpx 0; width: auto; }
.category-row { display: flex; padding: 0 24rpx; }
.category-item { flex: none; width: 134rpx; margin-right: 12rpx; text-align: center; font-size: 24rpx; }
.category-item image, .category-placeholder { width: 92rpx; height: 92rpx; margin: 0 auto 10rpx; border-radius: 28rpx; background: #fff; }
.category-placeholder { display: flex; align-items: center; justify-content: center; color: var(--brand); font-weight: 700; }
.notice { display: flex; align-items: center; margin-top: 26rpx; padding: 22rpx; }
.notice-label { padding-right: 18rpx; color: var(--brand); font-weight: 700; }
.notice-text { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.retry { width: 240rpx; margin-top: 28rpx; }
