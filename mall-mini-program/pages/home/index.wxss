.brand-head { display: flex; align-items: center; padding: 10rpx 4rpx 26rpx; }
.brand-logo-shell { display: flex; flex: none; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; border: 1rpx solid var(--line); border-radius: 24rpx; background: var(--brand-soft); box-shadow: 0 8rpx 24rpx rgba(35,42,56,.07); overflow: hidden; }
.brand-logo { width: 74rpx; height: 74rpx; }
.brand-logo-fallback { width: 62rpx; height: 62rpx; }
.brand-copy { margin-left: 18rpx; }
.brand-name { font-size: 38rpx; font-weight: 800; letter-spacing: 1rpx; }
.brand-note { margin-top: 4rpx; color: #778092; font-size: 24rpx; }
.search-box { height: 84rpx; padding-left: 24rpx; display: flex; align-items: center; border: 1rpx solid #e4e7ec; border-radius: 22rpx; background: var(--paper); box-shadow: 0 8rpx 24rpx rgba(35,42,56,.05); overflow: hidden; }
.search-icon { flex: none; width: 34rpx; height: 34rpx; opacity: .78; }
.search-box input { min-width: 0; flex: 1; height: 100%; margin-left: 14rpx; font-size: 27rpx; }
.search-box button { flex: none; width: 132rpx; height: 84rpx; line-height: 84rpx; border-radius: 0; padding: 0; background: var(--button); color: #fff; font-size: 27rpx; font-weight: 650; }
.banner { height: 306rpx; margin-top: 24rpx; border-radius: 26rpx; overflow: hidden; background: #eceef2; box-shadow: var(--shadow); }
.banner image { width: 100%; height: 100%; }
.banner-fallback { width: 100%; height: 100%; }
.banner-fallback image { width: 104rpx; height: 104rpx; }
.categories { margin: 24rpx -24rpx 0; width: auto; }
.category-row { display: flex; padding: 4rpx 24rpx 10rpx; }
.category-item { flex: none; width: 136rpx; margin-right: 10rpx; text-align: center; font-size: 24rpx; color: #3d4655; }
.category-icon { position: relative; display: flex; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; margin: 0 auto 12rpx; border-radius: 30rpx; background: var(--brand-soft); overflow: hidden; }
.category-icon image, .category-placeholder { width: 100%; height: 100%; }
.category-placeholder { display: flex; align-items: center; justify-content: center; color: var(--accent); font-size: 30rpx; font-weight: 750; }
.category-icon image { position: absolute; inset: 0; }
.category-item > text { display: block; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.notice { display: flex; align-items: center; margin-top: 22rpx; padding: 22rpx 24rpx; }
.notice-label { padding-right: 18rpx; color: var(--accent); font-weight: 700; }
.notice-text { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.product-card { display: flex; min-height: 474rpx; flex-direction: column; }
.product-media { position: relative; width: 100%; height: 296rpx; overflow: hidden; background: #eef0f3; }
.product-copy { flex: 1; display: flex; flex-direction: column; }
.product-price { margin-top: auto; }
.product-price text { margin-right: 2rpx; font-size: 24rpx; }
.home-purchase-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8rpx; margin-top: auto; padding-top: 12rpx; }
.home-purchase-row .product-price { margin: 0; }
.home-purchase-row .home-quick-cart { display: flex; align-items: center; justify-content: center; flex: none; width: 44px; height: 44px; min-width: 44px; margin: 0 0 0 auto; padding: 8rpx; line-height: 1; border-radius: 50%; background: var(--brand-soft); }
.home-quick-cart image { width: 40rpx; height: 40rpx; }
.home-quick-cart text { color: var(--muted); font-size: 22rpx; }
.home-purchase-row .home-quick-cart.is-disabled { background: #eef0f3; opacity: .65; }
.retry { width: 240rpx; margin-top: 28rpx; }
.home-page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.home-page .all-products-button { margin-top: 24rpx; }
.brand-head { background: var(--header); border-radius: var(--radius); padding: 20rpx; margin-bottom: 20rpx; }
.brand-copy { flex: 1; min-width: 0; }
.brand-name, .brand-note { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.home-page .culture-link { flex: none; width: auto; min-width: 0; margin: 0 0 0 8rpx; padding: 8rpx; background: transparent; color: var(--accent); font-size: 22rpx; }
.search-box { border-color: var(--line); background: var(--paper); }
.search-box button { background: var(--button); }
.arrival-row { display: flex; gap: 18rpx; }
.arrival-card { flex: none; width: 280rpx; overflow: hidden; }
.arrival-card > image, .arrival-placeholder { width: 280rpx; height: 240rpx; }
.live-card { display: flex; align-items: center; gap: 22rpx; padding: 20rpx; margin-bottom: 18rpx; }
.live-card > image { flex: none; width: 240rpx; height: 160rpx; border-radius: var(--radius); }
.live-label { color: var(--accent); font-size: 22rpx; }
.trust-strip { display: flex; flex-wrap: wrap; justify-content: space-around; gap: 14rpx; margin-top: 24rpx; padding: 24rpx; color: var(--muted); font-size: 22rpx; }
.layout-product-focus .banner { height: 240rpx; }
.layout-product-focus .product-grid { gap: 12rpx; }
.layout-category-focus .category-row { display: flex; flex-wrap: wrap; row-gap: 24rpx; }
.layout-category-focus .category-item { width: calc(25% - 10rpx); }
.layout-campaign-feed .banner { height: 400rpx; }
.layout-campaign-feed .product-grid { grid-template-columns: minmax(0, 1fr); gap: 20rpx; }
.layout-campaign-feed .product-card { min-height: 0; }
.layout-campaign-feed .product-media, .layout-campaign-feed .product-cover { height: 320rpx; }
.layout-campaign-feed .product-title { min-height: 0; }
.layout-campaign-feed .product-price { margin-top: 12rpx; }
.campaign-activity-band { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx 18rpx; padding: 16rpx 24rpx; background: var(--brand-soft); color: var(--brand); line-height: 1.5; }
.campaign-label { font-size: 26rpx; font-weight: 600; }
.campaign-countdown { font-size: 24rpx; font-variant-numeric: tabular-nums; }
.home-page .campaign-buy-button { flex: none; width: 160rpx; min-width: 160rpx; min-height: 44px; margin: 0; padding: 0 24rpx; display: flex; align-items: center; justify-content: center; background: var(--button); color: #fff; border-radius: 999rpx; font-size: 28rpx; line-height: 1.3; }
.campaign-retry { margin-bottom: 24rpx; }
/* Public H5 HomeView: compact brand/search, category grid and textual purchase CTA. */
.home-page { padding: 16rpx 16rpx calc(140rpx + env(safe-area-inset-bottom)); }
.home-page .brand-head { padding: 0; margin-bottom: 20rpx; gap: 16rpx; border-radius: 0; }
.brand-logo-shell { width: 60rpx; height: 64rpx; border: 0; background: transparent; border-radius: 0; box-shadow: none; }
.brand-logo, .brand-logo-fallback { width: 60rpx; height: 60rpx; }
.brand-head .search-box { flex: 1; height: 80rpx; border: 2rpx solid var(--brand); border-radius: 999rpx; box-shadow: none; }
.brand-head .search-box button { width: 82rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; }
.search-box button image { width: 32rpx; height: 32rpx; filter: brightness(0) invert(1); }
.brand-head .search-box .clear-keyword { width: 64rpx; margin: 0; background: transparent; color: var(--muted); font-size: 38rpx; font-weight: 400; }
.home-page .culture-link { flex: none; width: auto; padding: 0 8rpx; white-space: nowrap; font-size: 22rpx; line-height: 1.4; }
.categories { width: 100%; margin: 20rpx 0 0; background: var(--paper); border-radius: 20rpx; }
.category-row, .layout-category-focus .category-row { display: grid; grid-template-columns: repeat(5,minmax(0,1fr)); gap: 20rpx 8rpx; padding: 24rpx 12rpx; }
.category-item, .layout-category-focus .category-item { width: auto; margin: 0; font-size: 24rpx; }
.category-icon { width: 58px; height: 58px; border-radius: 50%; }
.notice { padding: 12rpx 20rpx; border: 0; border-radius: 18rpx; background: #fffbea; box-shadow: none; }
.notice-swiper { flex: 1; min-width: 0; height: 56rpx; }
.notice-text { display: block; line-height: 56rpx; }
.notice button { flex: none; margin: 0 0 0 12rpx; padding: 0 4rpx; line-height: 56rpx; background: transparent; color: var(--muted); font-size: 22rpx; }
.section-head { display: block; margin: 26rpx 4rpx 16rpx; }
.section-head .muted { display: block; margin-top: 6rpx; font-size: 24rpx; }
.product-grid { gap: 16rpx; }
.product-card { min-height: 0; border: 0; border-radius: 24rpx; box-shadow: none; }
.product-media { height: 0; padding-top: 100%; }
.product-cover { position: absolute; inset: 0; width: 100%; height: 100%; }
.product-copy { padding: 9px; }
.product-title { min-height: 38px; font-size: 14px; line-height: 1.38; -webkit-line-clamp: 2; }
.product-sales { margin-top: 10rpx; color: #aa783f; font-size: 22rpx; }
.home-purchase-row { flex-wrap: wrap; gap: 10rpx 6rpx; padding-top: 18rpx; }
.home-purchase-row .product-price { flex: none; min-width: 0; max-width: 100%; white-space: nowrap; }
.product-price .price-number { font-size: 22px; }
.home-purchase-row .home-quick-cart { flex: none; width: auto; min-width: 76px; height: 34px; min-height: 34px; border-radius: 999rpx; margin: 0 0 0 auto; padding: 0 9px; font-size: 12px; font-weight: 600; color: #fff; background: var(--button); }
.home-purchase-row .home-quick-cart.is-disabled { color: #fff; background: #b7bbc2; }
.sold-out-mask { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: #fff; background: rgba(0,0,0,.3); font-weight: 600; }
.layout-campaign-feed .product-media { height: 320rpx; padding-top: 0; }
.layout-campaign-feed .product-cover { height: 100%; }
.layout-category-focus .category-icon { width: 62px; height: 62px; }
@media (max-width: 370px) { .category-icon, .layout-category-focus .category-icon { width:52px; height:52px; } .home-purchase-row .home-quick-cart { min-width:70px; padding:0 7px; font-size:11px; } .product-price .price-number { font-size:20px; } }
@media (max-width: 340px) { .home-purchase-row .home-quick-cart { min-width: 116rpx; padding: 0 12rpx; font-size: 22rpx; } .product-price .price-number { font-size: 32rpx; } }
.search-suggestions { margin-top:-10rpx; margin-bottom:20rpx; padding:24rpx; border:1rpx solid var(--line); border-radius:24rpx; background:var(--paper); }
.suggestion-group { min-width:0; }
.suggestion-group + .suggestion-group { margin-top:24rpx; padding-top:24rpx; border-top:1rpx solid var(--line); }
.suggestion-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-width:0; min-height:64rpx; margin-bottom:8rpx; color:var(--muted); font-size:24rpx; font-weight:400; }
.suggestion-head .clear-history { flex:none; width:auto; min-width:0; height:auto; min-height:64rpx; margin:0; padding:12rpx 0 12rpx 16rpx; line-height:36rpx; border:0; border-radius:0; background:transparent; color:var(--muted); font-size:24rpx; font-weight:400; }
.search-tags { display:flex; flex-direction:row; flex-wrap:wrap; align-items:flex-start; gap:16rpx; min-width:0; }
.search-tags .search-tag { box-sizing:border-box; display:inline-flex; flex:0 1 auto; align-items:center; justify-content:center; width:auto; min-width:0; max-width:100%; height:64rpx; min-height:64rpx; margin:0; padding:0 24rpx; border:0; border-radius:999rpx; background:var(--canvas); color:var(--ink); font-size:24rpx; font-weight:400; line-height:36rpx; }
.search-tag-label { display:block; min-width:0; max-width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.category-item.active { color:var(--brand); font-weight:600; }
.section-head { position:relative; }
.clear-filter { position:absolute; right:0; top:0; margin:0; padding:8rpx 16rpx; font-size:24rpx; color:var(--brand); background:transparent; }
.search-summary { overflow-wrap: anywhere; }
