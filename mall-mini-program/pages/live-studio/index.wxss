.studio-page{min-height:100vh;box-sizing:border-box;padding:24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));background:#f6f7f9;color:#202631}.anchor,.card,.safety{box-sizing:border-box;padding:28rpx;margin-bottom:24rpx;border-radius:22rpx;background:#fff}.anchor{background:var(--brand);color:#fff}.anchor text{display:block;margin:8rpx 0;font-size:25rpx}.anchor .title,.title{font-size:32rpx;font-weight:700;overflow-wrap:anywhere}.safety{background:var(--brand-soft);font-size:25rpx;line-height:1.65}.safety text{display:block;margin:6rpx 0}.heading{display:flex;justify-content:space-between;align-items:center}.heading button{margin:0}.state{padding:48rpx 24rpx;display:flex;flex-direction:column;gap:24rpx;text-align:center;font-size:28rpx}.hint{display:block;color:#727b89;font-size:24rpx;line-height:1.6;margin:10rpx 0}.room{display:flex;flex-wrap:wrap;gap:20rpx;padding:28rpx 0;border-top:1rpx solid #edf0f3}.room image{width:180rpx;height:138rpx;border-radius:16rpx}.room-copy{flex:1;min-width:0}.room-title{display:block;font-size:29rpx;font-weight:600;overflow-wrap:anywhere}.actions{display:flex;gap:16rpx;width:100%;flex-wrap:wrap}.actions button{flex:1;min-width:180rpx}.studio-page button{font-size:26rpx;min-height:84rpx;line-height:1.5;padding:22rpx 20rpx;background:#f4f6f8;color:#475467;border-radius:14rpx}.studio-page button::after{border:0}.studio-page .primary{background:var(--brand);color:#fff}.studio-page .danger{background:#c83229;color:#fff}.studio-page button[disabled]{opacity:.45}.credential button{margin-top:20rpx}
.studio-page .heading { gap:16rpx; }
.studio-page .heading .title { flex:1; min-width:0; }
.studio-page .heading button { flex:none; width:auto; min-width:88rpx; min-height:88rpx; padding:20rpx 12rpx; background:transparent; font-weight:400; }
