.withdraw-page { min-height:100vh; padding:24rpx 28rpx calc(40rpx + env(safe-area-inset-bottom)); }
.withdraw-page .card { padding:28rpx; margin-bottom:24rpx; border:0; border-radius:22rpx; box-shadow:none; }.available { display:block; margin:12rpx 0 24rpx; color:var(--price); font-size:52rpx; font-weight:600; overflow-wrap:anywhere; }.channel { display:flex; gap:16rpx; align-items:center; border-top:1rpx solid var(--line); padding-top:22rpx; font-size:25rpx; }.channel image { width:38rpx; height:38rpx; }.field-label { display:block; margin:20rpx 0 12rpx; font-size:25rpx; }.field { box-sizing:border-box; width:100%; min-height:90rpx; border-radius:14rpx; padding:0 20rpx; background:var(--canvas); color:var(--ink); font-size:27rpx; }.amount { font-size:40rpx; }.sms-row { display:flex; gap:12rpx; }.sms-row input { flex:1; min-width:0; }.sms-row button { width:auto; display:flex; align-items:center; justify-content:center; flex:none; margin:0; padding:16rpx 12rpx; background:var(--brand-soft); color:var(--brand); border-radius:14rpx; font-size:23rpx; line-height:34rpx; }.hint { display:block; margin-top:16rpx; font-size:22rpx; color:var(--muted); line-height:36rpx; }.withdraw-page .primary-button { width:100%; margin-top:28rpx; }.requirement { line-height:42rpx; font-size:25rpx; }.requirement .secondary-button { margin-top:22rpx; }.withdraw-page .support { display:flex; align-items:center; justify-content:center; min-height:88rpx; width:100%; margin:0; padding:18rpx; background:transparent; color:var(--brand); font-size:24rpx; line-height:36rpx; font-weight:400; }
