<view class="page withdraw-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{loading}}" class="empty">正在核对提现条件…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="secondary-button" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="card withdraw-card"><text class="muted">可提现余额(元)</text><text class="available">{{balance}}</text><view class="channel"><image src="/assets/profile/wallet.png" /><text>提现至当前账号绑定的微信</text></view></view>
    <view wx:if="{{blockReason}}" class="card requirement"><text>{{blockReason}}</text><button class="secondary-button" bindtap="load">已完成，刷新状态</button><button class="support" open-type="contact">联系商城客服</button></view>
    <view wx:else class="card withdraw-form">
      <text class="field-label">提现金额</text><input class="field amount" type="digit" value="{{form.withdrawAmount}}" data-field="withdrawAmount" bindinput="input" maxlength="11" placeholder="0.00" disabled="{{submitting}}" aria-label="提现金额" />
      <text class="field-label">收款人姓名</text><input class="field" value="{{form.accountName}}" data-field="accountName" bindinput="input" maxlength="64" placeholder="与实名认证一致" disabled="{{submitting}}" aria-label="收款人姓名" />
      <text class="field-label">支付密码</text><input class="field" value="{{form.paymentPassword}}" data-field="paymentPassword" bindinput="input" password maxlength="6" placeholder="6位数字支付密码" disabled="{{submitting}}" aria-label="支付密码" />
      <text class="field-label">短信验证码</text><view class="sms-row"><input class="field" type="number" value="{{form.smsCode}}" data-field="smsCode" bindinput="input" maxlength="6" placeholder="6位验证码" disabled="{{submitting}}" aria-label="提现短信验证码" /><button bindtap="sendCode" disabled="{{submitting || sendingCode || countdown > 0}}">{{countdown > 0 ? countdown + '秒' : sendingCode ? '发送中' : '获取验证码'}}</button></view><text class="hint">发送至 {{maskedPhone}}，仅用于本次提现校验</text>
      <button class="primary-button" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提现</button>
      <text class="hint">提交后按商城规则审核、打款。需要微信收款确认时，请进入提现记录完成确认。</text>
    </view>
    <button class="support" bindtap="history">查看提现记录</button>
  </block>
</view>
