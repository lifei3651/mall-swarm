.orders-page { min-height: 100vh; padding: 0 22rpx calc(160rpx + env(safe-area-inset-bottom)); }
.order-tabs { position: sticky; top: 0; z-index: 3; width: calc(100% + 44rpx); margin-left: -22rpx; padding: 14rpx 22rpx; white-space: nowrap; background: var(--canvas); }
.tab { position: relative; display: inline-flex; align-items: center; height: 72rpx; margin-right: 12rpx; padding: 0 26rpx; border: 1rpx solid var(--line); border-radius: 999rpx; color: #5f697a; background: var(--paper); font-size: 24rpx; }
.tab.active { color: #fff; background: var(--brand); font-weight: 700; }
.tab-count { min-width: 30rpx; height: 30rpx; margin-left: 8rpx; padding: 0 7rpx; border-radius: 999rpx; color: var(--accent); background: var(--paper); font-size: 19rpx; line-height: 30rpx; text-align: center; }
.empty text { display: block; }
.empty button { width: 240rpx; margin-top: 26rpx; font-size: 24rpx; }
.order-card { margin-bottom: 18rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: var(--radius); background: var(--paper); box-shadow: var(--shadow); }
.order-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #edf0f3; }
.order-head-copy { min-width: 0; flex: 1; }
.order-head-copy text { display: block; }
.order-head-copy text:first-child { color: var(--ink); font-size: 27rpx; font-weight: 700; }
.order-head-copy text:last-child { margin-top: 7rpx; overflow: hidden; color: #9299a5; font-size: 21rpx; white-space: nowrap; text-overflow: ellipsis; }
.status-pill { flex: none; padding: 7rpx 14rpx; border-radius: 999rpx; color: var(--accent); background: var(--brand-soft); font-size: 22rpx; font-weight: 650; }
.status-pill.after-sale { color: #9a5a16; background: #fff4df; }
.order-item { display: flex; margin-top: 20rpx; }
.order-item image { flex: none; width: 130rpx; height: 130rpx; border-radius: 16rpx; background: #eef0f3; }
.order-item view { min-width: 0; flex: 1; margin-left: 18rpx; }
.order-item view text { display: block; font-weight: 600; line-height: 38rpx; }
.order-spec { display: block; margin-top: 10rpx; color: #8e95a2; font-size: 24rpx; }
.after-sale-summary { margin-top: 18rpx; padding: 14rpx 18rpx; border-radius: 12rpx; color: #9a5a16; background: #fff7ea; font-size: 23rpx; }
.order-total { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: flex-end; gap: 12rpx 18rpx; margin-top: 22rpx; color: var(--muted); font-size: 23rpx; }
.order-total > view { display: flex; align-items: baseline; gap: 10rpx; color: var(--ink); }
.order-total > view text:first-child { color: #687180; font-size: 23rpx; }
.order-total > view text:last-child { color: var(--price); font-size: 32rpx; font-weight: 700; }
.order-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 14rpx; margin-top: 18rpx; }
.order-card .order-actions button { width: 210rpx; margin: 0; font-size: 24rpx; }
.load-more { width: 300rpx; margin-top: 26rpx; font-size: 25rpx; }
