<view class="orders-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <decoration-nav id="decoration-nav" />
  <view class="order-tabs-shell">
    <scroll-view class="order-tabs" scroll-x enhanced show-scrollbar="{{false}}" scroll-with-animation scroll-into-view="order-tab-{{activeTab}}">
      <view class="order-tabs-track">
        <view id="order-tab-{{item.key}}" class="tab {{activeTab === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="selectTab" aria-role="button" aria-pressed="{{activeTab === item.key}}">
          <text>{{item.label}}</text><text wx:if="{{item.count}}" class="tab-count">{{item.count > 99 ? '99+' : item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>
  <view wx:elif="{{error}}" class="empty error-state"><text>{{error}}</text><button class="secondary-button" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{!rows.length}}" class="empty empty-orders"><text>这里还没有订单</text><button class="primary-button" bindtap="goShopping">去逛逛</button></view>
  <block wx:else>
    <view class="order-card ui-card ui-order-card" wx:for="{{rows}}" wx:key="key" data-id="{{item.order.id}}" bindtap="openDetail">
      <view class="ui-order-header">
        <view class="ui-order-title"><text>{{item.order.merchantName || '商城订单'}}</text><text>{{item.order.orderNo}}</text></view>
        <text class="ui-status-pill ui-order-status is-{{item.statusTone}}">{{item.statusText}}</text>
      </view>
      <view class="ui-order-product">
        <image src="{{item.primaryItem.productCover}}" mode="aspectFill" />
        <text class="ui-order-product-copy">{{item.primaryItem.productName}}{{item.primaryItem.skuName ? ' · ' + item.primaryItem.skuName : ''}}</text>
        <view class="ui-order-product-meta"><text wx:if="{{item.additionalProductKinds}}" class="ui-order-product-more">等{{item.items.length}}种</text><text>×{{item.primaryItem.quantity}}</text></view>
      </view>
      <view class="ui-order-logistics"><text>{{item.logisticsText}}</text><button wx:if="{{item.showMissingAction}}" class="ui-order-logistics-action" data-id="{{item.order.id}}" catchtap="applyAfterSale">未收到 / 拒收</button></view>
      <view class="ui-order-summary"><text>共 {{item.quantity}} 件商品</text><view><text>{{item.amountLabel}}</text><text class="ui-price">¥{{item.amountText}}</text></view></view>
      <view class="order-actions ui-action-bar ui-order-actions">
        <button class="secondary-button ui-order-action" data-id="{{item.order.id}}" catchtap="openDetail">查看详情</button>
        <button wx:if="{{item.canCancel}}" class="secondary-button ui-order-action" data-id="{{item.order.id}}" catchtap="cancelOrder" disabled="{{actingId}}">{{item.cancelLabel}}</button>
        <button wx:if="{{item.canApplyAfterSale}}" class="secondary-button ui-order-action" data-id="{{item.order.id}}" catchtap="applyAfterSale">申请售后</button>
        <button wx:if="{{item.canReceive}}" class="primary-button ui-order-action ui-order-action--primary" data-id="{{item.order.id}}" catchtap="receive" disabled="{{actingId}}">确认收货</button>
        <button wx:if="{{item.pendingReviewProductId && item.pendingReviewOrderItemId}}" class="primary-button ui-order-action ui-order-action--primary" data-id="{{item.order.id}}" catchtap="review">去评价</button>
        <button wx:if="{{item.canPay}}" class="primary-button ui-order-action ui-order-action--primary" data-id="{{item.order.id}}" catchtap="pay">{{item.payLabel}}</button>
      </view>
    </view>
    <button wx:if="{{rows.length < total}}" class="load-more secondary-button" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多订单</button>
  </block>
</view>
