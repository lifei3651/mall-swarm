<view class="orders-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <decoration-nav id="decoration-nav" />
  <view class="order-tabs-shell">
    <scroll-view class="order-tabs" scroll-x enhanced show-scrollbar="{{false}}" scroll-with-animation scroll-into-view="order-tab-{{activeTab}}">
      <view class="order-tabs-track">
        <view id="order-tab-{{item.key}}" class="tab {{activeTab === item.key ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="key" data-key="{{item.key}}" bindtap="selectTab" aria-role="button" aria-pressed="{{activeTab === item.key}}">
          <text>{{item.label}}</text><text wx:if="{{item.count}}" class="tab-count">{{item.count > 99 ? '99+' : item.count}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>
  <view wx:elif="{{error}}" class="empty error-state"><text>{{error}}</text><button class="secondary-button" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{!rows.length}}" class="empty empty-orders"><text>这里还没有订单</text><button class="primary-button" bindtap="goShopping">去逛逛</button></view>
  <block wx:else>
    <view class="order-card ui-card ui-order-card" wx:for="{{rows}}" wx:key="key" data-id="{{item.order.id}}" bindtap="openDetail">
      <view class="ui-order-header">
        <view class="ui-order-heading"><text class="ui-order-merchant">{{item.order.merchantName || '商城订单'}}</text><text class="ui-status-pill ui-order-status is-{{item.statusTone}}">{{item.statusText}}</text></view>
        <button class="ui-copy-action ui-order-copy" data-id="{{item.order.id}}" catchtap="copyOrderNo">复制订单号</button>
      </view>
      <view class="ui-order-products">
        <view class="ui-order-product" wx:for="{{item.items}}" wx:key="id" wx:for-item="line">
          <image src="{{line.productCover}}" mode="aspectFill" />
          <view class="ui-order-product-copy">
            <text class="ui-order-product-name">{{line.productName}}</text>
            <view class="ui-order-product-spec"><text>{{line.skuDisplay}}</text><text>× {{line.quantity}}</text></view>
            <view wx:if="{{line.serviceTags.length}}" class="ui-order-service-tags"><text wx:for="{{line.serviceTags}}" wx:key="title" wx:for-item="tag">{{tag.title}}</text></view>
            <view class="ui-order-product-prices"><text>零售价 ¥{{line.retailPriceText}}</text><text>{{line.paidAmountLabel}} <text class="ui-price">¥{{line.paidAmountText}}</text></text></view>
          </view>
        </view>
      </view>
      <view wx:if="{{item.logisticsText}}" class="ui-order-logistics"><text>{{item.logisticsText}}</text><button wx:if="{{item.showMissingAction}}" class="ui-order-logistics-action" data-id="{{item.order.id}}" data-mode="exception" catchtap="applyAfterSale">未收到 / 拒收</button></view>
      <view class="ui-order-summary"><text>共 {{item.quantity}} 件商品</text><view><text>{{item.amountLabel}}</text><text class="ui-price">¥{{item.amountText}}</text></view></view>
      <view class="order-actions ui-action-bar ui-order-actions">
        <button wx:if="{{item.canViewLogistics}}" class="secondary-button ui-action-button ui-order-action" data-id="{{item.order.id}}" catchtap="viewLogistics" loading="{{wechatTrackingId && item.shipments[0].key === wechatTrackingId}}" disabled="{{!!wechatTrackingId}}">查看物流</button>
        <button wx:if="{{item.canCancel}}" class="secondary-button ui-action-button ui-order-action" data-id="{{item.order.id}}" catchtap="cancelOrder" disabled="{{actingId}}">{{item.cancelLabel}}</button>
        <button wx:if="{{item.canApplyAfterSale}}" class="secondary-button ui-action-button ui-order-action" data-id="{{item.order.id}}" catchtap="applyAfterSale">{{item.order.status === 1 && !item.shipments.length && !item.order.deliveryNo && !item.order.deliveryTime ? '取消并退款' : '退换/售后'}}</button>
        <button wx:if="{{item.canRebuy}}" class="secondary-button ui-action-button ui-order-action" data-id="{{item.order.id}}" catchtap="buyAgain" loading="{{rebuyId === item.order.id}}" disabled="{{!!rebuyId}}">再买一单</button>
        <button wx:if="{{item.pendingReviewProductId && item.pendingReviewOrderItemId}}" class="secondary-button ui-action-button ui-order-action" data-id="{{item.order.id}}" catchtap="review">去评价</button>
        <button wx:if="{{item.canReceive}}" class="primary-button ui-action-button ui-action-button--primary ui-order-action ui-order-action--primary" data-id="{{item.order.id}}" catchtap="receive" disabled="{{actingId}}">确认收货</button>
        <button wx:if="{{item.canPay}}" class="primary-button ui-action-button ui-action-button--primary ui-order-action ui-order-action--primary" data-id="{{item.order.id}}" catchtap="pay">{{item.payLabel}}</button>
      </view>
    </view>
    <button wx:if="{{rows.length < total}}" class="load-more secondary-button" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多订单</button>
  </block>
</view>
