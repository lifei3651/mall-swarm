<view class="orders-page">
  <view wx:if="{{loading}}" class="empty">正在加载订单…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <view wx:elif="{{!rows.length}}" class="empty">还没有订单</view>
  <view wx:else class="order-card" wx:for="{{rows}}" wx:key="key">
    <view class="order-head"><text>{{item.order.orderNo}}</text><text>{{item.statusText}}</text></view>
    <view class="order-item" wx:for="{{item.items}}" wx:key="id" wx:for-item="line">
      <image src="{{line.productCover}}" mode="aspectFill" />
      <view><text>{{line.productName}}</text><text class="order-spec">{{line.skuName || ''}} × {{line.quantity}}</text></view>
    </view>
    <view class="order-total">实付 <text>¥{{item.amountText}}</text></view>
    <button wx:if="{{item.order.status === 0}}" class="secondary-button" bindtap="paymentNotice">查看支付说明</button>
  </view>
</view>
