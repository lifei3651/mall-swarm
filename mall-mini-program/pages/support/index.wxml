<view class="support-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{!creating}}" class="support-head"><text class="support-hint">提交问题，查看处理进度</text><button class="primary-button" bindtap="openCreate">提交问题</button></view>
  <view wx:if="{{!creating}}" class="support-card"><text class="support-hint">{{legal.serviceHours || '客服将按工单顺序处理'}}</text><button class="contact-link ui-select-row" bindtap="contact"><text>查看商城联系方式</text><image class="ui-select-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" /></button></view>
  <view wx:if="{{creating}}" class="support-card create-card"><view class="section-head"><view class="section-title">提交问题</view><button class="ui-text-action" bindtap="cancelCreate" disabled="{{submitting}}">取消</button></view>
    <picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="chooseType" disabled="{{submitting}}" aria-label="选择问题类型"><view class="ui-select-row"><text class="ui-select-label">问题类型</text><text class="ui-select-value">{{types[typeIndex].label}}</text><image class="ui-select-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" /></view></picker>
    <text class="field-label">问题标题</text><input value="{{form.subject}}" data-field="subject" bindinput="input" maxlength="100" disabled="{{submitting}}" placeholder="例如：订单售后处理进度咨询" aria-label="问题标题" />
    <block wx:if="{{form.type !== 'ACCOUNT'}}"><picker wx:if="{{orderChoices.length > 1 && !contextLoading}}" range="{{orderChoices}}" range-key="label" value="{{orderIndex}}" bindchange="chooseOrder" disabled="{{submitting}}" aria-label="选择关联订单，选填"><view class="ui-select-row"><text class="ui-select-label">关联订单<text class="optional">（选填）</text></text><text class="ui-select-value">{{orderChoices[orderIndex].label}}</text><image class="ui-select-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" /></view></picker><view wx:else class="ui-select-row"><text class="ui-select-label">关联订单<text class="optional">（选填）</text></text><text class="ui-select-value muted">{{contextLoading ? '正在加载' : contextError ? '暂不可用' : '暂无可关联订单'}}</text></view></block>
    <picker wx:if="{{afterSaleChoices.length > 1}}" range="{{afterSaleChoices}}" range-key="label" value="{{afterSaleIndex}}" bindchange="chooseAfterSale" disabled="{{submitting}}" aria-label="选择关联售后"><view class="ui-select-row"><text class="ui-select-label">关联售后</text><text class="ui-select-value">{{afterSaleChoices[afterSaleIndex].label}}</text><image class="ui-select-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" /></view></picker>
    <text wx:elif="{{form.type === 'AFTER_SALE_DISPUTE'}}" class="support-hint">请先关联有售后记录的订单。</text>
    <view wx:if="{{contextError}}" class="support-error">{{contextError}}<button bindtap="loadContext">重新加载关联订单</button></view>
    <text class="field-label">问题说明</text><textarea value="{{form.content}}" data-field="content" bindinput="input" maxlength="1000" disabled="{{submitting}}" placeholder="请说明发生了什么、希望如何协助处理。涉及售后图片请先在订单售后中提交凭证。" aria-label="问题说明" /><text class="char-count">{{form.content.length}}/1000</text>
    <text class="support-hint">请勿填写密码、验证码或银行卡号。</text><button class="primary-button" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">提交工单</button>
  </view>
  <view class="support-tabs" aria-label="工单状态"><button wx:for="{{filters}}" wx:key="key" class="{{status === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectStatus" aria-pressed="{{status === item.key}}">{{item.label}}</button></view>
  <view wx:if="{{error}}" class="support-error"><text>{{error}}</text><button bindtap="load">重新加载</button></view>
  <view wx:for="{{rows}}" wx:key="id" class="support-card ticket-card" data-id="{{item.id}}" bindtap="openTicket" aria-role="button"><view class="section-head"><text class="eyebrow">{{item.typeText}}</text><text class="status-badge">{{item.statusText}}</text></view><view class="section-title">{{item.subject}}</view><text class="support-hint">{{item.nextActionHint}}</text><view class="ticket-meta"><text>{{item.ticketNo}}</text><text>{{item.timeText}}</text></view></view>
  <text wx:if="{{loading}}" class="support-empty">正在加载工单…</text><text wx:elif="{{!rows.length && !error}}" class="support-empty">当前没有{{status ? '该状态的' : ''}}客服工单</text><button wx:if="{{pageNum < totalPage && !error}}" class="secondary-button" bindtap="loadMore" disabled="{{loading}}">加载更多</button>
</view>
