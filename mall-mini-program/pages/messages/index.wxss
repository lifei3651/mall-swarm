.message-page { min-height: 100vh; padding: 22rpx; }
.message-head { display: flex; align-items: flex-end; justify-content: space-between; padding: 30rpx; border-radius: 28rpx; background: linear-gradient(135deg, #232a38, #e7193f); color: #fff; }
.message-head>view>text { display: block; color: rgba(255,255,255,.72); font-size: 22rpx; }
.message-head>view>view { margin: 8rpx 0; font-size: 42rpx; font-weight: 700; }
.message-head button { flex: none; width: 150rpx; margin: 0; padding: 0; background: rgba(255,255,255,.18); color: #fff; font-size: 23rpx; }
.subscribe-card { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 26rpx; border-radius: 22rpx; background: #fff; }
.subscribe-card view text { display: block; }
.subscribe-card view text:first-child { font-weight: 700; }
.subscribe-card view text:last-child { margin-top: 8rpx; color: #858d9b; font-size: 23rpx; }
.subscribe-card>text { color: #adb3be; font-size: 38rpx; }
.category-list { width: 100%; margin: 18rpx 0 10rpx; white-space: nowrap; }
.category-row { display: flex; gap: 12rpx; }
.category-row button { flex: none; margin: 0; padding: 0 24rpx; border-radius: 999rpx; background: #fff; color: #697182; font-size: 24rpx; line-height: 70rpx; }
.category-row button.active { background: var(--brand); color: #fff; }
.category-row button text { display: inline-block; margin-left: 8rpx; }
.message-card { display: flex; align-items: flex-start; gap: 18rpx; margin-top: 14rpx; padding: 26rpx; border-radius: 22rpx; background: #fff; }
.dot { flex: none; width: 12rpx; height: 12rpx; margin-top: 12rpx; border-radius: 50%; background: transparent; }
.message-card.unread .dot { background: var(--brand); }
.message-copy { min-width: 0; flex: 1; }
.message-copy text { display: block; }
.message-copy text:first-child { font-weight: 700; }
.message-copy text:nth-child(2) { margin-top: 10rpx; color: #697182; font-size: 24rpx; line-height: 38rpx; }
.message-copy text:last-child { margin-top: 12rpx; color: #a0a6b1; font-size: 21rpx; }
.arrow { color: #adb3be; font-size: 38rpx; }
.more { width: 220rpx; margin: 28rpx auto; border-radius: 999rpx; background: #fff; font-size: 24rpx; }
