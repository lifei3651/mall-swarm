.message-page { min-height:100vh; padding:0 24rpx calc(48rpx + env(safe-area-inset-bottom)); background:var(--canvas); }
.message-tools { display:flex; align-items:center; justify-content:space-between; min-height:92rpx; }
.message-tools button { width:auto; min-width:0; min-height:88rpx; margin:0; padding:20rpx 8rpx; background:transparent; color:var(--muted); font-size:25rpx; font-weight:400; line-height:48rpx; }
.category-list { margin-bottom:16rpx; background:var(--paper); border-radius:12rpx; }
.category-row { display:flex; }
.message-page .category-row button { position:relative; flex:1; width:0; min-width:0; margin:0; padding:24rpx 0; border-radius:0; background:transparent; color:var(--muted); font-size:27rpx; line-height:42rpx; font-weight:400; }
.category-row button.active { color:var(--brand); box-shadow:inset 0 -4rpx var(--brand); font-weight:600; }
.category-row button text { position:absolute; top:2rpx; right:2rpx; min-width:24rpx; padding:0 5rpx; background:var(--brand-soft); color:var(--accent); border-radius:10rpx; font-size:18rpx; line-height:26rpx; }
.message-card { display:flex; align-items:flex-start; gap:16rpx; padding:28rpx 22rpx; border-bottom:1rpx solid var(--line); background:var(--paper); }
.dot { flex:none; width:10rpx; height:10rpx; margin-top:14rpx; border-radius:50%; background:transparent; }
.message-card.unread .dot { background:var(--brand); }
.message-copy { flex:1; min-width:0; overflow-wrap:anywhere; }
.message-copy text { display:block; }
.message-copy text:first-child { font-size:29rpx; font-weight:500; line-height:42rpx; }
.message-copy text:nth-child(2) { margin-top:10rpx; color:var(--muted); font-size:25rpx; line-height:38rpx; }
.message-copy text:last-child { margin-top:14rpx; color:var(--muted); font-size:22rpx; }
.arrow { color:var(--muted); font-size:34rpx; }
.message-empty { padding:100rpx 24rpx; }
.message-empty > text { display:block; font-size:25rpx; line-height:40rpx; }
.message-empty > text:first-child { margin-bottom:12rpx; color:var(--ink); font-size:30rpx; }
.message-empty button { margin-top:28rpx; font-size:25rpx; }
.message-page .more { width:240rpx; margin:24rpx auto; min-height:88rpx; padding:20rpx; background:var(--paper); color:var(--ink); font-size:25rpx; }
.subscribe-card { display:flex; align-items:center; justify-content:space-between; padding:26rpx; margin-bottom:20rpx; border-radius:12rpx; background:var(--paper); }
.subscribe-card text { display:block; line-height:40rpx; }
.subscribe-card view text:last-child { color:var(--muted); font-size:23rpx; }
.sms-card { display:flex; align-items:center; gap:24rpx; padding:26rpx; border-radius:12rpx; background:var(--paper); }
.sms-card > view { flex:1; min-width:0; }
.sms-card text { display:block; margin-top:12rpx; color:var(--muted); font-size:23rpx; line-height:38rpx; }
.sms-card .sms-label { display:none; }
.sms-card > view > view { font-size:29rpx; }
.sms-card .sms-toggle { flex:none; width:auto; min-width:0; min-height:88rpx; margin:0; padding:20rpx 16rpx; background:var(--brand-soft); color:var(--accent); font-size:24rpx; line-height:48rpx; border-radius:12rpx; }
