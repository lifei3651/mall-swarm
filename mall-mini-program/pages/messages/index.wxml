<view class="message-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view class="message-tools">
    <button bindtap="toggleSettings" disabled="{{smsBusy}}">{{settingsVisible ? '返回消息' : '提醒设置'}}</button>
    <button wx:if="{{!settingsVisible && unread.total && !category}}" bindtap="readAll" disabled="{{reading}}">全部已读</button>
    <button wx:if="{{!settingsVisible && category}}" bindtap="readCategory" disabled="{{reading}}">本类已读</button>
  </view>
  <block wx:if="{{settingsVisible}}">
  <view wx:if="{{subscriptionAvailable}}" class="subscribe-card" bindtap="subscriptions">
    <view><text>微信服务提醒</text><text>按需订阅发货、退款和到账提醒</text></view><text>›</text>
  </view>
  <view class="sms-card"><view><text class="sms-label">可选提醒</text><view>重要进度短信</view><text>仅用于订单发货、售后退款和账号安全变化，不含营销内容。</text><text>{{smsPreference.statusText}}{{smsPreference.maskedPhone ? ' · ' + smsPreference.maskedPhone : ''}}</text></view><button class="sms-toggle" bindtap="changeSmsPreference" disabled="{{smsBusy || (!smsPreference.available && !smsPreference.enabled)}}" aria-label="{{smsPreference.enabled ? '关闭重要进度短信' : '开启重要进度短信'}}">{{smsBusy ? '保存中' : smsPreference.enabled ? '已开启' : '未开启'}}</button></view>
  <button wx:if="{{smsError}}" class="more" bindtap="loadSmsPreference">重新读取短信设置</button>
  </block>
  <block wx:else>
  <view class="category-list">
    <view class="category-row">
      <button wx:for="{{categories}}" wx:key="key" data-key="{{item.key}}" class="{{category === item.key ? 'active' : ''}}" bindtap="selectCategory">
        {{item.label}}
        <text wx:if="{{item.count}}">{{item.count > 99 ? '99+' : item.count}}</text>
      </button>
    </view>
  </view>
  <view wx:if="{{loading && !rows.length}}" class="empty">正在加载消息…</view>
  <view wx:elif="{{error && !rows.length}}" class="empty message-empty"><text>消息加载失败</text><text>{{error}}</text><button class="secondary-button" bindtap="retry">重新加载</button></view>
  <view wx:elif="{{!rows.length}}" class="empty message-empty"><text>暂时没有新消息</text><text>订单、退款和到账进度会在这里更新</text><button wx:if="{{subscriptionAvailable}}" class="secondary-button" bindtap="subscriptions">设置微信提醒</button></view>
  <block wx:else>
    <view wx:for="{{rows}}" wx:key="id" class="message-card {{item.isRead === 1 ? '' : 'unread'}}" data-id="{{item.id}}" bindtap="openMessage">
      <view class="dot"></view>
      <view class="message-copy"><text>{{item.title}}</text><text>{{item.summary}}</text><text>{{item.displayTime}}</text></view>
      <text class="arrow">›</text>
    </view>
    <button wx:if="{{pageNum < totalPage}}" class="more" loading="{{loading}}" bindtap="loadMore">加载更多</button>
  </block>
  </block>
</view>
