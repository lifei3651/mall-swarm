<view class="checkout-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{loading}}" class="empty">正在加载结算信息…</view>
  <block wx:else>
    <view wx:if="{{loadError}}" class="checkout-error"><text>{{loadError}}</text><button bindtap="load">重新加载</button></view>
    <view wx:if="{{activityName}}" class="section-kicker"><text>限时活动</text><text>{{activityName}}</text></view>
    <view class="section-kicker"><text>收货信息</text><text>请确认地址准确无误</text></view>
    <view class="address-card" bindtap="chooseAddress">
      <block wx:if="{{address}}">
        <view class="address-head"><text>{{address.receiverName}}</text><text>{{address.receiverPhone}}</text></view>
        <view class="address-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detailAddress}}</view>
      </block>
      <view wx:else class="address-empty"><text>添加收货地址</text><text>填写收货人、手机号和详细地址</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="section-kicker"><text>商品清单</text><text>共 {{count}} 件</text></view>
    <view class="checkout-items">
      <view class="checkout-item" wx:for="{{rows}}" wx:key="key">
        <image src="{{item.coverUrl}}" mode="aspectFill" />
        <view><text class="item-name">{{item.productName}}</text><text class="muted">{{item.skuName || '默认规格'}} × {{item.quantity}}</text></view>
        <text class="item-price">¥{{item.priceText}}</text>
      </view>
    </view>
    <view class="remark-row" bindtap="openRemark" aria-role="button" aria-disabled="{{submitting}}" aria-label="编辑订单备注"><text class="remark-label">订单备注</text><text class="remark-value">{{remark || '无备注'}}</text><text class="remark-arrow" aria-hidden="true">›</text></view>
    <view class="pay-card"><view><text>支付方式</text><text>支付结果以订单状态为准</text></view><button wx:if="{{wechatPayEnabled}}" class="pay-choice pay-choice-button" data-type="WECHAT" bindtap="selectPayType"><radio checked="{{payType === 'WECHAT'}}" color="#07c160" /><text>微信支付</text></button><button wx:if="{{balanceAvailable}}" class="pay-choice pay-choice-button" data-type="BALANCE" bindtap="selectPayType"><radio checked="{{payType === 'BALANCE'}}" color="{{themeColor}}" /><view><text>余额支付</text><text class="muted">可用余额 ¥{{balanceSummary.balanceText}}</text></view></button><text wx:if="{{payType === 'BALANCE' && !balanceSummary.hasPaymentPassword}}" class="muted">首次支付需设置独立6位支付密码，待支付订单会保留。</text><text wx:if="{{payType === 'BALANCE' && balanceSummary.paymentPasswordLocked}}" class="checkout-error">支付密码已临时锁定，请稍后刷新。</text><button wx:if="{{balanceError}}" class="payment-retry" bindtap="load">{{balanceError}}</button></view>
    <view wx:if="{{needSmsVerify}}" class="sms-card">
      <view><text class="sms-title">大额支付验证</text><text class="muted">验证码只发送到当前账号绑定手机号</text></view>
      <view class="sms-row">
        <input type="number" maxlength="6" placeholder="6位验证码" aria-label="支付短信验证码" value="{{smsCode}}" bindinput="smsCodeInput" />
        <button size="mini" loading="{{smsSending}}" disabled="{{smsSending || smsCooldown > 0}}" bindtap="sendPaymentSms">{{smsCooldown > 0 ? smsCooldown + '秒' : '获取验证码'}}</button>
      </view>
    </view>
    <view wx:if="{{quoteError}}" class="checkout-error"><text>{{quoteError}}</text><button bindtap="retryQuote">重新计算</button></view>
    <view class="amount-card"><view><text>商品金额</text><text>¥{{total}}</text></view><view><text>运费</text><text>{{freight === '--' ? '待确认' : '¥' + freight}}</text></view><view class="amount-total"><text>应付金额</text><text>{{quoteReady ? '¥' + payTotal : quoteLoading ? '正在计算…' : '待确认'}}</text></view></view>
    <view class="checkout-footer">
      <view><text class="muted">应付</text><text>{{quoteReady ? '¥' + payTotal : '待确认'}}</text></view>
      <button class="primary-button" loading="{{submitting || quoteLoading}}" disabled="{{submitting || loading || quoteLoading || !quoteReady}}" bindtap="submit">{{quoteLoading ? '金额计算中' : '提交并支付'}}</button>
    </view>
  </block>
  <view wx:if="{{remarkEditorVisible}}" class="remark-overlay" catchtap="cancelRemark" catchtouchmove="stopRemarkTap">
    <view class="remark-dialog" catchtap="stopRemarkTap" role="dialog" aria-modal="true" aria-label="订单备注">
      <view class="remark-dialog-title">订单备注</view>
      <textarea class="remark-input" fixed focus maxlength="500" placeholder="填写给商家的说明，选填" aria-label="订单备注，选填" value="{{remarkDraft}}" bindinput="remarkInput" cursor-spacing="100" />
      <text class="remark-count">{{remarkDraft.length}}/500</text>
      <view class="remark-actions"><button class="secondary-button" bindtap="cancelRemark">取消</button><button class="primary-button" bindtap="saveRemark">确定</button></view>
    </view>
  </view>
</view>
