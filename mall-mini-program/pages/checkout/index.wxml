<view class="checkout-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{loading}}" class="empty">正在加载结算信息…</view>
  <block wx:else>
    <view wx:if="{{loadError}}" class="checkout-error"><text>{{loadError}}</text><button class="ui-button--secondary" bindtap="load">重新加载</button></view>
    <view wx:if="{{activityName}}" class="section-kicker"><text>限时活动</text><text>{{activityName}}</text></view>
    <view class="section-kicker"><text>收货信息</text><text>请确认地址准确无误</text></view>
    <view class="address-card" bindtap="chooseAddress">
      <block wx:if="{{address}}">
        <view class="address-head"><text>{{address.receiverName}}</text><text>{{address.receiverPhone}}</text></view>
        <view class="address-detail">{{address.province}}{{address.city}}{{address.district}}{{address.detailAddress}}</view>
      </block>
      <view wx:else class="address-empty"><text>添加收货地址</text><text>填写收货人、手机号和详细地址</text></view>
      <text class="arrow">›</text>
    </view>
    <view class="section-kicker"><text>商品清单</text><text>共 {{count}} 件</text></view>
    <view class="checkout-items">
      <view class="checkout-item" wx:for="{{rows}}" wx:key="key">
        <image src="{{item.coverUrl}}" mode="aspectFill" />
        <view><text class="item-name">{{item.productName}}</text><text class="muted">{{item.skuName || '默认规格'}} × {{item.quantity}}</text></view>
        <text class="item-price">¥{{item.priceText}}</text>
      </view>
    </view>
    <view class="remark-row" bindtap="openRemark" aria-role="button" aria-disabled="{{submitting}}" aria-label="编辑订单备注"><text class="remark-label">订单备注</text><text class="remark-value">{{remark || '无备注'}}</text><text class="remark-arrow" aria-hidden="true">›</text></view>
    <view wx:if="{{couponEnabled}}" class="remark-row" bindtap="openCoupons" aria-role="button" aria-label="选择优惠券"><text class="remark-label">优惠券</text><text class="remark-value">{{couponClaimId ? '已选 · 减 ¥' + discount : '选择优惠券'}}</text><text class="remark-arrow" aria-hidden="true">›</text></view>
    <view class="pay-card"><view><text>支付方式</text><text>支付结果以订单状态为准</text></view><button wx:if="{{wechatPayEnabled}}" class="pay-choice pay-choice-button" data-type="WECHAT" bindtap="selectPayType"><radio checked="{{payType === 'WECHAT'}}" color="#07c160" /><text>微信支付</text></button><button wx:if="{{balanceAvailable}}" class="pay-choice pay-choice-button" data-type="BALANCE" bindtap="selectPayType"><radio checked="{{payType === 'BALANCE'}}" color="{{themeColor}}" /><view><text>余额支付</text><text class="muted">可用余额 ¥{{balanceSummary.balanceText}}</text></view></button><text wx:if="{{!wechatPayEnabled && !balanceAvailable && !loading}}" class="checkout-error">当前没有可用的在线支付方式，请联系商城客服。</text><text wx:if="{{payType === 'BALANCE' && !balanceSummary.hasPaymentPassword}}" class="muted">首次支付请先在结算页设置独立6位支付密码；设置前不会创建订单。</text><text wx:if="{{payType === 'BALANCE' && balanceSummary.paymentPasswordLocked}}" class="checkout-error">支付密码已临时锁定，请稍后刷新。</text><button wx:if="{{balanceError}}" class="payment-retry" bindtap="load">{{balanceError}}</button></view>
    <view wx:if="{{needSmsVerify}}" class="sms-card">
      <view><text class="sms-title">大额支付验证</text><text class="muted">验证码只发送到当前账号绑定手机号</text></view>
      <view class="sms-row">
        <input type="number" maxlength="6" placeholder="6位验证码" aria-label="支付短信验证码" value="{{smsCode}}" bindinput="smsCodeInput" />
        <button size="mini" loading="{{smsSending}}" disabled="{{smsSending || smsCooldown > 0}}" bindtap="sendPaymentSms">{{smsCooldown > 0 ? smsCooldown + '秒' : '获取验证码'}}</button>
      </view>
    </view>
    <view wx:if="{{quoteError}}" class="checkout-error"><text>{{quoteError}}</text><button bindtap="retryQuote">重新计算</button></view>
    <view class="amount-card"><view><text>商品金额</text><text>¥{{total}}</text></view><view wx:if="{{couponEnabled}}"><text>优惠券抵扣</text><text>−¥{{discount}}</text></view><view><text>运费</text><text>{{freight === '--' ? '待确认' : '¥' + freight}}</text></view><view class="amount-total"><text>应付金额</text><text>{{quoteReady ? '¥' + payTotal : quoteLoading ? '正在计算…' : '待确认'}}</text></view></view>
    <view class="checkout-footer">
      <view><text class="muted">应付</text><text>{{quoteReady ? '¥' + payTotal : '待确认'}}</text></view>
      <button class="primary-button" loading="{{submitting || quoteLoading}}" disabled="{{submitting || loading || quoteLoading || !quoteReady || (!wechatPayEnabled && !balanceAvailable)}}" bindtap="submit">{{quoteLoading ? '金额计算中' : '提交并支付'}}</button>
    </view>
  </block>
  <view wx:if="{{remarkEditorVisible}}" class="remark-overlay" catchtap="cancelRemark" catchtouchmove="stopRemarkTap">
    <view class="remark-dialog" catchtap="stopRemarkTap" role="dialog" aria-modal="true" aria-label="订单备注">
      <view class="remark-dialog-title">订单备注</view>
      <textarea class="remark-input" fixed focus maxlength="500" placeholder="填写给商家的说明，选填" aria-label="订单备注，选填" value="{{remarkDraft}}" bindinput="remarkInput" cursor-spacing="100" />
      <text class="remark-count">{{remarkDraft.length}}/500</text>
      <view class="remark-actions"><button class="secondary-button" bindtap="cancelRemark">取消</button><button class="primary-button" bindtap="saveRemark">确定</button></view>
    </view>
  </view>
  <view wx:if="{{couponPickerVisible}}" class="coupon-mask" catchtap="closeCoupons" catchtouchmove="stopRemarkTap">
    <view class="coupon-sheet" catchtap="stopRemarkTap" aria-role="dialog" aria-label="选择优惠券">
      <view class="coupon-sheet-head"><text>选择优惠券</text><view bindtap="closeCoupons" aria-role="button">关闭</view></view>
      <text class="coupon-hint">每次结算限用一张，优惠按适用商品计算</text>
      <scroll-view scroll-y class="coupon-options" show-scrollbar="{{false}}" enhanced="{{true}}">
        <view class="coupon-option {{!couponClaimId ? 'chosen' : ''}}" data-id="" bindtap="chooseCoupon" aria-role="button"><text>不使用优惠券</text><text>{{!couponClaimId ? '✓' : '○'}}</text></view>
        <view wx:for="{{couponOptions}}" wx:key="claimId" class="coupon-option {{item.claimId === couponClaimId ? 'chosen' : ''}} {{!item.usable ? 'unusable' : ''}}" data-id="{{item.claimId}}" bindtap="chooseCoupon" aria-role="button" aria-disabled="{{!item.usable}}"><view><text class="coupon-name">{{item.title}} · 减 ¥{{item.amountText}}</text><text class="coupon-hint">{{item.scopeLabel}} · 满 ¥{{item.minimumText}} 可用</text><text wx:if="{{item.reason}}" class="coupon-hint">{{item.reason}}</text></view><text>{{item.claimId === couponClaimId ? '✓' : '○'}}</text></view>
        <view wx:if="{{!couponOptions.length}}" class="coupon-hint">暂无已领取的优惠券</view>
      </scroll-view>
      <view class="coupon-claim-link" bindtap="claimCoupons" aria-role="button">去领券中心 ›</view>
    </view>
  </view>
  <view wx:if="{{passwordSetupVisible}}" class="password-setup-mask" catchtap="closePasswordSetup" catchtouchmove="stopRemarkTap">
    <view class="password-setup-sheet" catchtap="stopRemarkTap" aria-role="dialog" aria-label="首次设置余额支付密码">
      <view class="password-setup-title">{{passwordSetupSaved ? '支付密码已设置' : '首次设置支付密码'}}</view>
      <block wx:if="{{passwordSetupSaved}}">
        <text class="password-setup-hint">订单尚未创建。请继续核对金额并提交，随后输入支付密码完成付款。</text>
        <button class="primary-button" bindtap="continueAfterPasswordSetup">继续提交订单</button>
      </block>
      <block wx:else>
        <text class="password-setup-hint">先设置独立6位支付密码，再创建余额订单。短信验证码只发往当前账号绑定手机。</text>
        <text class="password-setup-label">当前商城登录密码</text>
        <input class="password-setup-input" password maxlength="32" value="{{passwordSetupForm.loginPassword}}" data-field="loginPassword" bindinput="passwordSetupInput" disabled="{{passwordSetupBusy}}" placeholder="请输入登录密码" aria-label="当前商城登录密码" />
        <button class="password-setup-help ui-button--secondary" bindtap="openLoginPasswordSetup" disabled="{{passwordSetupBusy}}">尚未设置商城登录密码？先设置</button>
        <text class="password-setup-label">短信验证码</text>
        <view class="password-setup-sms"><input class="password-setup-input" type="number" maxlength="6" value="{{passwordSetupForm.smsCode}}" data-field="smsCode" bindinput="passwordSetupInput" disabled="{{passwordSetupBusy}}" placeholder="6位验证码" aria-label="支付密码短信验证码" /><button class="ui-button--secondary" bindtap="sendPasswordSetupCode" disabled="{{passwordSetupBusy || passwordSetupSending || passwordSetupCooldown > 0}}">{{passwordSetupCooldown ? passwordSetupCooldown + '秒' : passwordSetupSending ? '发送中' : '获取验证码'}}</button></view>
        <text class="password-setup-label">新支付密码</text>
        <input class="password-setup-input" password type="number" maxlength="6" value="{{passwordSetupForm.newPassword}}" data-field="newPassword" bindinput="passwordSetupInput" disabled="{{passwordSetupBusy}}" placeholder="6位数字" aria-label="新支付密码" />
        <text class="password-setup-label">再次确认</text>
        <input class="password-setup-input" password type="number" maxlength="6" value="{{passwordSetupForm.confirmPassword}}" data-field="confirmPassword" bindinput="passwordSetupInput" disabled="{{passwordSetupBusy}}" placeholder="再次输入6位数字" aria-label="确认新支付密码" />
        <text wx:if="{{passwordSetupError}}" class="password-setup-error" role="alert">{{passwordSetupError}}</text>
        <button class="primary-button" bindtap="savePasswordSetup" loading="{{passwordSetupBusy}}" disabled="{{passwordSetupBusy || passwordSetupSending}}">保存支付密码</button>
      </block>
      <button class="password-setup-cancel ui-button--secondary" bindtap="closePasswordSetup" disabled="{{passwordSetupBusy}}">取消，返回结算</button>
    </view>
  </view>
</view>
