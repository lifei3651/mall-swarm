.culture-image { display: block; width: 100%; }
.culture-copy, .room { padding: 24rpx; margin-bottom: 24rpx; }
.culture-text { display: block; margin-top: 24rpx; line-height: 1.9; white-space: pre-wrap; overflow-wrap: anywhere; }
.room video { width: 100%; height: 400rpx; }
.live-card { margin-bottom: 24rpx; padding: 20rpx; }
.live-card image { width: 100%; height: 320rpx; border-radius: var(--radius); }
.live-card > view { margin-top: 16rpx; font-weight: 650; }
.empty button { margin-top: 24rpx; }
.page .live-tabs { display:flex; gap:44rpx; padding:0 10rpx; margin-bottom:24rpx; border-bottom:1rpx solid var(--line); }.live-tabs button { width:auto; min-width:0; margin:0; padding:18rpx 0; border-radius:0; font-size:32rpx; font-weight:400; color:var(--muted); background:transparent; }.live-tabs button.active { color:var(--ink); font-weight:600; border-bottom:5rpx solid var(--brand); }
.live-room-list { display:grid; gap:20rpx; }.live-room-card { display:grid; grid-template-columns:46% 54%; min-height:456rpx; overflow:hidden; background:var(--paper); border:1rpx solid var(--line); border-radius:18rpx; }.live-cover { position:relative; overflow:hidden; background:var(--canvas); }.live-cover>image { position:absolute; width:100%; height:100%; }.live-state { position:absolute; top:16rpx; left:12rpx; max-width:calc(100% - 24rpx); padding:6rpx 10rpx; border-radius:20rpx; background:#ef1742; color:#fff; font-size:20rpx; }.live-title { position:absolute; bottom:0; left:0; right:0; padding:16rpx; background:rgba(0,0,0,.52); color:#fff; font-size:30rpx; line-height:1.4; }.live-room-panel { min-width:0; display:flex; flex-direction:column; }.live-anchor { display:flex; align-items:center; gap:12rpx; min-height:106rpx; padding:14rpx; }.live-anchor>image { width:58rpx; height:58rpx; flex:none; border-radius:50%; background:var(--canvas); padding:10rpx; }.live-anchor>view { min-width:0; flex:1; }.live-anchor text { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:23rpx; }.live-anchor .muted { margin-top:5rpx; font-size:20rpx; }
.live-product-stack { flex:1; display:grid; grid-template-rows:repeat(2,minmax(0,1fr)); gap:12rpx; padding:0 12rpx 12rpx; }.live-product-row { display:flex; min-width:0; background:var(--canvas); border-radius:12rpx; overflow:hidden; }.live-product-row>image { width:44%; height:156rpx; flex:none; }.live-product-row>view { flex:1; min-width:0; padding:10rpx; display:flex; flex-direction:column; }.live-product-row text { font-size:20rpx; line-height:1.4; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }.live-product-row .muted { -webkit-line-clamp:1; margin-top:5rpx; font-size:18rpx; }.live-product-row .live-price { margin-top:auto; color:var(--price); font-size:25rpx; }
.upcoming-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; }.upcoming-card { overflow:hidden; border:1rpx solid var(--line); border-radius:16rpx; background:var(--paper); }.upcoming-card .live-cover { height:356rpx; }.upcoming-card .live-state { top:0; left:0; background:rgba(255,255,255,.9); color:var(--muted); border-radius:0 0 12rpx 0; font-size:18rpx; }.upcoming-title { padding:16rpx 16rpx 0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:27rpx; font-weight:600; }.upcoming-card .live-anchor { padding:10rpx 14rpx 18rpx; min-height:78rpx; gap:6rpx; }.upcoming-card .live-anchor>image { width:38rpx; height:38rpx; padding:6rpx; }.upcoming-card .live-anchor text { font-size:20rpx; }.page .reserve-button { flex:none; width:auto; margin:0 0 0 auto; min-width:94rpx; padding:9rpx 14rpx; border-radius:30rpx; color:var(--brand); background:var(--brand-soft); font-size:21rpx; line-height:1.5; }.reserve-button.reserved { background:var(--brand); color:#fff; }
.live-stage { position:relative; height:440rpx; overflow:hidden; color:#fff; background:#101828; border-radius:30rpx; }.live-stage>video,.live-stage>image { width:100%; height:100%; }.stage-state { position:absolute; left:22rpx; top:22rpx; padding:10rpx 16rpx; color:#fff; background:#ef1742; font-size:23rpx; border-radius:30rpx; }.stage-copy { position:absolute; inset:0; display:flex; flex-direction:column; justify-content:flex-end; gap:12rpx; padding:30rpx; background:linear-gradient(transparent,rgba(0,0,0,.8)); }.stage-copy text:first-child { font-size:38rpx; font-weight:600; }.stage-copy text:last-child { font-size:24rpx; }
.live-chat { margin-top:18rpx; border-radius:30rpx; overflow:hidden; box-shadow:none; }.chat-heading { display:flex; justify-content:space-between; gap:10rpx; padding:24rpx; border-bottom:1rpx solid var(--line); font-size:28rpx; }.chat-heading .muted { font-size:22rpx; }.comment-list { height:365rpx; padding:24rpx; }.comment-row { display:flex; align-items:flex-start; gap:12rpx; margin-bottom:18rpx; font-size:24rpx; line-height:1.5; }.comment-row text:first-child { max-width:32%; color:var(--brand); flex:none; overflow-wrap:anywhere; }.comment-row text:last-child { flex:1; min-width:0; overflow-wrap:anywhere; }.comment-empty,.comment-closed { display:block; padding:30rpx; text-align:center; color:var(--muted); font-size:24rpx; }.comment-form { display:flex; gap:14rpx; padding:20rpx; border-top:1rpx solid var(--line); }.comment-form input { min-width:0; flex:1; height:78rpx; padding:0 22rpx; border-radius:40rpx; background:var(--canvas); font-size:25rpx; }.comment-form .primary-button { width:110rpx; min-height:78rpx; padding:10rpx; margin:0; font-size:23rpx; }.page .comment-error { width:100%; margin:0; padding:14rpx; color:var(--brand); background:var(--brand-soft); font-size:22rpx; line-height:1.6; border-radius:0; }
.live-info { display:flex; flex-wrap:wrap; align-items:center; margin-top:20rpx; padding:16rpx; box-shadow:none; }.live-info .live-anchor { flex:1; min-width:0; padding:8rpx; }.page .share-button { width:auto; margin:0; padding:12rpx 25rpx; border:1rpx solid var(--brand); background:var(--paper); color:var(--brand); font-size:25rpx; line-height:1.5; border-radius:30rpx; }.live-metrics { width:100%; display:flex; justify-content:space-between; gap:16rpx; padding:16rpx 10rpx 6rpx; color:var(--muted); font-size:22rpx; }
