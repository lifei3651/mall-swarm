<view class="payout-page">
  <view class="notice-card">
    <view>微信收款确认</view>
    <text>平台发起微信提现后，需要由收款会员本人在微信内确认。页面显示成功前，系统仍会向微信核验最终结果。</text>
  </view>
  <view wx:if="{{loading}}" class="empty">正在加载…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <view wx:elif="{{!rows.length}}" class="empty">暂无待确认的微信提现</view>
  <block wx:else>
    <view class="payout-card" wx:for="{{rows}}" wx:key="id">
      <view class="payout-copy">
        <text>{{item.withdrawNo}}</text>
        <strong>¥{{item.amountText}}</strong>
        <text>{{item.statusName || '打款处理中'}}</text>
      </view>
      <button class="primary-button" data-id="{{item.id}}" loading="{{actingId === item.id}}"
        disabled="{{actingId !== null}}" bindtap="confirm">核对并确认</button>
    </view>
  </block>
</view>
