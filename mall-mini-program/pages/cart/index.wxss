.cart-page { min-height: 100vh; padding: 22rpx 22rpx calc(290rpx + env(safe-area-inset-bottom)); }
.cart-empty button { width: 240rpx; margin-top: 28rpx; }
.cart-row { position: relative; display: flex; align-items: center; margin-bottom: 18rpx; padding: 24rpx; border: 1rpx solid var(--line); border-radius: var(--radius); background: var(--paper); box-shadow: var(--shadow); }
.row-selector { display: flex; flex: none; align-items: center; justify-content: center; width: 58rpx; min-height: 88rpx; margin-right: 8rpx; }
.row-selector checkbox, .select-all checkbox { transform: scale(.82); transform-origin: center; }
.cart-row image { flex: none; width: 176rpx; height: 176rpx; border-radius: var(--radius); background: #eef0f3; }
.cart-copy { min-width: 0; flex: 1; margin-left: 18rpx; }
.cart-title { font-weight: 600; line-height: 38rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.spec { margin-top: 8rpx; font-size: 23rpx; }
.cart-line { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; justify-content: space-between; margin-top: 18rpx; color: var(--price); font-weight: 700; }
.counter { display: flex; align-items: center; color: #303846; }
.counter button { flex: none; width: 72rpx; height: 72rpx; min-height: 72rpx; line-height: 72rpx; margin: 0; padding: 0; border-radius: 12rpx; background: var(--canvas); color: var(--ink); }
.counter button[disabled] { opacity: .4; }
.counter text { width: 62rpx; text-align: center; }
.cart-item-actions { display: flex; justify-content: flex-end; margin-top: 16rpx; }
.cart-item-actions .remove { flex: none; width: auto; min-width: 112rpx; min-height: 72rpx; margin: 0; padding: 0 24rpx; border: 1rpx solid var(--line); border-radius: 999rpx; background: var(--paper); color: var(--muted); font-size: 24rpx; line-height: 70rpx; }
.cart-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 4; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: var(--paper); box-shadow: 0 -8rpx 30rpx rgba(20,30,50,.08); }
.select-all, .select-all label { display: flex; align-items: center; min-height: 72rpx; color: #4f5866; font-size: 25rpx; }
.select-all text { margin-left: 2rpx; }
.cart-total { margin-left: auto; margin-right: 18rpx; text-align: right; }
.cart-total > view { margin-top: 4rpx; font-weight: 600; }
.cart-total > view text { color: var(--price); font-size: 32rpx; }
.cart-footer button { width: 230rpx; height: 84rpx; margin: 0; line-height: 84rpx; }
.cart-footer { bottom: calc(112rpx + env(safe-area-inset-bottom)); padding-bottom: 18rpx; }
.cart-warning{font-size:24rpx;line-height:1.6;color:#b42318;margin-top:10rpx}
