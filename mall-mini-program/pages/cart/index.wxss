.cart-page { min-height: 100vh; padding: 22rpx 22rpx 160rpx; }
.cart-empty button { width: 240rpx; margin-top: 28rpx; }
.cart-row { position: relative; display: flex; align-items: center; margin-bottom: 18rpx; padding: 22rpx; border-radius: 24rpx; background: #fff; }
.check { flex: none; width: 42rpx; height: 42rpx; margin-right: 16rpx; border: 2rpx solid #ccd1da; border-radius: 50%; text-align: center; line-height: 40rpx; color: #fff; }
.check.checked { border-color: var(--brand); background: var(--brand); }
.cart-row image { flex: none; width: 176rpx; height: 176rpx; border-radius: 18rpx; background: #eef0f3; }
.cart-copy { min-width: 0; flex: 1; margin-left: 18rpx; }
.cart-title { font-weight: 600; line-height: 38rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.spec { margin-top: 8rpx; font-size: 23rpx; }
.cart-line { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; color: var(--brand); font-weight: 700; }
.counter { display: flex; align-items: center; color: #303846; }
.counter button { width: 54rpx; height: 48rpx; line-height: 48rpx; padding: 0; border-radius: 8rpx; background: #f2f3f6; }
.counter text { width: 58rpx; text-align: center; }
.remove { position: absolute; right: 14rpx; top: 10rpx; padding: 0 8rpx; background: transparent; color: #969daa; font-size: 22rpx; }
.cart-footer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 4; display: flex; align-items: center; justify-content: space-between; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -8rpx 30rpx rgba(20,30,50,.08); }
.select-all { display: flex; align-items: center; min-height: 72rpx; color: #4f5866; font-size: 25rpx; }
.select-all .check { margin-right: 10rpx; }
.cart-total { margin-left: auto; margin-right: 18rpx; text-align: right; }
.cart-total > view { margin-top: 4rpx; font-weight: 600; }
.cart-total > view text { color: var(--brand); font-size: 32rpx; }
.cart-footer button { width: 220rpx; margin: 0; }
