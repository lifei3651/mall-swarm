.login-page { min-height: 100vh; padding: 150rpx 52rpx 80rpx; background: #fff; text-align: center; }
.login-mark { width: 132rpx; height: 132rpx; margin: 0 auto; border-radius: 36rpx; background: linear-gradient(145deg, #ff315b, #c90f31); color: #fff; font-size: 40rpx; font-weight: 800; line-height: 132rpx; box-shadow: 0 18rpx 44rpx rgba(231,25,63,.22); }
.login-title { margin-top: 42rpx; font-size: 44rpx; font-weight: 800; }
.login-subtitle { margin: 20rpx auto 46rpx; max-width: 590rpx; color: #808897; line-height: 44rpx; }
.invite-tip { margin-bottom: 30rpx; padding: 20rpx; border-radius: 18rpx; background: #fff5f6; color: var(--brand); }
.invite-tip text { display: block; margin-top: 6rpx; color: #8c6470; font-size: 22rpx; }
.login-button { height: 90rpx; margin-top: 20rpx; line-height: 90rpx; font-size: 29rpx; }
.agreement { display: flex; align-items: center; justify-content: center; margin-top: 36rpx; font-size: 23rpx; color: #7e8695; }
.agreement-check { width: 34rpx; height: 34rpx; margin-right: 10rpx; border: 2rpx solid #c8cdd5; border-radius: 8rpx; line-height: 32rpx; color: #fff; }
.agreement-check.checked { border-color: var(--brand); background: var(--brand); }
.privacy-link { color: var(--brand); }
.not-ready, .login-error { margin-top: 24rpx; color: #9a6670; font-size: 24rpx; }
.login-error { color: #d52a47; }
