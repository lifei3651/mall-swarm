.login-page { min-height: 100vh; padding: 58rpx 30rpx 64rpx; background: linear-gradient(180deg, #fff 0%, #faf7f8 42%, #f5f6f8 100%); text-align: center; }
.login-brand { padding: 0 18rpx; }
.login-mark { display: flex; align-items: center; justify-content: center; width: 120rpx; height: 120rpx; margin: 0 auto; border: 1rpx solid #f0dfe3; border-radius: 34rpx; background: #fff; box-shadow: 0 16rpx 42rpx rgba(35,42,56,.10); }
.login-mark image { width: 86rpx; height: 86rpx; }
.login-title { margin-top: 26rpx; font-size: 43rpx; font-weight: 800; letter-spacing: 1rpx; }
.login-subtitle { margin: 12rpx auto 0; max-width: 590rpx; color: #7a8290; font-size: 25rpx; line-height: 40rpx; }
.login-card { margin-top: 38rpx; padding: 34rpx 30rpx 30rpx; border: 1rpx solid #e8eaf0; border-radius: 30rpx; background: #fff; box-shadow: 0 16rpx 44rpx rgba(31,38,52,.07); text-align: left; }
.login-card-head text { display: block; }
.login-card-head text:first-child { color: var(--ink); font-size: 31rpx; font-weight: 750; }
.login-card-head text:last-child { margin-top: 8rpx; color: #8b93a1; font-size: 23rpx; }
.invite-tip { margin-bottom: 26rpx; padding: 20rpx; border-radius: 18rpx; background: #fff1f4; color: var(--brand); }
.invite-tip text { display: block; margin-top: 6rpx; color: #8c6470; font-size: 22rpx; }
.login-card .empty { padding: 70rpx 20rpx; }
.login-button { width: 100%; height: 94rpx; margin: 18rpx 0 0; line-height: 94rpx; font-size: 29rpx; text-align: center; }
.register-button { color: var(--brand); border-color: #f0cbd3; background: #fff9fa; }
.agreement { display: flex; align-items: center; justify-content: flex-start; min-height: 76rpx; margin-top: 18rpx; text-align: left; font-size: 24rpx; color: #687284; }
.agreement checkbox-group { display: flex; flex: none; align-items: center; margin-right: 6rpx; }
.agreement checkbox { transform: scale(.82); transform-origin: center; }
.privacy-link { color: var(--brand); }
.not-ready { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #f7f8fa; color: #7e8694; font-size: 23rpx; text-align: center; }
.agreement-hint { margin-top: 16rpx; color: #9a6670; font-size: 22rpx; text-align: center; }
.login-error { margin-top: 20rpx; padding: 18rpx 20rpx; border-radius: 16rpx; background: #fff1f4; font-size: 24rpx; text-align: left; }
.login-error { color: #d52a47; }
