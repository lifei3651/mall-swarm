.login-page { min-height: 100vh; padding: 82rpx 34rpx 64rpx; background: linear-gradient(180deg, #fff 0%, #f7f8fa 46%, #f5f6f8 100%); text-align: center; }
.login-brand { padding: 0 18rpx; }
.login-mark { display: flex; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; margin: 0 auto; border: 1rpx solid #f0dfe3; border-radius: 38rpx; background: #fff; box-shadow: 0 16rpx 42rpx rgba(35,42,56,.10); }
.login-mark image { width: 94rpx; height: 94rpx; }
.login-title { margin-top: 34rpx; font-size: 44rpx; font-weight: 800; }
.login-subtitle { margin: 16rpx auto 0; max-width: 590rpx; color: #687284; font-size: 26rpx; line-height: 44rpx; }
.login-card { margin-top: 48rpx; padding: 34rpx; border: 1rpx solid #e8eaf0; border-radius: 28rpx; background: #fff; box-shadow: var(--shadow); }
.invite-tip { margin-bottom: 26rpx; padding: 20rpx; border-radius: 18rpx; background: #fff1f4; color: var(--brand); }
.invite-tip text { display: block; margin-top: 6rpx; color: #8c6470; font-size: 22rpx; }
.login-card .empty { padding: 70rpx 20rpx; }
.login-button { width: 100%; height: 92rpx; margin: 18rpx 0 0; line-height: 92rpx; font-size: 29rpx; }
.login-button:first-of-type { margin-top: 0; }
.agreement { display: flex; align-items: center; justify-content: flex-start; min-height: 76rpx; margin-top: 20rpx; text-align: left; font-size: 24rpx; color: #687284; }
.agreement-check { flex: none; width: 38rpx; height: 38rpx; margin-right: 12rpx; border: 2rpx solid #bfc5cf; border-radius: 10rpx; line-height: 36rpx; color: #fff; text-align: center; }
.agreement-check.checked { border-color: var(--brand); background: var(--brand); }
.privacy-link { color: var(--brand); }
.not-ready, .login-error { margin-top: 24rpx; color: #9a6670; font-size: 24rpx; }
.login-error { color: #d52a47; }
