<view class="login-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view class="login-brand">
    <view class="login-mark"><image src="{{brandLogo && !logoFailed ? brandLogo : '/assets/lingqi-logo-mark.png'}}" binderror="logoError" mode="aspectFit" aria-hidden="true" /></view>
    <view class="login-title">商城账号登录</view>
  </view>
  <view class="login-card">
    <view wx:if="{{inviteCode}}" class="invite-tip">已识别邀请关系：{{inviteCode}}<text>仅首次注册时一次性绑定</text></view>
    <view wx:if="{{loading}}" class="empty">正在检查商城配置…</view>
    <block wx:else>
      <view class="agreement">
        <checkbox-group bindchange="agreementChange" class="agreement-control"><checkbox class="agreement-checkbox" value="agreed" checked="{{agreed}}" color="{{themeColor}}" aria-label="阅读并同意隐私保护说明" /></checkbox-group>
        <view class="agreement-copy"><text>我已阅读并同意</text><text class="privacy-link" bindtap="openAgreement">《用户服务协议》</text><text>和</text><text class="privacy-link" bindtap="openPrivacy">《隐私政策》</text></view>
      </view>
      <button class="primary-button login-button" loading="{{submitting}}" disabled="{{submitting || !enabled}}" bindtap="returningLogin">商城账号登录</button>
      <button wx:if="{{phoneEnabled}}" class="secondary-button login-button register-button" open-type="getPhoneNumber" loading="{{submitting}}" disabled="{{submitting || !enabled || !agreed}}" bindgetphonenumber="phoneLogin">首次使用，手机号快捷注册</button>
      <view wx:else class="not-ready">首次使用注册功能暂未开放</view>
      <view wx:if="{{error}}" class="login-error">{{error}}</view>
    </block>
  </view>
</view>
<privacy-consent id="privacy-consent" />
