.product-page { min-height: 100vh; padding: 18rpx 18rpx 168rpx; background: #f5f6f8; }
.hero-shell { position: relative; overflow: hidden; border-radius: 26rpx; background: #eceef2; box-shadow: var(--shadow); }
.hero { display: block; width: 100%; height: 640rpx; background: #eceef2; }
.hero.media-fallback image { width: 150rpx; height: 150rpx; }
.sold-out-badge { position: absolute; right: 20rpx; bottom: 20rpx; padding: 9rpx 18rpx; border-radius: 999rpx; background: rgba(30,37,50,.78); color: #fff; font-size: 22rpx; }
.detail-card { margin-top: 16rpx; padding: 28rpx; border: 1rpx solid rgba(229,232,238,.9); border-radius: 24rpx; background: var(--paper); box-shadow: var(--shadow); }
.price-row { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; }
.detail-price { color: var(--price); font-size: 44rpx; font-weight: 800; }
.detail-price text { margin-right: 3rpx; font-size: 28rpx; }
.stock-text { flex: none; color: #858d9b; font-size: 23rpx; }
.detail-title { margin-top: 16rpx; font-size: 34rpx; font-weight: 750; line-height: 48rpx; }
.detail-subtitle { margin-top: 10rpx; color: #687284; line-height: 40rpx; }
.panel-title { margin-bottom: 22rpx; font-weight: 750; }
.sku-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sku { padding: 14rpx 24rpx; border: 1rpx solid #e5e8ee; border-radius: 999rpx; background: #f7f8fa; }
.sku.active { border-color: var(--accent); color: var(--accent); background: var(--brand-soft); }
.sku.disabled { color: #aeb4be; text-decoration: line-through; background: #f1f2f4; }
.sku text { margin-left: 8rpx; font-size: 20rpx; text-decoration: none; }
.quantity-panel { display: flex; justify-content: space-between; align-items: center; }
.quantity-panel view { display: flex; align-items: center; }
.quantity-panel button { width: 68rpx; height: 60rpx; line-height: 60rpx; padding: 0; background: #f2f4f7; }
.quantity-panel view text { width: 78rpx; text-align: center; }
.service-panel > view { display: flex; flex-wrap: wrap; gap: 14rpx; }
.service-panel > view text { padding: 8rpx 14rpx; border-radius: 999rpx; color: var(--accent); background: var(--brand-soft); font-size: 22rpx; }
.service-panel > text { display: block; margin-top: 16rpx; color: #858d9b; font-size: 23rpx; }
.description text { color: #626b79; line-height: 48rpx; white-space: pre-wrap; }
.product-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; display: flex; align-items: center; gap: 14rpx; padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eceef2; background: var(--paper); box-shadow: 0 -8rpx 30rpx rgba(20,30,50,.08); }
.product-actions button { box-sizing: border-box; min-width: 0; margin: 0; height: 96rpx; min-height: 96rpx; line-height: 96rpx; padding: 0; font-size: 28rpx; }
.product-actions .cart-shortcut { flex: 0 0 108rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 108rpx; border-radius: 18rpx; background: var(--paper); color: var(--muted); line-height: 1; }
.cart-shortcut image { display: block; flex: none; width: 40rpx; height: 40rpx; }
.cart-shortcut text { display: block; flex: none; margin-top: 6rpx; font-size: 22rpx; line-height: 30rpx; }
.product-actions .add-cart-button { flex: 1 1 0%; width: 0; color: var(--accent); background: var(--brand-soft); border-radius: 999rpx; font-weight: 600; }
.product-actions .primary-button { flex: 1 1 0%; width: 0; }
.product-actions button[disabled] { color: #fff; background: #c9cdd4; }
.product-empty text { display: block; }
.product-empty text:first-child { color: var(--ink); font-size: 30rpx; font-weight: 700; }
.product-empty text:nth-child(2) { margin-top: 10rpx; font-size: 23rpx; }
.product-empty button { width: 220rpx; margin-top: 28rpx; font-size: 24rpx; }
.detail-image{display:block;width:100%;margin-top:16rpx}.description text,.detail-subtitle,.stock-text{color:var(--muted,#64748b)}.sku,.quantity-panel button{background:var(--canvas,#f5f6f8);color:var(--ink,#20242e)}.detail-card{border-color:var(--line,#e5e8ee);border-radius:var(--radius,24rpx)}
.sku-image{width:180rpx;height:180rpx;display:block;margin-bottom:18rpx}.sku-attribute{font-size:25rpx;color:var(--muted,#64748b);line-height:1.6;margin-bottom:10rpx}
.sku-selection-summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12rpx 20rpx; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.selected-spec-name { flex-basis: 100%; color: var(--ink); font-size: 26rpx; line-height: 38rpx; word-break: break-all; }
.selected-spec-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10rpx; color: var(--muted); font-size: 24rpx; }
.sku-unit-price { color: var(--price); font-size: 36rpx; font-weight: 750; }
.selected-spec-stock { margin-left: auto; color: var(--muted); font-size: 24rpx; }
