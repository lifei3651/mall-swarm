.product-page { min-height: 100vh; padding-bottom: 150rpx; background: #f5f6f8; }
.hero { width: 100%; height: 750rpx; background: #eceef2; }
.detail-card { margin-top: 16rpx; padding: 28rpx; background: #fff; }
.detail-price { color: var(--brand); font-size: 44rpx; font-weight: 800; }
.detail-title { margin-top: 16rpx; font-size: 34rpx; font-weight: 700; line-height: 48rpx; }
.detail-subtitle { margin-top: 12rpx; color: #7d8594; line-height: 40rpx; }
.panel-title { margin-bottom: 22rpx; font-weight: 700; }
.sku-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sku { padding: 14rpx 24rpx; border: 1rpx solid #e5e8ee; border-radius: 999rpx; background: #f7f8fa; }
.sku.active { border-color: var(--brand); color: var(--brand); background: #fff4f6; }
.quantity-panel { display: flex; justify-content: space-between; align-items: center; }
.quantity-panel view { display: flex; align-items: center; }
.quantity-panel button { width: 68rpx; height: 60rpx; line-height: 60rpx; padding: 0; background: #f2f4f7; }
.quantity-panel view text { width: 78rpx; text-align: center; }
.description text { color: #626b79; line-height: 48rpx; white-space: pre-wrap; }
.product-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; display: flex; gap: 16rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -8rpx 30rpx rgba(20,30,50,.08); }
.product-actions button { margin: 0; height: 82rpx; line-height: 82rpx; padding: 0; }
.cart-shortcut { width: 160rpx; background: #fff; border: 1rpx solid #dfe3ea; border-radius: 999rpx; }
.product-actions .primary-button { flex: 1; }
