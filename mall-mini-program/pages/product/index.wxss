.product-page { min-height: 100vh; padding: 24rpx 24rpx calc(184rpx + env(safe-area-inset-bottom)); background: var(--canvas); }
.hero-shell { position: relative; overflow: hidden; border-radius: 26rpx; background: #eceef2; box-shadow: var(--shadow); }
.hero { display: block; width: 100%; height: 640rpx; background: #eceef2; }
.hero.media-fallback image { width: 150rpx; height: 150rpx; }
.sold-out-badge { position: absolute; right: 20rpx; bottom: 20rpx; padding: 9rpx 18rpx; border-radius: 999rpx; background: rgba(30,37,50,.78); color: #fff; font-size: 22rpx; }
.detail-card { margin-top: 16rpx; padding: 28rpx; border: 1rpx solid rgba(229,232,238,.9); border-radius: 24rpx; background: var(--paper); box-shadow: var(--shadow); }
.price-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12rpx 20rpx; overflow-wrap: anywhere; }
.detail-price { color: var(--price); font-size: 44rpx; font-weight: 800; }
.detail-price text { margin-right: 3rpx; font-size: 28rpx; }
.stock-text { flex: none; color: #858d9b; font-size: 23rpx; }
.detail-title { margin-top: 16rpx; font-size: 34rpx; font-weight: 600; line-height: 48rpx; overflow-wrap: anywhere; }
.detail-subtitle { margin-top: 10rpx; color: #687284; line-height: 40rpx; }
.panel-title { margin-bottom: 22rpx; font-weight: 750; }
.sku-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sku { padding: 14rpx 24rpx; border: 1rpx solid #e5e8ee; border-radius: 999rpx; background: #f7f8fa; }
.sku.active { border-color: var(--accent); color: var(--accent); background: var(--brand-soft); }
.sku.disabled { color: #aeb4be; text-decoration: line-through; background: #f1f2f4; }
.sku text { margin-left: 8rpx; font-size: 20rpx; text-decoration: none; }
.quantity-panel { display: flex; justify-content: space-between; align-items: center; }
.quantity-panel view { display: flex; align-items: center; }
.quantity-panel button { width: 72rpx; height: 72rpx; line-height: 72rpx; margin: 0; padding: 0; border-radius: 12rpx; background: var(--canvas); }
.quantity-panel view text { width: 78rpx; text-align: center; }
.service-heading { color: var(--ink); font-size: 30rpx; font-weight: 600; line-height: 1.5; }
.service-caption { display: block; margin-top: 6rpx; color: var(--muted); font-size: 24rpx; line-height: 1.6; }
.service-list { margin-top: 22rpx; }
.service-item { display: flex; align-items: flex-start; gap: 20rpx; padding: 24rpx 0; }
.service-item-separated { border-top: 1rpx solid var(--line); }
.service-symbol { display: flex; align-items: center; justify-content: center; flex: none; width: 44rpx; height: 44rpx; border-radius: 50%; background: var(--brand-soft); color: var(--accent); }
.service-check { width: 13rpx; height: 21rpx; margin-top: -5rpx; border-right: 3rpx solid currentColor; border-bottom: 3rpx solid currentColor; transform: rotate(45deg); }
.service-content { flex: 1; min-width: 0; }
.service-title { display: block; color: var(--ink); font-size: 28rpx; font-weight: 600; line-height: 1.55; overflow-wrap: anywhere; word-break: break-all; }
.service-description { display: block; margin-top: 8rpx; color: var(--muted); font-size: 26rpx; line-height: 1.7; white-space: pre-wrap; overflow-wrap: anywhere; word-break: break-all; }
.description text { color: #626b79; line-height: 48rpx; white-space: pre-wrap; }
.product-actions { position: fixed; left: 0; right: 0; bottom: 0; z-index: 5; display: flex; align-items: center; gap: 14rpx; padding: 16rpx 22rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #eceef2; background: var(--paper); box-shadow: 0 -8rpx 30rpx rgba(20,30,50,.08); }
.product-actions button { box-sizing: border-box; min-width: 0; margin: 0; height: 96rpx; min-height: 96rpx; line-height: 96rpx; padding: 0; font-size: 28rpx; }
.product-actions .cart-shortcut { flex: 0 0 108rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 108rpx; border-radius: 18rpx; background: var(--paper); color: var(--muted); line-height: 1; }
.cart-shortcut image { display: block; flex: none; width: 40rpx; height: 40rpx; }
.cart-shortcut text { display: block; flex: none; margin-top: 6rpx; font-size: 22rpx; line-height: 30rpx; }
.product-actions .add-cart-button { flex: 1 1 0%; width: 0; color: var(--accent); background: var(--brand-soft); border-radius: 20rpx; font-weight: 600; }
.product-actions .primary-button { flex: 1 1 0%; width: 0; }
.product-actions button[disabled] { color: #fff; background: #c9cdd4; }
.product-empty text { display: block; }
.product-empty text:first-child { color: var(--ink); font-size: 30rpx; font-weight: 700; }
.product-empty text:nth-child(2) { margin-top: 10rpx; font-size: 23rpx; }
.product-empty button { width: 220rpx; margin-top: 28rpx; font-size: 24rpx; }
.detail-image{display:block;width:100%;margin-top:16rpx}.description text,.detail-subtitle,.stock-text{color:var(--muted,#64748b)}.sku,.quantity-panel button{background:var(--canvas,#f5f6f8);color:var(--ink,#20242e)}.detail-card{border-color:var(--line,#e5e8ee);border-radius:var(--radius,24rpx)}
.sku-image{width:180rpx;height:180rpx;display:block;margin-bottom:18rpx}.sku-attribute{font-size:25rpx;color:var(--muted,#64748b);line-height:1.6;margin-bottom:10rpx}
.sku-selection-summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12rpx 20rpx; margin-top: 24rpx; padding-top: 22rpx; border-top: 1rpx solid var(--line); }
.selected-spec-name { flex-basis: 100%; color: var(--ink); font-size: 26rpx; line-height: 38rpx; word-break: break-all; }
.selected-spec-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10rpx; color: var(--muted); font-size: 24rpx; }
.sku-unit-price { color: var(--price); font-size: 36rpx; font-weight: 750; }
.selected-spec-stock { margin-left: auto; color: var(--muted); font-size: 24rpx; }
/* Follow H5 ProductDetailView's full-width sections, not oversized floating cards. */
.product-page { padding: 0 0 calc(150rpx + env(safe-area-inset-bottom)); }
.hero-shell { border-radius: 0; box-shadow: none; background: var(--paper); }
.hero { height: 750rpx; background: var(--paper); }
.gallery-image { display: block; width: 100%; height: 100%; }
.product-share-button { position: absolute; z-index: 2; top: 24rpx; right: 28rpx; display: flex; align-items: center; justify-content: center; width: 88rpx; height: 88rpx; min-height: 0; margin: 0; padding: 0; line-height: 1; border: 0; border-radius: 50%; background: rgba(255,255,255,.92); box-shadow: 0 2rpx 12rpx rgba(0,0,0,.08); }
.product-share-icon { width: 40rpx; height: 40rpx; background: url("data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22%23303640%22%20stroke-width%3D%221.8%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Cpath%20d%3D%22m8.6%2010.5%206.8-4M8.6%2013.5l6.8%204%22%2F%3E%3Ccircle%20cx%3D%2218%22%20cy%3D%225%22%20r%3D%223%22%2F%3E%3Ccircle%20cx%3D%226%22%20cy%3D%2212%22%20r%3D%223%22%2F%3E%3Ccircle%20cx%3D%2218%22%20cy%3D%2219%22%20r%3D%223%22%2F%3E%3C%2Fsvg%3E") center / contain no-repeat; }
.product-share-button[disabled] { background: rgba(255,255,255,.92); opacity: .55; }
.product-share-pressed { opacity: .7; }
.product-share-error { position: absolute; top: 0; right: 0; width: 28rpx; height: 28rpx; line-height: 28rpx; border-radius: 50%; background: #c62828; color: #fff; font-size: 22rpx; text-align: center; }
.image-count { position: absolute; right: 28rpx; bottom: 24rpx; min-width: 84rpx; padding: 10rpx 18rpx; color: #fff; background: rgba(28,28,28,.58); border-radius: 999rpx; font-size: 24rpx; text-align: center; }
.sold-out-badge { bottom: 84rpx; }
.detail-card { border: 0; border-radius: 0; box-shadow: none; padding: 28rpx; }
.detail-price { font-size: 64rpx; }
.market-price { color: var(--muted); text-decoration: line-through; font-size: 24rpx; }
.sales-count { margin-left: auto; color: var(--muted); font-size: 24rpx; }
.delivery-panel > view { display: flex; gap: 24rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.delivery-panel > view > text { flex: none; width: 64rpx; color: var(--muted); }
.delivery-panel > view > view { flex: 1; min-width: 0; }
.delivery-panel > view > view > text { display: block; margin-top: 10rpx; color: var(--muted); font-size: 24rpx; }
.sku { border-radius: 12rpx; }
.quantity-panel { flex-wrap: wrap; gap: 16rpx; }
.quantity-panel input { width: 116rpx; height: 72rpx; min-width: 0; border-top: 1rpx solid var(--line); border-bottom: 1rpx solid var(--line); text-align: center; font-size: 28rpx; }
.quantity-panel .quantity-stock { width: 100%; text-align: right; color: var(--muted); font-size: 24rpx; }
.product-actions { gap: 10rpx; padding-left: 14rpx; padding-right: 14rpx; }
.product-actions .cart-shortcut { position: relative; flex-basis: 88rpx; width: 88rpx; }
.product-actions .add-cart-button, .product-actions .primary-button { border-radius: 999rpx; font-size: 26rpx; }
.product-actions .add-cart-button { color: #9b550e; background: #f8c27d; }
.cart-shortcut .cart-count { position: absolute; left: 50%; top: 0; margin: 0; padding: 0 8rpx; border-radius: 999rpx; background: var(--brand); color: #fff; font-size: 20rpx; }
.review-heading { display: flex; align-items: center; gap: 16rpx; justify-content: space-between; padding-bottom: 24rpx; border-bottom: 1rpx solid var(--line); }
.review-heading .panel-title { margin-bottom: 8rpx; }
.review-heading .muted, .review-heading .panel-title text { font-size: 24rpx; color: var(--muted); }
.review-heading button { flex: none; margin: 0; min-width: 134rpx; padding: 12rpx 20rpx; border: 1rpx solid var(--brand); border-radius: 999rpx; background: var(--paper); color: var(--brand); font-size: 25rpx; line-height: 40rpx; }
.rating-distribution { padding: 24rpx 0; }
.rating-bar { display: flex; align-items: center; gap: 16rpx; margin: 8rpx 0; font-size: 24rpx; color: var(--muted); }
.rating-bar > text { width: 56rpx; }
.rating-track { flex: 1; height: 14rpx; background: var(--line); border-radius: 8rpx; overflow: hidden; }
.rating-track > view { height: 100%; background: var(--brand); }
.review-editor { padding: 24rpx; margin: 24rpx 0; background: var(--canvas); border-radius: 16rpx; }
.rating-options { display: flex; gap: 8rpx; margin: 16rpx 0; }
.rating-options button { flex: 1; margin: 0; padding: 8rpx; font-size: 24rpx; background: var(--paper); border: 1rpx solid var(--line); }
.rating-options .rating-selected { border-color: var(--brand); color: var(--brand); background: var(--brand-soft); }
.review-editor textarea { width: 100%; min-height: 210rpx; padding: 20rpx; border: 1rpx solid var(--line); border-radius: 12rpx; background: var(--paper); }
.review-editor > .muted { display: block; text-align: right; padding: 12rpx 0; font-size: 24rpx; }
.review-item { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.review-user { display: flex; align-items: center; gap: 16rpx; }
.review-user image { width: 68rpx; height: 68rpx; border-radius: 50%; background: var(--canvas); }
.review-user > view { flex: 1; min-width: 0; }
.review-user > view text { display: block; margin-top: 6rpx; color: var(--brand); font-size: 24rpx; }
.review-user > text { color: var(--muted); font-size: 22rpx; }
.review-content { display: block; padding-top: 20rpx; line-height: 1.75; white-space: pre-wrap; overflow-wrap: anywhere; }
.review-state { display: block; text-align: center; padding: 40rpx 0; color: var(--muted); font-size: 26rpx; }
.review-error { padding: 20rpx 0; color: #b42318; }
