<view class="product-page">
  <view wx:if="{{loading}}" class="empty">正在加载商品…</view>
  <view wx:elif="{{error}}" class="empty">{{error}}</view>
  <block wx:else>
    <image class="hero" src="{{product.coverUrl}}" mode="aspectFill" />
    <view class="detail-card">
      <view class="detail-price">¥{{product.priceText}}</view>
      <view class="detail-title">{{product.productName}}</view>
      <view class="detail-subtitle">{{product.subtitle}}</view>
    </view>
    <view wx:if="{{skus.length}}" class="detail-card sku-panel">
      <view class="panel-title">选择规格</view>
      <view class="sku-list">
        <view class="sku {{skuIndex === index ? 'active' : ''}}" wx:for="{{skus}}" wx:key="id" data-index="{{index}}" bindtap="selectSku">{{item.skuName || item.specName || '默认规格'}}</view>
      </view>
    </view>
    <view class="detail-card quantity-panel"><text>购买数量</text><view><button data-delta="-1" bindtap="changeQuantity">−</button><text>{{quantity}}</text><button data-delta="1" bindtap="changeQuantity">＋</button></view></view>
    <view class="detail-card description"><view class="panel-title">商品介绍</view><text>{{product.description || '商品详情由商家配置后展示。'}}</text></view>
    <view class="product-actions">
      <button class="cart-shortcut" bindtap="goCart">购物车</button>
      <button class="primary-button" bindtap="addToCart">加入购物车</button>
    </view>
  </block>
</view>
