<page-meta page-style="{{servicesVisible ? 'overflow:hidden' : ''}}" />
<view class="product-page product-layout-{{productLayout}}" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{loading}}" class="empty">正在加载商品…</view>
  <view wx:elif="{{error}}" class="empty product-empty"><text>商品加载失败</text><text>{{error}}</text><button class="secondary-button" bindtap="retry">重新加载</button></view>
  <block wx:else>
    <view class="hero-shell">
      <view wx:if="{{!product.gallery.length || product.imageFailed}}" class="hero media-fallback"><image src="/assets/lingqi-logo-mark.png" mode="aspectFit" /></view>
      <swiper wx:else class="hero" style="height: {{galleryHeight * (productLayout === 'inset' ? 686 / 750 : 1)}}rpx" bindchange="galleryChanged"><swiper-item wx:for="{{product.gallery}}" wx:key="*this"><image class="gallery-image" src="{{item}}" data-src="{{item}}" mode="aspectFit" bindload="galleryImageLoaded" binderror="productImageError" /></swiper-item></swiper>
      <text class="image-count">{{galleryIndex + 1}}/{{product.gallery.length || 1}}</text>
      <button wx:if="{{shareReady}}" class="product-share-button" open-type="share" aria-label="分享商品" hover-class="product-share-pressed"><view class="product-share-icon" aria-hidden="true" /></button>
      <button wx:else class="product-share-button" bindtap="retryShare" disabled="{{!shareError}}" aria-label="{{shareError ? '分享暂不可用，点击重试' : '正在准备分享'}}" hover-class="product-share-pressed"><view class="product-share-icon" aria-hidden="true" /><text wx:if="{{shareError}}" class="product-share-error">!</text></button>
      <text wx:if="{{soldOut}}" class="sold-out-badge">暂时缺货</text>
    </view>
    <view class="detail-card">
      <view class="price-row"><view class="detail-price"><text>¥</text>{{priceText}}</view><text wx:if="{{marketPrice > (selectedSku.salePrice == null ? product.salePrice : selectedSku.salePrice)}}" class="market-price">¥{{marketPriceText}}</text><text class="sales-count">已售 {{product.salesCount || 0}}+</text></view>
      <view class="detail-title">{{product.productName}}</view>
      <view wx:if="{{product.subtitle}}" class="detail-subtitle">{{product.subtitle}}</view>
      <view wx:if="{{product.purchaseLimit > 0}}" class="detail-subtitle">每位会员限购 {{product.purchaseLimit}} 件，不同规格合并计算；加购及结算时核对剩余额度</view>
    </view>
    <view class="detail-card delivery-panel"><view><text>发货</text><view>{{product.deliveryAddress || '商家仓库'}}<text>{{product.deliveryTime || '付款后尽快发货'}}</text></view></view><view><text>运费</text><view>{{freightLabel}}</view></view></view>
    <view wx:if="{{skus.length}}" class="detail-card sku-panel">
      <view class="panel-title">选择规格</view>
      <image wx:if="{{selectedSku.imageUrl}}" class="sku-image" src="{{selectedSku.imageUrl}}" mode="aspectFit" />
      <view wx:for="{{selectedSku.attributes}}" wx:key="name" class="sku-attribute">{{item.name}}：{{item.value}}</view>
      <view class="sku-list">
        <view class="sku {{skuIndex === index ? 'active' : ''}} {{item.stock <= 0 ? 'disabled' : ''}}" wx:for="{{skus}}" wx:key="id" data-index="{{index}}" bindtap="selectSku" aria-role="button" aria-label="{{item.skuName || item.specName || '默认规格'}}，{{item.stock <= 0 ? '缺货' : skuIndex === index ? '已选中' : '点击选择'}}">{{item.skuName || item.specName || '默认规格'}}<text wx:if="{{item.stock <= 0}}">缺货</text></view>
      </view>
      <view class="sku-selection-summary">
        <text class="selected-spec-name">已选：{{selectedSku.skuName || selectedSku.specName || '默认规格'}}</text>
        <view class="selected-spec-price"><text>单价</text><text class="sku-unit-price">¥{{priceText}}</text></view>
        <text class="selected-spec-stock">{{soldOut ? '暂时缺货' : '库存 ' + stock + ' 件'}}</text>
      </view>
    </view>
    <view class="detail-card quantity-panel"><text>购买数量</text><view><button data-delta="-1" bindtap="changeQuantity" disabled="{{quantity <= 1 || purchasePending || soldOut}}" aria-label="减少购买数量">−</button><input value="{{quantityInput}}" type="number" maxlength="10" bindinput="quantityChanged" bindblur="commitQuantity" disabled="{{purchasePending || soldOut}}" aria-label="手动输入购买数量" /><button data-delta="1" bindtap="changeQuantity" disabled="{{quantity >= maxQuantity || purchasePending || soldOut}}" aria-label="增加购买数量">＋</button></view><text class="quantity-stock">库存 {{stock}} 件</text></view>
    <view wx:if="{{product.serviceTags.length}}" class="detail-card service-panel">
      <view class="service-summary-row" bindtap="openServices" aria-role="button" aria-expanded="{{servicesVisible}}" aria-label="查看全部服务保障：{{serviceSummary}}">
        <text class="service-label">服务保障</text><text class="service-summary">{{serviceSummary}}</text><text class="service-arrow" aria-hidden="true">›</text>
      </view>
    </view>
    <view class="detail-card review-panel">
      <view class="review-heading"><view><view class="panel-title">商品评价 <text>({{reviewSummary.reviewCount || 0}})</text></view><text class="muted">{{reviewSummary.reviewCount ? '综合评分 ' + reviewSummary.averageRating + ' / 5' : '暂无评价'}}</text></view></view>
      <view wx:if="{{reviewSummary.reviewCount}}" class="rating-distribution"><view wx:for="{{ratingDistribution}}" wx:key="star" class="rating-bar"><text>{{item.star}}星</text><view class="rating-track"><view style="width:{{item.percent}}%"></view></view><text>{{item.count}}</text></view></view>
      <view wx:if="{{reviewError}}" class="review-error"><text>{{reviewError}}</text><button bindtap="loadReviews">重新加载评价</button></view>
      <view wx:for="{{reviews}}" wx:key="id" class="review-item">
        <view class="review-user"><image src="{{item.reviewerAvatar || '/assets/profile/user-round.png'}}" mode="aspectFill" /><view>{{item.reviewerName}}<text>{{item.rating}}星</text></view><text>{{item.dateText}}</text></view>
        <text class="review-content">{{item.content}}</text>
        <view wx:if="{{item.merchantReply || item.platformReply}}" class="review-replies">
          <view wx:if="{{item.merchantReply}}" class="review-reply">
            <view class="reply-heading"><text>商家回复</text><text class="reply-date">{{item.merchantReplyDate}}</text></view>
            <text class="reply-content">{{item.merchantReply}}</text>
          </view>
          <view wx:if="{{item.platformReply}}" class="review-reply">
            <view class="reply-heading"><text>平台回复</text><text class="reply-date">{{item.platformReplyDate}}</text></view>
            <text class="reply-content">{{item.platformReply}}</text>
          </view>
        </view>
      </view>
      <text wx:if="{{reviewLoading}}" class="review-state">正在加载评价…</text><text wx:elif="{{!reviews.length && !reviewError}}" class="review-state">暂时还没有商品评价</text>
      <button wx:if="{{reviews.length < reviewTotal}}" class="secondary-button" bindtap="loadMoreReviews" disabled="{{reviewLoading}}">查看更多评价</button>
    </view>
    <view class="detail-card description"><view class="panel-title">商品介绍</view><text>{{product.description || (!product.detailImages.length ? '商家暂未上传图文介绍' : '')}}</text><image wx:for="{{product.detailImages}}" wx:key="*this" class="detail-image" src="{{item}}" mode="widthFix" lazy-load /></view>
    <view wx:if="{{product.afterSalePolicy}}" class="detail-card description"><view class="panel-title">本商品售后说明</view><text>{{product.afterSalePolicy}}</text></view>
    <view class="product-actions">
      <button class="cart-shortcut" bindtap="goHome" aria-label="返回首页"><image src="/assets/tabbar/home.png" mode="aspectFit" /><text>首页</text></button>
      <button class="cart-shortcut" bindtap="goCart" aria-label="查看购物车，{{cartCount}}件"><image src="/assets/tabbar/cart.png" mode="aspectFit" /><text wx:if="{{cartCount}}" class="cart-count">{{cartCount > 99 ? '99+' : cartCount}}</text><text>购物车</text></button>
      <button class="add-cart-button" disabled="{{soldOut || purchasePending}}" loading="{{purchasePending}}" bindtap="addToCart">加入购物车</button>
      <button class="primary-button" disabled="{{soldOut || purchasePending}}" bindtap="buyNow">{{soldOut ? '暂时缺货' : purchasePending ? '正在核对' : '立即购买'}}</button>
    </view>
  </block>
  <view wx:if="{{servicesVisible || servicesOpening}}" class="service-overlay {{servicesVisible ? '' : 'service-measuring'}}">
    <view class="service-backdrop" bindtap="closeServices" catchtouchmove="stopServiceEvent" />
    <view class="service-sheet" role="dialog" aria-modal="true" aria-label="服务保障" catchtap="stopServiceEvent">
      <view class="service-sheet-header" catchtouchmove="stopServiceEvent"><text class="service-heading">服务保障</text><button class="service-close" bindtap="closeServices" aria-label="关闭服务保障" hover-class="none">×</button></view>
      <scroll-view class="service-scroll" style="height: {{serviceScrollHeight}}" scroll-y enhanced show-scrollbar="{{false}}">
        <view class="service-scroll-body">
          <text class="service-caption">具体服务以本商品说明和商城规则为准</text>
          <view class="service-list">
            <view wx:for="{{product.serviceTags}}" wx:key="index" class="service-item {{index > 0 ? 'service-item-separated' : ''}}">
              <view class="service-symbol" aria-hidden="true"><view class="service-check"></view></view>
              <view class="service-content"><text class="service-title">{{item.title}}</text><text wx:if="{{item.description}}" class="service-description">{{item.description}}</text></view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
