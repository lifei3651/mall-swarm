.legal-page { padding-bottom: 64rpx; }
.legal-content { padding: 32rpx; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 28rpx; line-height: 1.8; }
.legal-menu button { display: flex; justify-content: space-between; width: 100%; margin: 0; padding: 28rpx; border-bottom: 1rpx solid var(--line); color: var(--ink); background: var(--paper); font-size: 28rpx; text-align: left; }
.legal-menu button text, .info > text:first-child { color: var(--muted); font-size: 24rpx; }
.info { margin-bottom: 28rpx; }
.info text { display: block; }
.license-image { width: 100%; }
.faq { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.question { font-weight: 600; margin-bottom: 16rpx; }
