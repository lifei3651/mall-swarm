.legal-page { padding-bottom: calc(64rpx + env(safe-area-inset-bottom)); }
.legal-content + .legal-content { margin-top: 20rpx; }
.legal-menu { overflow: hidden; }
.legal-menu button:last-child { border-bottom: 0; }
.legal-content { padding: 32rpx; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 28rpx; line-height: 1.8; }
.legal-menu button { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; min-height: 96rpx; margin: 0; padding: 28rpx; border-bottom: 1rpx solid var(--line); color: var(--ink); background: var(--paper); font-size: 28rpx; line-height: 40rpx; text-align: left; }
.legal-menu button text, .info > text:first-child { color: var(--muted); font-size: 24rpx; }
.info { margin-bottom: 28rpx; }
.info text { display: block; }
.license-image { width: 100%; }
.faq { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.question { font-weight: 600; margin-bottom: 16rpx; }
.contact-actions { padding: 0 28rpx; margin-bottom: 24rpx; }
.legal-page .contact-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; box-sizing: border-box; width: 100%; min-width: 0; min-height: 100rpx; margin: 0; padding: 24rpx 0; border-radius: 0; border-bottom: 1rpx solid var(--line); background: transparent; color: var(--ink); font-size: 28rpx; font-weight: 400; line-height: 40rpx; text-align: left; white-space: normal; }
.contact-row:last-child { border-bottom: 0; }
.contact-row > view { flex: 1; min-width: 0; }
.contact-row image { flex: none; width: 28rpx; height: 28rpx; opacity: .5; }
.contact-caption { display: block; color: var(--muted); font-size: 23rpx; line-height: 36rpx; overflow-wrap: anywhere; }
.contact-note, .contact-error { display: block; padding: 22rpx 0; }
.contact-error { color: #b42318; font-size: 23rpx; line-height: 36rpx; }
.legal-page .contact-action { flex: none; width: auto; min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 24rpx 0 24rpx 16rpx; color: var(--brand); background: transparent; border-radius: 0; font-size: 25rpx; line-height: 40rpx; }
