<view class="address-page">
  <view wx:if="{{loading}}" class="empty">正在加载地址…</view>
  <view wx:else class="address-list">
    <view class="address-row" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="choose">
      <view><text>{{item.receiverName}}</text><text>{{item.receiverPhone}}</text><text wx:if="{{item.isDefault === 1}}" class="default-tag">默认</text></view>
      <text>{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</text>
      <view class="address-actions"><button data-id="{{item.id}}" catchtap="edit">编辑</button><button data-id="{{item.id}}" catchtap="remove">删除</button></view>
    </view>
  </view>
  <view class="address-form">
    <view class="form-head"><view class="form-title">{{form.id ? '编辑收货地址' : '新增收货地址'}}</view><button wx:if="{{form.id}}" bindtap="cancelEdit">取消编辑</button></view>
    <input data-field="receiverName" value="{{form.receiverName}}" maxlength="30" placeholder="收货人" bindinput="input" />
    <input data-field="receiverPhone" value="{{form.receiverPhone}}" maxlength="11" type="number" placeholder="手机号" bindinput="input" />
    <picker mode="region" value="{{form.region}}" bindchange="region"><view class="region">{{form.regionText || '请选择省、市、区/县'}}</view></picker>
    <input data-field="detailAddress" value="{{form.detailAddress}}" maxlength="200" placeholder="街道、门牌号等详细地址" bindinput="input" />
    <view class="default-setting"><view><text>设为默认地址</text><text>结算时优先使用</text></view><switch checked="{{form.isDefault}}" color="#e7193f" bindchange="defaultChange" /></view>
    <button class="primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="save">{{form.id ? '保存修改' : '保存地址'}}</button>
  </view>
</view>
