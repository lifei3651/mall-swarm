<view class="address-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view class="address-toolbar">
    <view>
      <text>{{selectMode ? '选择收货地址' : '收货地址'}}</text>
      <text wx:if="{{rows.length}}">共 {{rows.length}} 个地址</text>
      <text wx:else>完善地址后即可结算</text>
    </view>
    <button wx:if="{{!showForm}}" bindtap="startAdd">新增地址</button>
  </view>
  <button class="secondary-button wechat-import" bindtap="importWechatAddress" loading="{{importing}}" disabled="{{loading || saving || importing || loadError}}">从微信导入收货地址</button>
  <view wx:if="{{importMessage}}" class="import-message">{{importMessage}}</view>
  <view wx:if="{{loading}}" class="empty">正在加载地址…</view>
  <view wx:elif="{{loadError}}" class="address-empty-state"><text>{{loadError}}</text><button bindtap="load">重新加载</button></view>
  <view wx:elif="{{rows.length}}" class="address-list">
    <view class="address-row" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="choose">
      <view><text>{{item.receiverName}}</text><text>{{item.receiverPhone}}</text><text wx:if="{{item.isDefault === 1}}" class="default-tag">默认</text></view>
      <text>{{item.province}}{{item.city}}{{item.district}}{{item.detailAddress}}</text>
      <view class="address-actions"><button data-id="{{item.id}}" catchtap="edit">编辑</button><button data-id="{{item.id}}" catchtap="remove">删除</button></view>
    </view>
  </view>
  <view wx:else class="address-empty-state"><text>还没有收货地址</text><text>新增后可在结算时直接选择</text></view>
  <view wx:if="{{showForm}}" class="address-form">
    <view class="form-head"><view><view class="form-title">{{form.id ? '编辑收货地址' : '新增收货地址'}}</view><text>请填写真实有效的收货信息</text></view><button wx:if="{{rows.length}}" bindtap="cancelEdit">取消</button></view>
    <text class="field-label">收货人</text>
    <input data-field="receiverName" value="{{form.receiverName}}" maxlength="30" placeholder="请输入收货人姓名" aria-label="收货人姓名" bindinput="input" />
    <text class="field-label">联系电话</text>
    <input data-field="receiverPhone" value="{{form.receiverPhone}}" maxlength="11" type="number" placeholder="请输入11位手机号" aria-label="收货人联系电话" bindinput="input" />
    <text class="field-label">所在地区</text>
    <picker mode="region" value="{{form.region}}" bindchange="region" aria-label="选择省市区"><view class="region {{form.regionText ? '' : 'region-placeholder'}}"><text>{{form.regionText || '请选择省、市、区/县'}}</text><image src="/assets/profile/chevron-right.png" aria-hidden="true" /></view></picker>
    <text class="field-label">详细地址</text>
    <textarea class="detail-input" auto-height data-field="detailAddress" value="{{form.detailAddress}}" maxlength="200" placeholder="街道、楼栋、门牌号等" aria-label="收货详细地址" bindinput="input" />
    <view class="default-setting"><view><text>设为默认地址</text><text>结算时优先使用</text></view><switch checked="{{form.isDefault}}" color="{{themeColor}}" bindchange="defaultChange" /></view>
    <button class="primary-button" loading="{{saving}}" disabled="{{saving || loading || loadError}}" bindtap="save">{{form.id ? '保存修改' : '保存地址'}}</button>
  </view>
</view>
<privacy-consent id="privacy-consent" />
