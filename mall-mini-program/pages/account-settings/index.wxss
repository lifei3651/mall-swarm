@import '../account-security/index.wxss';
.security-status { padding: 34rpx; border: 1rpx solid #fed7aa; border-radius: 30rpx; background: #fff6e8; color: #9a3412; }.security-status.ready { color: #0f6e50; background: #ecf9f4; border-color: #bce9d7; }.security-status > view { font-size: 30rpx; font-weight: 600; }.security-status > text { display: block; margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; }
.security-page .security-entry { display: flex; align-items: center; gap: 22rpx; width: 100%; max-width: 100%; min-width: 0; padding: 32rpx; margin: 20rpx 0 0; border-radius: 22rpx; background: var(--paper); color: var(--ink); text-align: left; font-size: 29rpx; line-height: 1.5; }.security-entry > text:first-child { flex: 1; min-width: 0; }.security-entry image { width: 32rpx; height: 32rpx; flex: none; }.status-tag { font-size: 22rpx; color: var(--muted); }
.identity-consent { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 32rpx; color: var(--muted); font-size: 24rpx; line-height: 1.65; }.identity-consent checkbox { flex: none; transform: scale(.78); transform-origin: top left; width: 38rpx; }.privacy-link { color: var(--brand); }.identity-note { margin-top: 24rpx; }.warning { display: block; padding: 20rpx; margin: 20rpx 0; border-radius: 18rpx; background: #fff8e8; color: #b45309; font-size: 24rpx; line-height: 1.6; }
