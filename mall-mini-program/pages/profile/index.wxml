<view class="profile-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}">
  <view class="profile-card">
    <view class="profile-main">
      <view class="avatar">
        <text wx:if="{{loggedIn}}">会</text>
        <image wx:else src="/assets/lingqi-logo-mark.png" mode="aspectFit" />
      </view>
      <view class="profile-copy" wx:if="{{loggedIn}}"><view>{{member.nickname || '商城会员'}}</view><text>{{member.phone || ''}}</text></view>
      <view class="profile-copy" wx:else><view>欢迎来到商城</view><text>登录当前商城账号继续使用</text></view>
    </view>
    <button wx:if="{{!loggedIn}}" class="login-small" bindtap="login">商城账号登录</button>
  </view>
  <view class="section-label">我的订单</view>
  <view class="order-panel card">
    <view class="order-panel-head" bindtap="orders"><text>订单中心</text><text>查看全部订单 ›</text></view>
    <view class="order-shortcuts">
      <button data-tab="pending-payment" bindtap="orderTab"><text wx:if="{{orderSummary.pendingPayment}}" class="shortcut-count">{{orderSummary.pendingPayment > 99 ? '99+' : orderSummary.pendingPayment}}</text><text>待支付</text></button>
      <button data-tab="pending-shipment" bindtap="orderTab"><text wx:if="{{orderSummary.pendingShipment}}" class="shortcut-count">{{orderSummary.pendingShipment > 99 ? '99+' : orderSummary.pendingShipment}}</text><text>待发货</text></button>
      <button data-tab="pending-receipt" bindtap="orderTab"><text wx:if="{{orderSummary.pendingReceipt}}" class="shortcut-count">{{orderSummary.pendingReceipt > 99 ? '99+' : orderSummary.pendingReceipt}}</text><text>待收货</text></button>
      <button data-tab="after-sale" bindtap="orderTab"><text wx:if="{{orderSummary.afterSale}}" class="shortcut-count">{{orderSummary.afterSale > 99 ? '99+' : orderSummary.afterSale}}</text><text>退款 / 售后</text></button>
    </view>
  </view>
  <view class="section-label">常用服务</view>
  <view class="menu card">
    <view bindtap="messages"><text>消息与提醒 <text wx:if="{{unreadCount}}" class="unread-badge">{{unreadText}}</text></text><text>›</text></view>
    <view bindtap="addresses"><text>收货地址</text><text>›</text></view>
    <view wx:if="{{payoutCount}}" bindtap="payout"><text>微信收款确认 <text class="unread-badge">{{payoutCount > 99 ? '99+' : payoutCount}}</text></text><text>›</text></view>
    <button class="contact-row" open-type="contact" show-message-card><text>在线客服</text><text>›</text></button>
  </view>
  <view class="section-label">购物保障</view>
  <view class="compliance card"><view>安心购物</view><text>本端仅提供商品浏览、购物车、订单和售后服务；经营主体、隐私政策与支付资料均由当前商城独立配置。</text></view>
  <button wx:if="{{loggedIn}}" class="secondary-button logout" bindtap="logout">退出登录</button>
</view>
