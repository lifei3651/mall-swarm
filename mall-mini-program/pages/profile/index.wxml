<page-meta page-style="{{loginVisible ? 'overflow:hidden' : ''}}" />
<view class="profile-page" aria-hidden="{{loginVisible}}" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <button class="profile-header" bindtap="accountEntry" hover-class="row-pressed" aria-label="{{loggedIn ? '编辑头像、昵称和个人资料' : '商城账号登录'}}">
    <view class="avatar {{loggedIn && avatarSrc !== '/assets/profile/user-round.png' ? 'avatar-loaded' : ''}}"><image src="{{avatarSrc}}" mode="aspectFill" aria-hidden="true" /></view>
    <view class="profile-copy">
      <text class="profile-name">{{loggedIn ? (member.nickname || '商城账号') : '商城账号登录'}}</text>
      <text wx:if="{{loggedIn}}" class="profile-subtitle">商城账号：{{member.username && member.username !== member.phone ? member.username : '尚未设置'}}</text>
      <text wx:if="{{loggedIn && capabilities.ready && capabilities.membershipActive}}" class="membership-badge level-{{capabilities.membershipLevel}}">{{capabilities.membershipLabel}}</text>
    </view>
    <image class="account-arrow" src="/assets/profile/chevron-right.png" mode="aspectFit" aria-hidden="true" />
  </button>
  <view class="order-panel card">
    <view class="panel-head">
      <text class="panel-title">我的订单</text>
      <button class="all-orders" bindtap="orders" aria-label="查看全部订单" hover-class="row-pressed"><text>全部订单</text><image src="/assets/profile/chevron-right.png" aria-hidden="true" /></button>
    </view>
    <view class="order-shortcuts">
      <button data-tab="pending-payment" bindtap="orderTab" aria-label="查看待支付订单" hover-class="row-pressed">
        <view class="shortcut-icon"><image src="/assets/profile/credit-card.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{loggedIn && orderSummary.pendingPayment}}" class="shortcut-count">{{orderSummary.pendingPayment > 99 ? '99+' : orderSummary.pendingPayment}}</text></view>
        <text class="shortcut-name">待支付</text>
      </button>
      <button data-tab="pending-shipment" bindtap="orderTab" aria-label="查看待发货订单" hover-class="row-pressed">
        <view class="shortcut-icon"><image src="/assets/profile/package.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{loggedIn && orderSummary.pendingShipment}}" class="shortcut-count">{{orderSummary.pendingShipment > 99 ? '99+' : orderSummary.pendingShipment}}</text></view>
        <text class="shortcut-name">待发货</text>
      </button>
      <button data-tab="pending-receipt" bindtap="orderTab" aria-label="查看待收货订单" hover-class="row-pressed">
        <view class="shortcut-icon"><image src="/assets/profile/truck.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{loggedIn && orderSummary.pendingReceipt}}" class="shortcut-count">{{orderSummary.pendingReceipt > 99 ? '99+' : orderSummary.pendingReceipt}}</text></view>
        <text class="shortcut-name">待收货</text>
      </button>
      <button data-tab="pending-review" bindtap="orderTab" aria-label="查看待评价订单" hover-class="row-pressed">
        <view class="shortcut-icon"><image src="/assets/profile/message-square-text.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{loggedIn && orderSummary.pendingReview}}" class="shortcut-count">{{orderSummary.pendingReview > 99 ? '99+' : orderSummary.pendingReview}}</text></view>
        <text class="shortcut-name">待评价</text>
      </button>
      <button data-tab="after-sale" bindtap="orderTab" aria-label="查看退款和售后订单" hover-class="row-pressed">
        <view class="shortcut-icon"><image src="/assets/profile/rotate-ccw.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{loggedIn && orderSummary.afterSale}}" class="shortcut-count">{{orderSummary.afterSale > 99 ? '99+' : orderSummary.afterSale}}</text></view>
        <text class="shortcut-name">退款售后</text>
      </button>
    </view>
  </view>
  <view class="menu card">
    <view class="panel-head"><text class="panel-title">常用服务</text></view>
    <view class="service-grid">
      <button wx:if="{{loggedIn}}" class="service-tile" bindtap="wallet" aria-label="查看余额和提现" hover-class="row-pressed"><view class="tile-icon wallet-icon tone-purple"><image src="/assets/profile/wallet-white.png" mode="aspectFit" /></view><text>余额</text></button>
      <button class="service-tile" bindtap="messages" aria-label="查看消息与提醒" hover-class="row-pressed"><view class="tile-icon tone-orange"><image src="/assets/profile/bell-white.png" mode="aspectFit" /><text wx:if="{{loggedIn && unreadCount}}" class="tile-badge">{{unreadText}}</text></view><text>消息提醒</text></button>
      <button class="service-tile" bindtap="addresses" aria-label="管理收货地址" hover-class="row-pressed"><view class="tile-icon tone-blue"><image src="/assets/profile/map-pin-white.png" mode="aspectFit" /></view><text>收货地址</text></button>
      <button class="service-tile" bindtap="coupons" aria-label="查看与领取优惠券" hover-class="row-pressed"><view class="tile-icon tone-orange"><text>券</text></view><text>优惠券</text></button>
      <button class="service-tile" open-type="contact" show-message-card aria-label="联系在线客服" hover-class="row-pressed"><view class="tile-icon tone-green"><image src="/assets/profile/headset-white.png" mode="aspectFit" /></view><text>在线客服</text></button>
      <button class="service-tile" bindtap="support" aria-label="查看和提交客服工单" hover-class="row-pressed"><view class="tile-icon tone-blue"><image src="/assets/profile/headset-white.png" mode="aspectFit" /></view><text>客服工单</text></button>
      <button wx:if="{{loggedIn}}" class="service-tile" bindtap="security" hover-class="row-pressed"><view class="tile-icon tone-blue"><image src="/assets/profile/user-round-white.png" mode="aspectFit" /></view><text>账号安全</text></button>
      <button wx:if="{{loggedIn && capabilities.canInvite}}" class="service-tile invite-tile" open-type="{{shareReady ? 'share' : ''}}" disabled="{{!shareReady || loginVisible}}" aria-label="{{shareReady ? '分享商城邀请好友' : '正在核对邀请资格'}}" hover-class="row-pressed"><view class="tile-icon tone-orange"><image src="/assets/profile/user-round-plus-white.png" mode="aspectFit" /></view><text>邀请好友</text></button>
      <button wx:if="{{loggedIn && payoutCount}}" class="service-tile" bindtap="payout" aria-label="确认微信提现收款" hover-class="row-pressed"><view class="tile-icon tone-purple"><image src="/assets/profile/credit-card-white.png" mode="aspectFit" /><text class="tile-badge">{{payoutCount > 99 ? '99+' : payoutCount}}</text></view><text>收款确认</text></button>
    </view>
    <button wx:if="{{loggedIn && canOpenStudio}}" class="share-retry" bindtap="studio">主播工作台</button>
    <button wx:if="{{loggedIn && shareError}}" class="share-retry" bindtap="retryShare">邀请服务暂不可用，点击重试</button>
  </view>
  <button class="legal-link" bindtap="legal">用户协议 · 隐私政策 · 商城资质</button>
  <button class="legal-link" bindtap="checkUpdate">检查版本更新</button>
  <button wx:if="{{loggedIn}}" class="logout" bindtap="logout" hover-class="row-pressed">退出登录</button>
</view>
<login-sheet id="login-sheet" bindsuccess="authorized" bindclose="loginClosed" />
<privacy-consent id="privacy-consent" />
