<page-meta page-style="{{loginVisible ? 'overflow:hidden' : ''}}" />
<view class="profile-page" aria-hidden="{{loginVisible}}" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <button class="profile-header" bindtap="accountEntry" hover-class="row-pressed" aria-label="{{loggedIn ? '编辑头像、昵称和个人资料' : '商城账号登录'}}">
    <view class="avatar {{loggedIn && avatarSrc !== '/assets/profile/user-round.png' ? 'avatar-loaded' : ''}}"><image src="{{avatarSrc}}" mode="aspectFill" aria-hidden="true" /></view>
    <view class="profile-copy">
      <text class="profile-name">{{loggedIn ? (member.nickname || '商城账号') : '商城账号登录'}}</text>
      <text wx:if="{{loggedIn}}" class="profile-subtitle">个人资料</text>
      <text wx:if="{{loggedIn && capabilities.ready}}" class="profile-subtitle">{{capabilities.membershipActive ? '会员服务已开通' : '购物账号'}}</text>
    </view>
    <image class="account-arrow" src="/assets/profile/chevron-right.png" mode="aspectFit" aria-hidden="true" />
  </button>
  <view class="order-panel card">
    <view class="panel-head">
      <text class="panel-title">我的订单</text>
      <button class="all-orders" bindtap="orders" aria-label="查看全部订单" hover-class="row-pressed"><text>全部订单</text><image src="/assets/profile/chevron-right.png" aria-hidden="true" /></button>
    </view>
    <view class="order-shortcuts">
      <button data-tab="pending-payment" bindtap="orderTab" aria-label="查看待支付订单" hover-class="row-pressed">
        <view class="shortcut-icon"><image src="/assets/profile/credit-card.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{loggedIn && orderSummary.pendingPayment}}" class="shortcut-count">{{orderSummary.pendingPayment > 99 ? '99+' : orderSummary.pendingPayment}}</text></view>
        <text class="shortcut-name">待支付</text>
      </button>
      <button data-tab="pending-shipment" bindtap="orderTab" aria-label="查看待发货订单" hover-class="row-pressed">
        <view class="shortcut-icon"><image src="/assets/profile/package.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{loggedIn && orderSummary.pendingShipment}}" class="shortcut-count">{{orderSummary.pendingShipment > 99 ? '99+' : orderSummary.pendingShipment}}</text></view>
        <text class="shortcut-name">待发货</text>
      </button>
      <button data-tab="pending-receipt" bindtap="orderTab" aria-label="查看待收货订单" hover-class="row-pressed">
        <view class="shortcut-icon"><image src="/assets/profile/truck.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{loggedIn && orderSummary.pendingReceipt}}" class="shortcut-count">{{orderSummary.pendingReceipt > 99 ? '99+' : orderSummary.pendingReceipt}}</text></view>
        <text class="shortcut-name">待收货</text>
      </button>
      <button data-tab="after-sale" bindtap="orderTab" aria-label="查看退款和售后订单" hover-class="row-pressed">
        <view class="shortcut-icon"><image src="/assets/profile/rotate-ccw.png" mode="aspectFit" aria-hidden="true" /><text wx:if="{{loggedIn && orderSummary.afterSale}}" class="shortcut-count">{{orderSummary.afterSale > 99 ? '99+' : orderSummary.afterSale}}</text></view>
        <text class="shortcut-name">退款售后</text>
      </button>
    </view>
  </view>
  <view class="menu card">
    <view class="panel-head"><text class="panel-title">常用服务</text></view>
    <button wx:if="{{loggedIn && capabilities.canInvite && shareReady}}" class="menu-row" open-type="share" aria-label="分享商城邀请好友"><image class="service-icon" src="/assets/profile/user-round.png" mode="aspectFit" aria-hidden="true" /><text class="menu-name">邀请好友</text><image class="menu-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" /></button>
    <button wx:if="{{loggedIn && shareError}}" class="menu-row" bindtap="retryShare"><text class="menu-name">{{shareError}}</text></button>
    <button wx:if="{{loggedIn}}" class="menu-row" bindtap="wallet" aria-label="查看钱包和完整提现记录"><image class="service-icon" src="/assets/profile/credit-card.png" mode="aspectFit" aria-hidden="true" /><text class="menu-label">钱包与到账</text><image class="menu-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" /></button>
    <button class="menu-row" bindtap="messages" aria-label="查看消息与提醒" hover-class="row-pressed">
      <image class="service-icon" src="/assets/profile/bell.png" mode="aspectFit" aria-hidden="true" /><text class="menu-name">消息与提醒</text>
      <text wx:if="{{loggedIn && unreadCount}}" class="unread-badge">{{unreadText}}</text><image class="menu-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" />
    </button>
    <button class="menu-row" bindtap="addresses" aria-label="管理收货地址" hover-class="row-pressed">
      <image class="service-icon" src="/assets/profile/map-pin.png" mode="aspectFit" aria-hidden="true" /><text class="menu-name">收货地址</text><image class="menu-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" />
    </button>
    <button class="menu-row" wx:if="{{loggedIn && payoutCount}}" bindtap="payout" aria-label="确认微信提现收款" hover-class="row-pressed">
      <image class="service-icon" src="/assets/profile/wallet.png" mode="aspectFit" aria-hidden="true" /><text class="menu-name">微信收款确认</text>
      <text class="unread-badge">{{payoutCount > 99 ? '99+' : payoutCount}}</text><image class="menu-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" />
    </button>
    <button wx:if="{{loggedIn}}" class="menu-row" bindtap="security" aria-label="管理账号与密码" hover-class="row-pressed">
      <image class="service-icon" src="/assets/profile/user-round.png" mode="aspectFit" aria-hidden="true" /><text class="menu-name">账号与安全</text><image class="menu-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" />
    </button>
    <button class="menu-row contact-row" open-type="contact" show-message-card aria-label="联系在线客服" hover-class="row-pressed">
      <image class="service-icon" src="/assets/profile/headset.png" mode="aspectFit" aria-hidden="true" /><text class="menu-name">在线客服</text><image class="menu-arrow" src="/assets/profile/chevron-right.png" aria-hidden="true" />
    </button>
  </view>
  <button class="legal-link" bindtap="legal">用户协议 · 隐私政策 · 商城资质</button>
  <button wx:if="{{loggedIn}}" class="logout" bindtap="logout" hover-class="row-pressed">退出登录</button>
</view>
<login-sheet id="login-sheet" bindsuccess="authorized" bindclose="loginClosed" />
<privacy-consent id="privacy-consent" />
