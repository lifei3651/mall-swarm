.profile-page { min-height: 100vh; padding: 32rpx 24rpx; }
.profile-card { display: flex; align-items: center; padding: 36rpx 28rpx; border-radius: 28rpx; background: linear-gradient(135deg, #232a38, #3d4555); color: #fff; }
.avatar { flex: none; width: 106rpx; height: 106rpx; border-radius: 50%; background: rgba(255,255,255,.18); text-align: center; line-height: 106rpx; font-size: 38rpx; }
.profile-copy { min-width: 0; flex: 1; margin-left: 24rpx; }
.profile-copy view { font-size: 34rpx; font-weight: 700; }
.profile-copy text { display: block; margin-top: 10rpx; color: rgba(255,255,255,.65); font-size: 24rpx; }
.login-small { width: 164rpx; margin: 0; padding: 0; border-radius: 999rpx; background: #fff; color: #252c39; font-size: 25rpx; }
.menu { margin-top: 24rpx; padding: 0 24rpx; }
.menu view { display: flex; justify-content: space-between; padding: 30rpx 4rpx; border-bottom: 1rpx solid #edf0f4; }
.menu view:last-child { border-bottom: 0; }
.menu view text:last-child { color: #adb3be; font-size: 38rpx; }
.compliance { margin-top: 24rpx; padding: 28rpx; }
.compliance view { font-weight: 700; }
.compliance text { display: block; margin-top: 14rpx; color: #858d9b; line-height: 42rpx; font-size: 24rpx; }
.logout { margin-top: 42rpx; }
