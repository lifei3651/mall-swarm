.profile-page { min-height: 100vh; padding: 12rpx 32rpx calc(144rpx + env(safe-area-inset-bottom)); }
.profile-page .profile-header { position:relative; display:block; overflow:hidden; width:100%; min-height:272rpx; margin:8rpx 0 24rpx; padding:30rpx 28rpx 0; border-radius:28rpx; background:linear-gradient(135deg,#65758a,#344154); box-shadow:0 18rpx 42rpx rgba(31,41,55,.16); color:#fff; text-align:left; }
.profile-page .profile-header.level-1 { background:linear-gradient(135deg,#c68a4f,#6f431f); }.profile-page .profile-header.level-2 { background:linear-gradient(135deg,#21a8ba,#155976); }.profile-page .profile-header.level-3 { background:linear-gradient(135deg,#22a773,#086149); }.profile-page .profile-header.level-4 { background:linear-gradient(135deg,#6678e7,#2d3d97); }.profile-page .profile-header.level-5 { background:linear-gradient(135deg,#dca72f,#8b5a08); }.profile-page .profile-header.level-6 { background:linear-gradient(135deg,#9567ee,#5030a5); }.profile-page .profile-header.level-7 { background:linear-gradient(135deg,#e86687,#962044); }.profile-page .profile-header.level-8 { background:linear-gradient(135deg,#303846,#090c12); }
.profile-header-pressed { opacity:.94; transform:scale(.995); }
.identity-orbit { position:absolute; border:28rpx solid rgba(255,255,255,.08); border-radius:50%; pointer-events:none; }.orbit-one { width:260rpx; height:260rpx; right:-104rpx; top:-138rpx; }.orbit-two { width:110rpx; height:110rpx; right:42rpx; top:18rpx; border-width:16rpx; opacity:.55; }
.profile-main { position:relative; z-index:1; display:flex; align-items:center; gap:22rpx; }
.avatar { display:flex; flex:none; align-items:center; justify-content:center; width:100rpx; height:100rpx; overflow:hidden; border:3rpx solid rgba(255,255,255,.5); border-radius:50%; background:rgba(255,255,255,.18); }
.avatar image { display:block; width:52rpx; height:52rpx; opacity:.86; filter:brightness(0) invert(1); }
.avatar-loaded { overflow: hidden; }
.avatar-loaded image { width:100%; height:100%; opacity:1; filter:none; }
.account-arrow { flex:none; width:28rpx; height:28rpx; margin-left:8rpx; opacity:.82; filter:brightness(0) invert(1); }
.profile-copy { flex: 1; min-width: 0; }
.profile-kicker { display:block; margin-bottom:3rpx; color:rgba(255,255,255,.68); font-size:19rpx; font-weight:600; letter-spacing:2rpx; line-height:30rpx; }
.profile-name { display:block; overflow:hidden; color:#fff; font-size:35rpx; font-weight:700; line-height:48rpx; white-space:nowrap; text-overflow:ellipsis; }
.profile-subtitle { display:block; margin-top:3rpx; overflow:hidden; color:rgba(255,255,255,.74); font-size:21rpx; line-height:32rpx; white-space:nowrap; text-overflow:ellipsis; }
.membership-panel { position:relative; z-index:1; display:grid; grid-template-columns:56rpx minmax(0,1fr) auto; align-items:center; gap:14rpx; min-height:94rpx; margin-top:25rpx; padding:16rpx 2rpx 18rpx; border-top:1rpx solid rgba(255,255,255,.22); }
.membership-emblem { display:flex; align-items:center; justify-content:center; width:52rpx; height:52rpx; border:1rpx solid rgba(255,255,255,.32); border-radius:16rpx; background:rgba(255,255,255,.16); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.2); }.membership-emblem text { color:#fff1bd; font-size:28rpx; line-height:1; }
.membership-copy { min-width:0; }.membership-caption,.membership-title { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.membership-caption { color:rgba(255,255,255,.58); font-size:16rpx; font-weight:700; letter-spacing:2rpx; line-height:24rpx; }.membership-title { margin-top:2rpx; color:#fff; font-size:25rpx; font-weight:700; line-height:34rpx; }.membership-action { flex:none; color:rgba(255,255,255,.78); font-size:21rpx; line-height:32rpx; }.guest-panel .membership-emblem text { color:#fff; }
.profile-page .card { overflow: hidden; border: 0; border-radius: var(--radius); box-shadow: none; }
.panel-head { display: flex; align-items: center; justify-content: space-between; min-height: 90rpx; padding: 12rpx 28rpx; }
.panel-title { color: var(--ink); font-size: 30rpx; font-weight: 600; line-height: 44rpx; }
.order-panel .panel-head { margin: 0 28rpx; padding-left: 0; padding-right: 0; border-bottom: 1rpx solid var(--line); }
.profile-page .all-orders { display: flex; align-items: center; justify-content: flex-end; min-height: 72rpx; margin: 0 -12rpx 0 12rpx; padding: 12rpx; background: transparent; color: var(--muted); font-size: 23rpx; font-weight: 400; line-height: 36rpx; border-radius: 12rpx; }
.all-orders image { width: 24rpx; height: 24rpx; margin-left: 6rpx; opacity: .5; }
.order-shortcuts { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); padding: 6rpx 12rpx 24rpx; }
.order-shortcuts button { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; max-width: 100%; min-width: 0; min-height: 126rpx; margin: 0; padding: 12rpx 2rpx; border: 0; border-radius: 16rpx; background: transparent; color: var(--ink); line-height: 1.4; }
.shortcut-icon { position: relative; width: 54rpx; height: 54rpx; margin-bottom: 14rpx; }
.shortcut-icon image { display: block; width: 100%; height: 100%; }
.shortcut-name { display: block; font-size: 24rpx; font-weight: 400; line-height: 36rpx; white-space: nowrap; }
.shortcut-count { position: absolute; top: -12rpx; left: 36rpx; z-index: 1; min-width: 32rpx; height: 32rpx; padding: 0 7rpx; border: 2rpx solid var(--paper); border-radius: 999rpx; background: var(--accent); color: #fff; font-size: 19rpx; line-height: 28rpx; text-align: center; }
.menu { margin-top: 24rpx; padding: 0 28rpx 4rpx; background: var(--paper); }
.menu .panel-head { padding: 12rpx 0; }
.profile-page .menu-row { display: flex; align-items: center; width: 100%; min-height: 104rpx; margin: 0; padding: 20rpx 0; border-radius: 0; border-bottom: 1rpx solid var(--line); background: transparent; color: var(--ink); text-align: left; line-height: 40rpx; }
.profile-page .menu-row:last-child { border-bottom: 0; }
.service-icon { flex: none; width: 38rpx; height: 38rpx; margin-right: 22rpx; opacity: .8; }
.menu-name { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 400; overflow-wrap: anywhere; }
.menu-arrow { flex: none; width: 28rpx; height: 28rpx; margin-left: 16rpx; opacity: .4; }
.unread-badge { flex: none; min-width: 34rpx; padding: 0 10rpx; margin-left: 12rpx; border-radius: 999rpx; background: var(--accent); color: #fff; font-size: 21rpx; line-height: 34rpx; text-align: center; }
.profile-page .logout { width: 100%; min-height: 96rpx; margin-top: 28rpx; padding: 24rpx; border-radius: var(--radius); background: #fde8ed; color: #a7163a; font-size: 26rpx; font-weight: 600; line-height: 40rpx; }
.profile-page .logout.logout-pressed { background: #fad3dc; }
.profile-page .row-pressed { background: var(--brand-soft); }
.profile-page .button-pressed { opacity: .8; }
.profile-page .legal-link { width: 100%; margin-top: 24rpx; padding: 20rpx 0; color: var(--muted); background: transparent; font-size: 23rpx; line-height: 36rpx; font-weight: 400; }
.service-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 10rpx 8rpx; padding: 0 0 20rpx; }
.profile-page .service-tile { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: 142rpx; margin: 0; padding: 14rpx 0; border-radius: 16rpx; background: transparent; color: var(--ink); font-size: 23rpx; font-weight: 400; line-height: 34rpx; }
.profile-page .invite-tile[disabled] { background:transparent; color:var(--ink); opacity:1; }
.tile-icon { position: relative; display: flex; flex: none; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin-bottom: 12rpx; border-radius: 18rpx; }
.tile-icon image { display: block; width: 38rpx; height: 38rpx; }
.tone-purple { background: var(--brand); }
.tone-orange { background: #ff6248; }
.tone-blue { background: #4388f7; }
.tone-green { background: #23a981; }
.tile-badge { position: absolute; top: -8rpx; right: -12rpx; min-width: 28rpx; padding: 0 6rpx; border: 2rpx solid var(--paper); border-radius: 16rpx; background: #c73135; color: white; font-size: 18rpx; line-height: 28rpx; }
.profile-page .share-retry { margin: 0; padding: 14rpx; background: transparent; color: var(--muted); font-size: 23rpx; line-height: 36rpx; }
@media (max-width: 350px) {
  .profile-page { padding-left: 24rpx; padding-right: 24rpx; }
  .profile-page .profile-header { padding-left:22rpx; padding-right:22rpx; }
  .profile-main { gap:16rpx; }
  .avatar { width: 84rpx; height: 84rpx; }
  .profile-name { font-size: 34rpx; }
}
