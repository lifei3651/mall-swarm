.profile-page { min-height: 100vh; padding: 12rpx 32rpx calc(144rpx + env(safe-area-inset-bottom)); }
.profile-header { display: flex; align-items: center; min-height: 184rpx; padding: 24rpx 0 32rpx; gap: 20rpx; }
.avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 96rpx; height: 96rpx; border-radius: 50%; background: var(--paper); }
.avatar image { display: block; width: 52rpx; height: 52rpx; opacity: .7; }
.profile-copy { flex: 1; min-width: 0; }
.profile-name { display: block; overflow: hidden; color: var(--ink); font-size: 36rpx; font-weight: 600; line-height: 52rpx; white-space: nowrap; text-overflow: ellipsis; }
.profile-subtitle { display: block; margin-top: 4rpx; overflow: hidden; color: var(--muted); font-size: 23rpx; line-height: 34rpx; white-space: nowrap; text-overflow: ellipsis; }
.profile-page .login-small { flex: none; display: flex; align-items: center; justify-content: center; width: auto; min-height: 88rpx; margin: 0; padding: 16rpx 22rpx; border-radius: 18rpx; background: var(--button); color: #fff; font-size: 24rpx; font-weight: 500; line-height: 36rpx; box-shadow: none; }
.profile-page .card { overflow: hidden; border: 0; border-radius: var(--radius); box-shadow: none; }
.panel-head { display: flex; align-items: center; justify-content: space-between; min-height: 90rpx; padding: 12rpx 28rpx; }
.panel-title { color: var(--ink); font-size: 30rpx; font-weight: 600; line-height: 44rpx; }
.profile-page .all-orders { display: flex; align-items: center; justify-content: flex-end; min-height: 72rpx; margin: 0 -12rpx 0 12rpx; padding: 12rpx; background: transparent; color: var(--muted); font-size: 23rpx; font-weight: 400; line-height: 36rpx; border-radius: 12rpx; }
.all-orders image { width: 24rpx; height: 24rpx; margin-left: 6rpx; opacity: .5; }
.order-shortcuts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 6rpx 12rpx 24rpx; }
.order-shortcuts button { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 100%; max-width: 100%; min-width: 0; min-height: 126rpx; margin: 0; padding: 12rpx 2rpx; border: 0; border-radius: 16rpx; background: transparent; color: var(--ink); line-height: 1.4; }
.shortcut-icon { position: relative; width: 54rpx; height: 54rpx; margin-bottom: 14rpx; }
.shortcut-icon image { display: block; width: 100%; height: 100%; }
.shortcut-name { display: block; font-size: 24rpx; font-weight: 400; line-height: 36rpx; white-space: nowrap; }
.shortcut-count { position: absolute; top: -12rpx; left: 36rpx; z-index: 1; min-width: 32rpx; height: 32rpx; padding: 0 7rpx; border: 2rpx solid var(--paper); border-radius: 999rpx; background: var(--accent); color: #fff; font-size: 19rpx; line-height: 28rpx; text-align: center; }
.menu { margin-top: 24rpx; padding: 0 28rpx 4rpx; }
.menu .panel-head { padding: 12rpx 0; }
.profile-page .menu-row { display: flex; align-items: center; width: 100%; min-height: 104rpx; margin: 0; padding: 20rpx 0; border-radius: 0; border-bottom: 1rpx solid var(--line); background: transparent; color: var(--ink); text-align: left; line-height: 40rpx; }
.profile-page .menu-row:last-child { border-bottom: 0; }
.service-icon { flex: none; width: 38rpx; height: 38rpx; margin-right: 22rpx; opacity: .8; }
.menu-name { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 400; overflow-wrap: anywhere; }
.menu-arrow { flex: none; width: 28rpx; height: 28rpx; margin-left: 16rpx; opacity: .4; }
.unread-badge { flex: none; min-width: 34rpx; padding: 0 10rpx; margin-left: 12rpx; border-radius: 999rpx; background: var(--accent); color: #fff; font-size: 21rpx; line-height: 34rpx; text-align: center; }
.profile-page .logout { width: 100%; min-height: 96rpx; margin-top: 28rpx; padding: 24rpx; border-radius: var(--radius); background: var(--paper); color: var(--muted); font-size: 26rpx; font-weight: 400; line-height: 40rpx; }
.profile-page .row-pressed { background: var(--brand-soft); }
.profile-page .button-pressed { opacity: .8; }
@media (max-width: 350px) {
  .profile-page { padding-left: 24rpx; padding-right: 24rpx; }
  .profile-header { gap: 16rpx; }
  .avatar { width: 84rpx; height: 84rpx; }
  .profile-name { font-size: 34rpx; }
  .profile-page .login-small { padding-left: 16rpx; padding-right: 16rpx; }
}
