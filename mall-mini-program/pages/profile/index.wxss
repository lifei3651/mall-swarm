.profile-page { min-height: 100vh; padding: 32rpx 24rpx 52rpx; }
.profile-card { padding: 32rpx; border: 1rpx solid #f0dfe3; border-radius: 28rpx; background: linear-gradient(135deg, #fff 0%, #fff2f5 100%); box-shadow: var(--shadow); color: var(--ink); }
.profile-main { display: flex; align-items: center; }
.avatar { display: flex; flex: none; align-items: center; justify-content: center; width: 106rpx; height: 106rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(35,42,56,.08); color: var(--brand); font-size: 38rpx; font-weight: 750; }
.avatar image { width: 76rpx; height: 76rpx; }
.profile-copy { min-width: 0; flex: 1; margin-left: 24rpx; }
.profile-copy view { font-size: 36rpx; font-weight: 750; }
.profile-copy text { display: block; margin-top: 8rpx; color: #697386; font-size: 24rpx; }
.login-small { width: 100%; height: 82rpx; margin: 26rpx 0 0; padding: 0; border-radius: 999rpx; background: var(--brand); color: #fff; font-size: 27rpx; font-weight: 650; line-height: 82rpx; box-shadow: 0 10rpx 24rpx rgba(231,25,63,.16); }
.section-label { margin: 30rpx 8rpx 14rpx; color: #697386; font-size: 24rpx; font-weight: 650; }
.menu { padding: 0 24rpx; }
.menu > view { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; padding: 0 4rpx; border-bottom: 1rpx solid #edf0f4; }
.menu > view text:last-child { color: #9ca4b1; font-size: 36rpx; }
.menu .contact-row { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 96rpx; margin: 0; padding: 0 4rpx; color: var(--ink); text-align: left; background: transparent; border-radius: 0; font-size: 28rpx; line-height: 1; }
.menu .contact-row text:last-child { color: #9ca4b1; font-size: 36rpx; }
.menu .unread-badge { display: inline-block; min-width: 34rpx; height: 34rpx; margin-left: 10rpx; padding: 0 9rpx; border-radius: 999rpx; background: var(--brand); color: #fff; font-size: 20rpx; line-height: 34rpx; text-align: center; }
.compliance { padding: 28rpx; }
.compliance view { font-weight: 750; }
.compliance text { display: block; margin-top: 14rpx; color: #687284; line-height: 42rpx; font-size: 24rpx; }
.logout { margin-top: 42rpx; }
