<view class="coupons-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view class="coupon-tabs"><view class="{{tab === 'mine' ? 'active' : ''}}" data-tab="mine" bindtap="switchTab" aria-role="tab" aria-selected="{{tab === 'mine'}}">我的优惠券</view><view class="{{tab === 'catalog' ? 'active' : ''}}" data-tab="catalog" bindtap="switchTab" aria-role="tab" aria-selected="{{tab === 'catalog'}}">领券中心</view></view>
  <view wx:if="{{error}}" class="error"><text>{{error}}</text><view bindtap="load" aria-role="button">重新加载</view></view>
  <view wx:if="{{loading}}" class="empty">正在读取优惠券…</view>
  <view wx:elif="{{!rows.length && !error}}" class="empty">{{tab === 'mine' ? '还没有优惠券，去领券中心看看' : '暂无可领取优惠券'}}</view>
  <view class="coupon-card" wx:for="{{rows}}" wx:key="key">
    <view class="coupon-main"><view class="coupon-price"><text>¥{{item.amountText}}</text><text>{{item.minimumAmount > 0 ? '满 ¥' + item.minimumText + ' 可用' : '无门槛'}}</text></view><view class="coupon-copy"><text class="coupon-title">{{item.title}}</text><text>{{item.scopeLabel}}</text></view></view>
    <view class="coupon-meta"><text>{{item.startsText}} — {{item.endsText}}</text><text>{{item.businessText}} · 不与秒杀叠加</text></view>
    <view class="coupon-bottom"><view data-id="{{item.id}}" bindtap="showProducts" aria-role="button">适用商品 ›</view><button wx:if="{{tab === 'catalog'}}" class="claim-button" data-id="{{item.id}}" bindtap="claim" disabled="{{!item.usable || claiming !== ''}}">{{claiming === item.id ? '领取中…' : item.reason || '领取'}}</button><text wx:else>{{item.statusText}}</text></view>
    <text class="coupon-rule">{{item.refundRule === 'FULL_RETURN' ? '用券子单全部退款成功后退券，原有效期不变' : '支付后退款不退券'}}；部分退款不退券。</text>
  </view>
  <view class="pager"><button data-delta="-1" bindtap="turn" disabled="{{page <= 1 || loading}}">上一页</button><text>{{page}} / {{pages}}</text><button data-delta="1" bindtap="turn" disabled="{{page >= pages || loading}}">下一页</button></view>
  <view wx:if="{{productTarget}}" class="coupon-mask" catchtap="closeProducts" catchtouchmove="stopTap"><view class="coupon-sheet" catchtap="stopTap" aria-role="dialog" aria-label="适用商品"><view class="sheet-head"><text>适用商品</text><view bindtap="closeProducts" aria-role="button">关闭</view></view><text class="coupon-rule">{{productTarget.scopeLabel}}；购买时仍需满足金额、业务及有效期条件。</text><scroll-view scroll-y show-scrollbar="{{false}}" enhanced="{{true}}" class="product-list"><view wx:for="{{products}}" wx:key="id" class="product" data-id="{{item.id}}" bindtap="product"><image src="{{item.coverUrl}}" mode="aspectFill"/><text>{{item.productName}}</text><text>¥{{item.priceText}}</text></view><view wx:if="{{productsLoading}}" class="empty">正在读取…</view><view wx:elif="{{!products.length}}" class="empty">暂无上架的适用商品</view><view wx:if="{{productError}}" class="error" bindtap="loadProducts">{{productError}} · 重试</view><view wx:if="{{productPage < productPages}}" class="more" bindtap="loadProducts">更多商品</view></scroll-view></view></view>
</view>
