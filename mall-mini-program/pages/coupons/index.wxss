page{background:#f5f6f7}.coupons-page{padding:0 28rpx 60rpx}.coupon-tabs{display:flex;border-bottom:2rpx solid #e8e9eb;margin-bottom:28rpx}.coupon-tabs view{width:50%;box-sizing:border-box;text-align:center;font-size:30rpx;padding:28rpx 0;border-bottom:4rpx solid transparent;color:#747982}.coupon-tabs .active{color:var(--brand);border-bottom-color:var(--brand);font-weight:600}.coupon-card{background:#fff;border:2rpx solid #e8e9eb;border-radius:24rpx;padding:28rpx;margin:24rpx 0}.coupon-main{display:flex;gap:24rpx}.coupon-price{width:190rpx;flex-shrink:0;border-right:2rpx dashed #e4e6e8;display:flex;flex-direction:column;justify-content:center;gap:12rpx}.coupon-price text:first-child{font-size:46rpx;font-weight:650;color:var(--brand);overflow-wrap:anywhere}.coupon-price text:last-child{font-size:24rpx;color:#747982}.coupon-copy{min-width:0;flex:1}.coupon-copy text{display:block;font-size:23rpx;color:#858b94;line-height:1.7;margin-top:6rpx;overflow-wrap:anywhere}.coupon-copy .coupon-title{font-size:30rpx;font-weight:600;color:#242b35;margin-top:0}.coupon-bottom{display:flex;align-items:center;justify-content:space-between;border-top:2rpx solid #f1f2f3;margin-top:24rpx;padding-top:20rpx;font-size:26rpx;color:#747982}.coupon-bottom view{padding:12rpx 0}.claim-button{width:auto;min-width:130rpx;margin:0;padding:12rpx 26rpx;line-height:1.5;font-size:26rpx;border-radius:40rpx;color:#fff;background:var(--brand);font-weight:500}.claim-button[disabled]{background:#f1f2f3;color:#999}.coupon-rule{display:block;font-size:23rpx;color:#8c9198;line-height:1.7;margin-top:18rpx}.pager{display:flex;align-items:center;justify-content:center;gap:24rpx;font-size:26rpx;margin-top:40rpx}.pager button{width:auto;margin:0;line-height:1.5;font-size:26rpx;padding:16rpx 24rpx;background:#fff;border-radius:12rpx}.empty{text-align:center;color:#8c9198;font-size:28rpx;padding:60rpx 0}.error{font-size:26rpx;color:#bd243b;padding:20rpx 0}.coupon-mask{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:120;display:flex;align-items:flex-end}.coupon-sheet{box-sizing:border-box;width:100%;border-radius:32rpx 32rpx 0 0;background:#fff;padding:32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom))}.sheet-head{display:flex;justify-content:space-between;align-items:center;font-size:34rpx;font-weight:600}.sheet-head view{padding:16rpx 0 16rpx 24rpx;font-size:28rpx;font-weight:400}.product-list{height:52vh;margin-top:24rpx}.product{display:flex;gap:20rpx;align-items:center;padding:24rpx 0;border-bottom:2rpx solid #f1f2f3;font-size:28rpx}.product image{height:110rpx;width:110rpx;border-radius:16rpx;flex-shrink:0}.product text:nth-child(2){flex:1;min-width:0;overflow-wrap:anywhere}.product text:last-child{color:var(--brand)}.more{text-align:center;color:var(--brand);padding:24rpx;font-size:28rpx}
.coupon-meta{font-size:23rpx;line-height:1.7;color:#858b94;margin-top:22rpx}.coupon-meta text{display:block}.coupon-card .coupon-title{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}
