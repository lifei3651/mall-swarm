.detail-page { min-height: 100vh; padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); }
.detail-card { padding: 34rpx; border: 1rpx solid var(--line); border-radius: 26rpx; background: var(--paper); box-shadow: var(--shadow); }
.category { color: var(--accent); font-size: 23rpx; }
.title { margin-top: 14rpx; font-size: 34rpx; font-weight: 600; line-height: 48rpx; overflow-wrap: anywhere; }
.time { display: block; margin-top: 14rpx; color: #9ba2af; font-size: 22rpx; }
.content { display: block; margin-top: 28rpx; color: var(--ink); line-height: 48rpx; white-space: pre-wrap; overflow-wrap: anywhere; }
.detail-card button { margin-top: 42rpx; font-size: 26rpx; }
