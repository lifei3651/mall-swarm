@import '../../styles/support.wxss';
.ticket-title { margin:24rpx 0 12rpx; font-size:34rpx; font-weight:600; line-height:1.5; overflow-wrap:anywhere; }
.ticket-facts { border-top:1rpx solid var(--line); margin-top:26rpx; }.ticket-facts > view { display:flex; gap:20rpx; padding:20rpx 0; border-bottom:1rpx solid var(--line); font-size:25rpx; line-height:1.6; }.ticket-facts > view > text:first-child { flex:none; width:174rpx; color:var(--muted); }.ticket-facts > view > text:last-child { min-width:0; overflow-wrap:anywhere; }.ticket-facts button { padding:0; margin:0; min-width:0; background:transparent; font-size:25rpx; font-weight:400; color:var(--brand); line-height:1.6; overflow-wrap:anywhere; }.overdue { color:#b42318; }
.conversation { display:flex; flex-direction:column; gap:24rpx; padding:28rpx; }.reply { max-width:92%; padding:22rpx; background:var(--canvas); border-radius:24rpx; }.reply.member { align-self:flex-end; background:var(--brand-soft); }.reply.admin { align-self:flex-start; }.reply.system { align-self:center; color:var(--muted); }.reply > view { display:flex; justify-content:space-between; gap:20rpx; font-size:23rpx; }.reply > view text:last-child { color:var(--muted); font-size:21rpx; }.reply-content { display:block; margin-top:14rpx; font-size:27rpx; line-height:1.7; white-space:pre-wrap; overflow-wrap:anywhere; }.close-ticket { background:transparent; color:var(--muted); font-size:25rpx; margin:18rpx 0 0; padding:12rpx 0; width:100%; }
.support-page .ticket-facts button { flex:1; width:0; min-height:88rpx; text-align:left; }
