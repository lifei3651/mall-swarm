<view class="support-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <text wx:if="{{loading}}" class="support-empty">正在加载工单…</text>
  <view wx:if="{{ticket.id}}" class="support-card"><view class="section-head"><text class="eyebrow">{{ticket.typeText}}</text><text class="status-badge">{{ticket.statusText}}</text></view><view class="ticket-title">{{ticket.subject}}</view><text class="support-hint">{{ticket.nextActionHint}}</text><view class="ticket-facts"><view><text>工单编号</text><text selectable>{{ticket.ticketNo}}</text></view><view wx:if="{{ticket.orderNo}}"><text>关联订单</text><button bindtap="openOrder">{{ticket.orderNo}}</button></view><view wx:if="{{ticket.afterSaleNo}}"><text>关联售后</text><text>{{ticket.afterSaleNo}}</text></view><view><text>首次响应目标</text><text class="{{ticket.firstResponseOverdue ? 'overdue' : ''}}">{{ticket.deadlineText}}{{ticket.firstResponseOverdue ? '（已超时，优先处理）' : ''}}</text></view></view></view>
  <view wx:if="{{ticket.id}}" class="support-card conversation"><view wx:for="{{replies}}" wx:key="id" class="reply {{item.senderClass}}"><view><text>{{item.senderLabel}}</text><text>{{item.timeText}}</text></view><text class="reply-content">{{item.content}}</text></view></view>
  <view wx:if="{{ticket.id && ticket.status !== 'CLOSED'}}" class="support-card create-card"><textarea value="{{content}}" bindinput="input" maxlength="1000" disabled="{{submitting || closing}}" placeholder="补充问题或回复客服" aria-label="回复客服内容" /><text class="char-count">{{content.length}}/1000</text><text class="support-hint">请勿填写密码、短信验证码或银行卡号。</text><button class="primary-button" bindtap="reply" loading="{{submitting}}" disabled="{{submitting || closing || !content}}">发送回复</button><button class="close-ticket" bindtap="closeTicket" loading="{{closing}}" disabled="{{submitting || closing}}">问题已解决，关闭工单</button></view>
  <text wx:if="{{ticket.status === 'CLOSED'}}" class="support-empty">该工单已关闭；如有新的问题，请重新提交工单。</text><view wx:if="{{error}}" class="support-error"><text>{{error}}</text><button bindtap="load">重新加载</button></view>
</view>
