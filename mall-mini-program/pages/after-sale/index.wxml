<view class="after-sale-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{loading}}" class="empty">正在加载售后信息…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button class="secondary-button" bindtap="load">重新加载</button></view>
  <view wx:elif="{{submitted}}" class="panel"><text>售后申请已提交</text><button class="primary-button" bindtap="openOrder">查看售后进度</button></view>
  <view wx:elif="{{!allowed}}" class="panel"><text>{{unavailableReason}}</text><button class="secondary-button" bindtap="openOrder">返回订单</button></view>
  <block wx:else>
    <view class="panel">
      <view class="section-title">选择售后商品</view><text class="muted">订单号 {{orderNo}} · 不申请的商品请将数量调为0</text>
      <view class="product" wx:for="{{items}}" wx:key="id">
        <image class="product-cover" src="{{item.productCover}}" mode="aspectFill" />
        <view class="product-copy"><text class="product-name">{{item.productName}}</text><text class="muted">{{item.skuName || '默认规格'}}</text>
          <view wx:if="{{item.remaining > 0}}" class="quantity">
            <button class="quantity-button" data-id="{{item.id}}" data-delta="-1" bindtap="changeQuantity" disabled="{{submitting || item.selectedQuantity <= 0}}" aria-label="减少售后数量">−</button>
            <text>{{item.selectedQuantity}}</text>
            <button class="quantity-button" data-id="{{item.id}}" data-delta="1" bindtap="changeQuantity" disabled="{{submitting || item.selectedQuantity >= item.remaining}}" aria-label="增加售后数量">＋</button>
            <text class="muted">最多{{item.remaining}}件</text>
          </view>
          <text wx:else class="muted">已无可售后数量</text>
        </view>
      </view>
    </view>
    <view class="panel">
      <view class="section-title">售后类型</view>
      <view class="type-options">
        <button class="type-button {{applyType === 1 ? 'selected' : ''}}" data-type="1" bindtap="selectType" disabled="{{submitting}}">仅退款</button>
        <button class="type-button {{applyType === 2 ? 'selected' : ''}}" data-type="2" bindtap="selectType" disabled="{{submitting}}">退货退款</button>
        <button class="type-button {{applyType === 3 ? 'selected' : ''}}" data-type="3" bindtap="selectType" disabled="{{submitting || !canExchange}}">同规格换货</button>
      </view>
      <text class="muted">{{applyType === 3 ? '换货不退款，审核通过后按商家提供的地址寄回商品。' : '退款金额由服务器根据实际商品、优惠及运费规则计算，以审核结果为准。'}}</text>
    </view>
    <view class="panel">
      <view class="section-title">申请原因</view>
      <textarea class="reason-input" value="{{reason}}" maxlength="170" bindinput="reasonInput" disabled="{{submitting}}" placeholder="请说明需要退款或换货的原因（必填）" aria-label="售后申请原因" />
      <text class="counter">{{reason.length}}/170</text>
      <view class="section-title proof-title">图片凭证（选填）</view>
      <text class="muted">最多6张，每张不超过5MB；请勿上传身份证、银行卡等无关敏感信息。</text>
      <view class="proof-grid">
        <view class="proof-item" wx:for="{{proofs}}" wx:key="path"><image src="{{item.path}}" mode="aspectFill" /><button class="remove-proof" data-index="{{index}}" bindtap="removeProof" disabled="{{submitting}}" aria-label="移除此图片凭证">移除</button></view>
      </view>
      <button wx:if="{{proofs.length < 6}}" class="secondary-button" bindtap="chooseProof" disabled="{{submitting || selectingProof}}">选择图片</button>
    </view>
    <text wx:if="{{submitError}}" class="form-error">{{submitError}}</text>
    <button class="primary-button submit-button" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || selectingProof}}">{{submitting ? '正在提交，请稍候' : '提交售后申请'}}</button>
  </block>
</view>
