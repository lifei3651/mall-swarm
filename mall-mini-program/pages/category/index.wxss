.category-page { height: 100vh; display: flex; flex-direction: column; background: #fff; }
.category-search { margin: 18rpx 22rpx; height: 80rpx; display: flex; align-items: center; overflow: hidden; border: 1rpx solid #e5e8ed; background: #f7f8fa; border-radius: 22rpx; }
.category-search image { flex: none; width: 32rpx; height: 32rpx; margin-left: 24rpx; opacity: .72; }
.category-search input { flex: 1; height: 100%; padding: 0 16rpx; font-size: 26rpx; }
.category-search button { width: 118rpx; height: 80rpx; line-height: 80rpx; padding: 0; border-radius: 0; background: var(--brand); color: #fff; font-size: 26rpx; font-weight: 650; }
.category-body { min-height: 0; flex: 1; display: flex; border-top: 1rpx solid #edf0f3; }
.category-side { width: 184rpx; height: 100%; background: #f5f6f8; }
.side-item { min-height: 104rpx; padding: 32rpx 16rpx; overflow: hidden; text-align: center; white-space: nowrap; text-overflow: ellipsis; color: #555f70; font-size: 25rpx; }
.side-item.active { position: relative; background: #fff; color: var(--brand); font-weight: 750; }
.side-item.active::before { position: absolute; top: 28rpx; bottom: 28rpx; left: 0; width: 6rpx; border-radius: 0 999rpx 999rpx 0; background: var(--brand); content: ''; }
.category-products { flex: 1; height: 100%; padding: 18rpx; background: #fff; }
.result-head { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 2rpx 18rpx; }
.result-head text:first-child { font-size: 29rpx; font-weight: 750; }
.result-head text:last-child { color: var(--muted); font-size: 22rpx; }
.category-product-list { padding-bottom: 40rpx; }
.category-product-card { display: flex; min-height: 186rpx; margin-bottom: 16rpx; overflow: hidden; border: 1rpx solid #eceef2; border-radius: 20rpx; background: #fff; }
.category-product-card .product-cover { flex: none; width: 176rpx; height: 176rpx; margin: 5rpx; border-radius: 16rpx; }
.category-product-card .product-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; padding: 20rpx 18rpx 16rpx; }
.category-product-card .product-title { min-height: 0; line-height: 36rpx; font-size: 26rpx; font-weight: 650; -webkit-line-clamp: 2; }
.category-product-card .product-subtitle { margin-top: 8rpx; font-size: 22rpx; }
.category-product-card .product-price { margin-top: auto; font-size: 31rpx; }
