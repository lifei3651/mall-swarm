.category-page { height: 100vh; display: flex; flex-direction: column; background: var(--paper); }
.category-search { margin: 18rpx 22rpx; height: 80rpx; display: flex; align-items: center; overflow: hidden; border: 1rpx solid #e5e8ed; background: #f7f8fa; border-radius: 22rpx; }
.category-search image { flex: none; width: 32rpx; height: 32rpx; margin-left: 24rpx; opacity: .72; }
.category-search input { flex: 1; height: 100%; padding: 0 16rpx; font-size: 26rpx; }
.category-search button { flex: none; width: 118rpx; height: 80rpx; line-height: 80rpx; padding: 0; border-radius: 0; background: var(--button); color: #fff; font-size: 26rpx; font-weight: 650; }
.category-body { min-height: 0; flex: 1; display: flex; border-top: 1rpx solid #edf0f3; }
.category-side { width: 184rpx; height: 100%; background: #f5f6f8; }
.side-item { min-height: 104rpx; padding: 32rpx 16rpx; overflow: hidden; text-align: center; white-space: nowrap; text-overflow: ellipsis; color: #555f70; font-size: 25rpx; }
.side-item.active { position: relative; background: var(--paper); color: var(--accent); font-weight: 750; }
.side-item.active::before { position: absolute; top: 28rpx; bottom: 28rpx; left: 0; width: 6rpx; border-radius: 0 999rpx 999rpx 0; background: var(--brand); content: ''; }
.category-products { flex: 1; height: 100%; padding: 18rpx; background: var(--paper); }
.result-head { display: flex; align-items: center; justify-content: space-between; padding: 4rpx 2rpx 18rpx; }
.result-head text:first-child { font-size: 29rpx; font-weight: 750; }
.result-head text:last-child { color: var(--muted); font-size: 22rpx; }
.category-product-list { padding-bottom: 40rpx; }
.category-product-card { display: flex; min-height: 186rpx; margin-bottom: 16rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: var(--radius); background: var(--paper); }
.category-product-media { flex: none; width: 176rpx; height: 176rpx; margin: 5rpx; overflow: hidden; border-radius: 16rpx; background: #eef0f3; }
.category-product-media > image, .category-product-media > view { width: 100%; height: 100%; }
.category-product-media .media-fallback image { width: 64rpx; height: 64rpx; }
.category-product-card .product-cover { width: 100%; height: 100%; border-radius: 0; }
.category-product-card .product-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; padding: 20rpx 18rpx 16rpx; }
.category-product-card .product-title { min-height: 0; line-height: 36rpx; font-size: 26rpx; font-weight: 650; -webkit-line-clamp: 2; }
.category-product-card .product-subtitle { margin-top: 8rpx; font-size: 22rpx; }
.category-product-card .product-price { margin-top: auto; font-size: 31rpx; }
.category-product-card .product-price text { margin-right: 2rpx; font-size: 22rpx; }
.category-empty text { display: block; }
.category-empty text:first-child { color: var(--ink); font-size: 29rpx; font-weight: 700; }
.category-empty text:nth-child(2) { margin-top: 8rpx; font-size: 22rpx; }
.category-empty button { width: 220rpx; margin-top: 24rpx; font-size: 24rpx; }
.category-page { padding-bottom: calc(112rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.category-search { flex: none; background: var(--header); border-color: var(--line); }
.category-search button { background: var(--button); }
.category-products, .category-side { background: var(--canvas); }
.guide-category-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; margin-bottom: 24rpx; }
.guide-category { overflow: hidden; text-align: center; padding-bottom: 18rpx; }
.guide-category image, .guide-placeholder { width: 100%; height: 180rpx; display: block; margin-bottom: 14rpx; }
.guide-placeholder { display: flex; align-items: center; justify-content: center; background: var(--brand-soft); color: var(--accent); }
.guide-showcase .guide-category image, .guide-showcase .guide-placeholder { height: 260rpx; }
.guide-scenario .guide-category-grid { grid-template-columns: minmax(0, 1fr); }
.guide-scenario .guide-category image, .guide-scenario .guide-placeholder { height: 280rpx; }
.guide-quick { margin-bottom: 24rpx; }
.guide-quick button { display: inline-block; margin: 0 14rpx 14rpx 0; padding: 12rpx 24rpx; background: var(--paper); color: var(--ink); border: 1rpx solid var(--line); border-radius: 999rpx; font-size: 24rpx; }
.guide-back { margin-bottom: 20rpx; font-size: 24rpx; }
.category-products { width: 0; min-width: 0; }
.category-side { flex: none; }
.category-search input { min-width: 0; }
.no-results { padding: 96rpx 20rpx; }
.no-results .no-results-description { font-size: 25rpx; line-height: 40rpx; }
.empty-actions { display: flex; flex-direction: column; align-items: center; gap: 18rpx; margin-top: 30rpx; }
.empty-actions button { width: 100%; max-width: 320rpx; min-height: 88rpx; line-height: 40rpx; margin: 0; padding: 22rpx 12rpx; font-size: 26rpx; }

/* Retail list: a quiet side rail, image, information and one purchase action. */
.category-side { width: 142rpx; }
.side-item { min-height: 112rpx; padding: 34rpx 12rpx; white-space: normal; line-height: 40rpx; font-size: 26rpx; }
.category-products { padding: 0 18rpx; background: var(--paper); }
.result-head { gap: 16rpx; padding: 20rpx 0 4rpx; }
.result-head text:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.result-head text:last-child { flex: none; }
.sort-tabs { position: sticky; top: 0; z-index: 2; display: flex; min-height: 88rpx; background: var(--paper); border-bottom: 1rpx solid var(--line); }
.sort-tabs .sort-tab { flex: 1; width: 0; min-width: 0; margin: 0; padding: 22rpx 2rpx; line-height: 42rpx; border-radius: 0; background: transparent; color: var(--muted); font-size: 24rpx; white-space: nowrap; }
.sort-tabs .selected { color: var(--accent); font-weight: 650; }
.category-product-list { padding-bottom: 16rpx; }
.category-product-card { min-height: 254rpx; gap: 16rpx; margin: 0; padding: 22rpx 0; border: 0; border-bottom: 1rpx solid var(--line); border-radius: 0; }
.category-product-media { position: relative; align-self: flex-start; width: 214rpx; height: 214rpx; margin: 0; border: 1rpx solid var(--line); border-radius: 16rpx; }
.category-product-card .product-copy { padding: 0; }
.category-product-card .product-title { line-height: 38rpx; font-size: 29rpx; font-weight: 650; }
.category-product-card .product-subtitle { margin-top: 8rpx; line-height: 32rpx; font-size: 23rpx; }
.product-sales { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; line-height: 32rpx; }
.purchase-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 6rpx 10rpx; margin-top: auto; padding-top: 14rpx; }
.category-product-card .product-price { display: flex; align-items: baseline; flex: none; margin: 0; line-height: 44rpx; white-space: nowrap; }
.category-product-card .product-price .currency { margin-right: 2rpx; font-size: 22rpx; }
.category-product-card .product-price .price-integer { margin: 0; font-size: 38rpx; }
.category-product-card .product-price .price-decimal { margin: 0; font-size: 24rpx; }
.purchase-row .quick-cart-button { display: flex; align-items: center; justify-content: center; flex: none; min-width: 132rpx; width: auto; min-height: 68rpx; margin: 0 0 0 auto; padding: 12rpx 16rpx; border-radius: 999rpx; color: #fff; background: var(--button); font-size: 24rpx; font-weight: 600; line-height: 36rpx; white-space: nowrap; }
.purchase-row .quick-cart-button.is-disabled { background: #e8ebef; color: #6b7280; }
.sold-out-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 8rpx; text-align: center; color: #fff; background: rgba(30,37,50,.65); font-size: 24rpx; }
.sku-overlay { position: fixed; inset: 0; z-index: 200; display: flex; align-items: flex-end; background: rgba(20,25,35,.45); }
.sku-sheet { width: 100%; max-height: 85vh; padding: 28rpx 30rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 28rpx 28rpx 0 0; background: var(--paper); }
.sku-heading { display: flex; align-items: center; justify-content: space-between; font-size: 34rpx; font-weight: 650; }
.sku-heading .sku-close { width: auto; min-height: 80rpx; margin: 0; padding: 18rpx 12rpx; color: var(--muted); background: transparent; font-size: 26rpx; line-height: 40rpx; }
.sku-product-name { margin-top: 16rpx; font-size: 28rpx; line-height: 42rpx; }
.sku-price { margin: 16rpx 0 24rpx; color: var(--price); font-size: 30rpx; }
.sku-options { max-height: 32vh; }
.sku-options .sku-option { width: 100%; min-height: 88rpx; margin: 0 0 16rpx; padding: 20rpx; border: 1rpx solid var(--line); border-radius: 16rpx; color: var(--ink); background: var(--canvas); font-size: 26rpx; line-height: 42rpx; text-align: left; }
.sku-options .selected { color: var(--accent); border-color: var(--accent); background: var(--brand-soft); }
.sku-options .sku-option.is-disabled { color: #8a919c; background: #f2f3f5; }
.sku-sheet .sku-confirm { margin-top: 24rpx; }
.purchase-row .quick-cart-button, .sort-tabs .sort-tab { min-height: 44px; }
@media (max-width: 360px) {
  .category-product-card .product-title { font-size: 14px; line-height: 20px; }
  .category-product-card .product-subtitle, .product-sales { font-size: 11px; line-height: 16px; }
  .purchase-row .quick-cart-button { font-size: 12px; }
  .category-product-card .product-price .price-integer { font-size: 19px; }
}
