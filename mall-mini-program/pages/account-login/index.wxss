.account-auth{min-height:100vh;box-sizing:border-box;padding:40rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));background:var(--page-background,#f6f7f9);color:#202631}.auth-brand{display:flex;align-items:center;gap:22rpx;margin:12rpx 8rpx 36rpx;font-size:36rpx;font-weight:700}.auth-brand image{width:80rpx;height:80rpx;border-radius:20rpx}.auth-card{background:#fff;border-radius:24rpx;padding:32rpx}.auth-tabs{display:flex;padding:8rpx;background:#f3f5f8;border-radius:18rpx;margin-bottom:28rpx}.auth-tabs button{flex:1;font-size:28rpx;background:transparent;color:#667085}.auth-tabs .active{color:var(--brand);background:#fff;font-weight:700}.auth-title{display:block;font-size:34rpx;font-weight:700;margin-bottom:24rpx}.label{display:block;font-size:27rpx;margin:24rpx 0 14rpx;font-weight:600}.field{box-sizing:border-box;height:92rpx;padding:0 22rpx;border:1rpx solid #dce1e8;border-radius:16rpx;font-size:27rpx;min-width:0;background:#fff}.inline{display:flex;gap:16rpx;align-items:center}.inline input{flex:1;width:0}.inline button{flex:none;width:212rpx;margin:0;font-size:25rpx;padding:0 8rpx;background:var(--brand-soft,#fff0f3);color:var(--brand);height:92rpx;line-height:92rpx}.captcha image{width:100%;height:80rpx;vertical-align:middle}.primary{margin:32rpx 0 20rpx;background:var(--brand,#e7193f);color:#fff;font-size:30rpx;font-weight:700;height:92rpx;line-height:92rpx}.hint{display:block;color:#727b89;font-size:24rpx;line-height:1.6;margin:12rpx 0}.error{display:block;color:#bd233a;font-size:25rpx;line-height:1.6;margin-top:18rpx}.invalid{border-color:#bd233a}.agreement{display:flex;align-items:flex-start;gap:8rpx;color:#727b89;font-size:24rpx;line-height:1.8;margin-top:20rpx}.agreement checkbox{transform:scale(.8);transform-origin:left top}.agreement checkbox-group{flex:none;width:42rpx}.legal-link{color:var(--brand);padding:6rpx 0}.links{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12rpx;margin-top:18rpx}.links button,.text-link{background:transparent;color:#667085;font-size:25rpx;padding:8rpx 0;min-height:80rpx;line-height:64rpx;margin:0}.text-link{color:var(--brand)}button::after{border:0}button[disabled]{opacity:.5}@media(max-width:340px){.account-auth{padding-left:24rpx;padding-right:24rpx}.auth-card{padding:24rpx}.inline button{width:200rpx}}
.account-auth .auth-card .primary { width:100%; margin:32rpx 0 20rpx; border-radius:18rpx; }
.account-auth .auth-card .links button, .account-auth .auth-card .text-link { width:auto; min-width:0; }
.account-auth .auth-tabs button { min-width:0; width:0; margin:0; }
