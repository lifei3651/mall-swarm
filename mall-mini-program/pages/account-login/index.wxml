<view class="account-auth" style="{{themeStyle}}; --brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}">
  <view class="auth-brand"><image src="{{brandLogo || '/assets/lingqi-logo-mark.png'}}" mode="aspectFit" /><text>{{brandName || '商城账号'}}</text></view>
  <view class="auth-card">
    <view wx:if="{{mode === 'password' || mode === 'sms'}}" class="auth-tabs"><button class="{{mode === 'password' ? 'active' : ''}}" data-mode="password" bindtap="switchMode">密码登录</button><button class="{{mode === 'sms' ? 'active' : ''}}" data-mode="sms" bindtap="switchMode">验证码登录</button></view>
    <text wx:else class="auth-title">{{mode === 'register' ? '注册商城账号' : resetStep === 1 ? '验证绑定手机号' : '设置新登录密码'}}</text>
    <block wx:if="{{mode !== 'reset' || resetStep === 1}}">
      <view wx:if="{{mode === 'password'}}"><text class="label">手机号或登录账号</text><input class="field {{errorField === 'account' ? 'invalid' : ''}}" value="{{form.account}}" data-field="account" bindinput="input" disabled="{{submitting || sending}}" maxlength="64" placeholder="请输入手机号或登录账号" aria-label="手机号或登录账号" /></view>
      <view wx:else><text class="label">手机号</text><input class="field {{errorField === 'phone' ? 'invalid' : ''}}" type="number" value="{{form.phone}}" data-field="phone" bindinput="input" disabled="{{submitting || sending}}" maxlength="11" placeholder="请输入11位手机号" aria-label="手机号" /></view>
      <view wx:if="{{mode === 'register'}}"><text class="label">登录账号</text><input class="field {{errorField === 'username' ? 'invalid' : ''}}" value="{{form.username}}" data-field="username" bindinput="input" disabled="{{submitting}}" maxlength="20" placeholder="4至20位，以英文字母开头" aria-label="登录账号" /></view>
    </block>
    <block wx:if="{{mode === 'password' || mode === 'register' || (mode === 'reset' && resetStep === 2)}}">
      <text class="label">{{mode === 'reset' ? '新登录密码' : '登录密码'}}</text><input class="field {{errorField === 'password' ? 'invalid' : ''}}" password value="{{form.password}}" data-field="password" bindinput="input" disabled="{{submitting}}" maxlength="{{mode === 'password' ? 128 : 32}}" placeholder="{{mode === 'password' ? '请输入登录密码' : '请输入10至32位密码'}}" aria-label="登录密码" />
      <view wx:if="{{mode !== 'password'}}"><text class="label">确认登录密码</text><input class="field {{errorField === 'confirmPassword' ? 'invalid' : ''}}" password value="{{form.confirmPassword}}" data-field="confirmPassword" bindinput="input" disabled="{{submitting}}" maxlength="32" placeholder="请再次输入登录密码" aria-label="确认登录密码" /></view>
    </block>
    <block wx:if="{{mode === 'register'}}">
      <text class="label">邀请码（选填）</text><view class="inline"><input class="field" value="{{inviteCode}}" bindinput="invitationInput" disabled="{{submitting || inviteFromLink || inviteConflict}}" maxlength="8" placeholder="输入8位邀请码" aria-label="邀请码，选填" /><button bindtap="checkInvitation" disabled="{{submitting || inviteBusy}}">核对</button></view>
      <text class="hint">仅首次注册绑定，已有账号不更换上级。</text><text wx:if="{{inviterName}}" class="hint">邀请人：{{inviterName}}</text><text wx:if="{{inviteBusy}}" class="hint">正在核对邀请人…</text><text wx:if="{{inviteError}}" class="error">{{inviteError}}</text>
      <view wx:if="{{inviteConflict}}"><text class="hint">收到另一份邀请：{{candidateName || '核对中'}}，请明确选择。</text><view class="links"><button data-choice="keep" bindtap="chooseInvitation" disabled="{{submitting || inviteBusy}}">保留当前邀请</button><button data-choice="new" bindtap="chooseInvitation" disabled="{{submitting || inviteBusy || !candidateValid}}">使用本次邀请</button></view></view>
      <button wx:if="{{inviteCode || inviteError}}" class="text-link" bindtap="clearInvitation" disabled="{{submitting}}">不使用邀请</button>
    </block>
    <block wx:if="{{mode !== 'reset' || resetStep === 1}}">
      <view wx:if="{{mode !== 'password'}}"><text class="label">短信验证码</text><view class="inline"><input class="field {{errorField === 'smsCode' ? 'invalid' : ''}}" type="number" value="{{form.smsCode}}" data-field="smsCode" bindinput="input" disabled="{{submitting}}" maxlength="6" placeholder="请输入6位验证码" aria-label="短信验证码" /><button bindtap="sendCode" loading="{{sending}}" disabled="{{submitting || sending || cooldown}}">{{cooldown ? cooldown + '秒后重发' : '获取验证码'}}</button></view></view>
      <view wx:if="{{mode !== 'sms'}}"><text class="label">图形验证码</text><view class="inline"><input class="field {{errorField === 'captchaCode' ? 'invalid' : ''}}" value="{{form.captchaCode}}" data-field="captchaCode" bindinput="input" disabled="{{submitting}}" maxlength="4" placeholder="请输入4位验证码" aria-label="图形验证码" /><button class="captcha" bindtap="refreshCaptcha" disabled="{{submitting || captchaBusy}}" aria-label="刷新图形验证码"><image wx:if="{{captchaImage}}" src="{{captchaImage}}" mode="aspectFit" /><text wx:else>{{captchaBusy ? '加载中' : '点击刷新'}}</text></button></view></view>
    </block>
    <text wx:if="{{error}}" class="error" role="alert">{{error}}</text>
    <button class="primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || sending || captchaBusy}}">{{mode === 'register' ? '注册' : mode === 'reset' ? (resetStep === 1 ? '下一步' : '确认重置') : '登录'}}</button>
    <view class="agreement {{errorField === 'agreement' ? 'invalid' : ''}}"><checkbox-group bindchange="consent"><checkbox value="agree" checked="{{agreed}}" disabled="{{submitting}}" color="{{themeColor}}" aria-label="同意用户服务协议和隐私政策" /></checkbox-group><view>我已阅读并同意<text bindtap="agreement" class="legal-link">《用户服务协议》</text>和<text bindtap="privacy" class="legal-link">《隐私政策》</text></view></view>
    <view class="links"><button wx:if="{{mode !== 'register'}}" data-mode="register" bindtap="switchMode" disabled="{{submitting || sending}}">注册账号</button><button wx:if="{{mode === 'password' || mode === 'sms'}}" data-mode="reset" bindtap="switchMode" disabled="{{submitting || sending}}">忘记密码</button><button wx:if="{{mode === 'register' || mode === 'reset'}}" data-mode="password" bindtap="switchMode" disabled="{{submitting || sending}}">返回登录</button><button wx:if="{{mode === 'reset' && resetStep === 2}}" bindtap="backToReset" disabled="{{submitting}}">重新填写验证信息</button></view>
  </view>
</view>
