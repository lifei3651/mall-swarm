<view class="page wallet-page" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}}">
  <view wx:if="{{loading}}" class="empty">正在核对钱包记录…</view>
  <view wx:elif="{{error}}" class="empty"><text>{{error}}</text><button bindtap="load" class="secondary-button">重新加载</button></view>
  <block wx:else>
    <view class="card wallet-summary">
      <view class="balance-line"><view class="balance-copy"><text class="balance-amount">{{balance}}</text><text class="balance-label">可提现余额(元)</text></view><button class="withdraw-button" bindtap="withdraw">提现</button></view>
      <view class="bonus-grid">
        <button bindtap="bonusInfo" data-type="issued" aria-label="查看已发放奖金说明"><text class="bonus-amount">{{issuedBonus}}</text><view><text>已发放</text><text class="info-mark">说明</text><image src="/assets/profile/chevron-right.png" /></view></button>
        <button bindtap="bonusInfo" data-type="pending" aria-label="查看待发放奖金说明"><text class="bonus-amount">{{pendingBonus}}</text><view><text>待发放</text><text class="info-mark">说明</text><image src="/assets/profile/chevron-right.png" /></view></button>
      </view>
      <button wx:if="{{bonusError}}" class="bonus-retry" bindtap="retryBonus">{{bonusError}}</button>
      <text class="balance-note">余额包含奖金及其他入账；提现仍需满足实名、支付密码与审核规则。</text>
    </view>
    <button class="record-entry" bindtap="history"><image src="/assets/profile/credit-card.png" /><text>提现记录</text><text class="record-subtitle">进度与收款确认</text><image class="chevron" src="/assets/profile/chevron-right.png" /></button>
    <view class="section-label">余额明细</view>
    <view class="card flow-panel">
      <view wx:if="{{!flows.length}}" class="empty">暂无余额记录</view>
      <view class="wallet-flow" wx:for="{{flows}}" wx:key="id"><view class="flow-top"><text>{{item.title}}</text><text>{{item.amount}}</text></view><text class="muted">{{item.time}}</text><text class="muted flow-balance">变动前 ¥{{item.before}} · 变动后 ¥{{item.after}}</text></view>
    </view>
    <view class="wallet-support"><text>对记录有疑问？</text><button open-type="contact" show-message-card>联系商城客服</button></view>
  </block>
</view>
