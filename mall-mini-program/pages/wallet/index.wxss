.wallet-page { min-height:100vh; padding:24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); }
.wallet-page .card { border:0; border-radius:22rpx; box-shadow:none; }
.wallet-summary { padding:32rpx 28rpx 24rpx; margin-bottom:24rpx; }
.balance-line { display:flex; align-items:center; gap:20rpx; }
.balance-copy { flex:1; min-width:0; }.balance-amount { display:block; color:var(--price); font-size:54rpx; font-weight:600; line-height:1.35; overflow-wrap:anywhere; }.balance-label { display:block; margin-top:8rpx; color:var(--muted); font-size:24rpx; }
.wallet-page .withdraw-button { flex:none; display:flex; align-items:center; justify-content:center; width:auto; min-width:124rpx; min-height:80rpx; margin:0; padding:14rpx 26rpx; background:var(--button); color:white; border-radius:16rpx; font-size:27rpx; font-weight:500; line-height:40rpx; }
.bonus-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); margin-top:32rpx; }
.bonus-grid button { min-width:0; width:100%; margin:0; padding:8rpx 22rpx 8rpx 0; color:var(--ink); background:transparent; border-radius:0; text-align:left; font-weight:400; line-height:1.5; }
.bonus-grid button + button { border-left:1rpx solid var(--line); padding-left:24rpx; padding-right:0; }
.bonus-amount { display:block; font-size:34rpx; font-weight:600; overflow-wrap:anywhere; }.bonus-grid button > view { display:flex; align-items:center; gap:8rpx; margin-top:4rpx; font-size:23rpx; color:var(--muted); }.bonus-grid image { width:22rpx; height:22rpx; margin-left:auto; opacity:.5; }.info-mark { font-size:19rpx; }
.balance-note { display:block; margin-top:24rpx; color:var(--muted); font-size:21rpx; line-height:34rpx; }
.wallet-page .bonus-retry { margin:16rpx 0 0; padding:12rpx 0; text-align:left; background:transparent; color:var(--brand); font-size:22rpx; line-height:34rpx; }
.wallet-page .record-entry { display:flex; width:100%; align-items:center; gap:14rpx; min-height:100rpx; margin:0; padding:22rpx 24rpx; background:var(--paper); color:var(--ink); border-radius:20rpx; font-size:26rpx; font-weight:400; line-height:38rpx; }.record-entry image { width:32rpx; height:32rpx; flex:none; }.record-subtitle { margin-left:auto; color:var(--muted); font-size:22rpx; }.record-entry .chevron { width:24rpx; height:24rpx; opacity:.5; }
.section-label { font-size:28rpx; font-weight:600; margin:32rpx 6rpx 20rpx; }.flow-panel { padding:0 24rpx; }.wallet-flow { padding:24rpx 0; border-bottom:1rpx solid var(--line); }.wallet-flow:last-child { border-bottom:0; }.flow-top { display:flex; align-items:flex-start; gap:20rpx; line-height:40rpx; font-size:27rpx; }.flow-top text:first-child { flex:1; min-width:0; overflow-wrap:anywhere; }.flow-top text:last-child { font-weight:600; text-align:right; overflow-wrap:anywhere; max-width:50%; }.wallet-flow > .muted { display:block; font-size:23rpx; line-height:35rpx; margin-top:6rpx; }.wallet-flow > .flow-balance { font-size:21rpx; }
.wallet-support { display:flex; flex-wrap:wrap; align-items:center; justify-content:center; margin-top:20rpx; color:var(--muted); font-size:23rpx; }.wallet-support button { display:inline-flex; width:auto; min-height:88rpx; align-items:center; margin:0; padding:18rpx 8rpx; background:transparent; color:var(--brand); border-radius:8rpx; font-size:23rpx; font-weight:400; line-height:36rpx; }
