.wallet-page { padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); }
.wallet-summary { padding: 32rpx; margin-bottom: 28rpx; }
.wallet-summary > view { font-size: 52rpx; font-weight: 600; margin: 24rpx 0; color: var(--price); overflow-wrap: anywhere; }
.section-label { font-size: 28rpx; font-weight: 600; margin: 24rpx 0; }
.wallet-flow { padding: 26rpx; margin-bottom: 18rpx; }
.wallet-flow > view { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8rpx 24rpx; line-height: 1.6; overflow-wrap: anywhere; }
.wallet-flow > view text:last-child { margin-left: auto; text-align: right; font-weight: 600; }
.wallet-flow > .muted { display: block; font-size: 24rpx; margin-top: 10rpx; overflow-wrap: anywhere; }
