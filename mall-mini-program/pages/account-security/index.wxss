.security-page { min-height: 100vh; padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); }
.panel { width: 100%; min-width: 0; margin-bottom: 24rpx; padding: 28rpx; border-radius: 22rpx; color: var(--ink); background: var(--paper); }
.section-title { margin-bottom: 12rpx; font-size: 29rpx; font-weight: 600; }
.account-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin: 20rpx 0; font-size: 25rpx; line-height: 38rpx; }
.account-row text:last-child { min-width: 0; max-width: 65%; color: var(--muted); word-break: break-all; text-align: right; }
.field-label { display: block; margin: 26rpx 0 14rpx; font-size: 25rpx; font-weight: 500; }
.field { box-sizing: border-box; width: 100%; min-width: 0; height: 88rpx; min-height: 88rpx; padding: 0 18rpx; color: var(--ink); background: var(--canvas); border: 1rpx solid transparent; border-radius: 14rpx; font-size: 25rpx; }
.hint { display: block; min-width: 0; color: var(--muted); font-size: 23rpx; line-height: 37rpx; word-break: break-all; }
.security-page .primary-button, .security-page .secondary-button { width: 100%; margin-top: 24rpx; font-size: 26rpx; }
.sms-row { display: flex; align-items: stretch; width: 100%; min-width: 0; gap: 12rpx; margin-bottom: 14rpx; }
.code-input { flex: 1; min-width: 0; width: 0; }
.security-page .sms-button { flex: none; width: 180rpx; min-width: 0; min-height: 88rpx; margin: 0; padding: 20rpx 8rpx; font-size: 24rpx; line-height: 40rpx; white-space: nowrap; }
.nickname-actions { display: flex; gap: 16rpx; }
.security-page .nickname-actions button { flex: 1; width: 0; min-width: 0; padding-left: 8rpx; padding-right: 8rpx; }
.error-message, .success-message { display: block; margin: 20rpx 8rpx; font-size: 25rpx; line-height: 38rpx; }
.error-message { color: #b42318; }
.success-message { color: #08754b; }
.help-panel { margin-top: 24rpx; padding-top: 0; padding-bottom: 0; }
.security-page .avatar-picker { display:flex; align-items:center; gap:16rpx; width:100%; margin:0; padding:20rpx 0; background:transparent; color:var(--ink); border-radius:0; font-size:27rpx; font-weight:400; text-align:left; }
.avatar-label { flex:1; }.avatar-picker image { width:84rpx; height:84rpx; border-radius:50%; flex:none; }.avatar-action { color:var(--muted); font-size:23rpx; }.avatar-picker .avatar-arrow { width:24rpx; height:24rpx; opacity:.5; }.avatar-picker::after { border:0; }
.avatar-hint { padding-bottom:22rpx; border-bottom:1rpx solid var(--line); font-size:22rpx; }
.account-row { min-height:58rpx; align-items:center; margin:0; padding:16rpx 0; border-bottom:1rpx solid var(--line); }
.security-page .account-link { width:100%; max-width:100%; min-width:0; margin:0; background:transparent; color:var(--ink); border-radius:0; font-weight:400; text-align:left; }.entry-arrow { width:28rpx; height:28rpx; flex:none; }
.security-page .support-link { display:flex; align-items:center; justify-content:space-between; gap:16rpx; box-sizing:border-box; width:100%; max-width:100%; min-width:0; min-height:88rpx; height:auto; margin:0; padding:16rpx 0; border-radius:0; background:transparent; color:var(--muted); font-size:23rpx; font-weight:400; line-height:36rpx; text-align:left; white-space:normal; }
.support-copy { flex:1; min-width:0; word-break:break-all; }
.support-action { display:flex; align-items:center; flex:none; gap:6rpx; color:var(--brand); white-space:nowrap; }
.support-action image { flex:none; width:24rpx; height:24rpx; opacity:.5; }
.security-page .support-link[disabled] { opacity:.5; background:transparent; }
.personal-profile { padding:24rpx 0; background:var(--canvas); }
.personal-profile .panel { padding:0 32rpx; border-radius:0; }
.personal-profile .account-row { min-height:108rpx; padding:20rpx 0; font-size:29rpx; }
.personal-profile .account-row:last-child { border-bottom:0; }
.personal-profile .avatar-picker { padding:24rpx 0; border-bottom:1rpx solid var(--line); font-size:29rpx; }
.personal-profile .avatar-picker image { border-radius:12rpx; }
.personal-profile .row-value { display:flex; align-items:center; justify-content:flex-end; gap:14rpx; flex:1; min-width:0; color:var(--muted); }
.personal-profile .row-value text { max-width:100%; min-width:0; word-break:break-all; font-size:27rpx; }
.personal-profile .entry-arrow { opacity:.5; }
.password-page .panel { padding: 24rpx 28rpx; }
.password-page .field-label { margin: 22rpx 0 10rpx; }
.password-page .hint { font-size: 23rpx; line-height: 34rpx; }
.password-page .help-panel { margin-top: 0; padding-top: 0; padding-bottom: 0; }
