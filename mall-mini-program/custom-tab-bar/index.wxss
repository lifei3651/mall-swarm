.navigation { position: fixed; z-index: 100; bottom: 0; left: 0; right: 0; display: flex; box-sizing: border-box; height: calc(112rpx + env(safe-area-inset-bottom)); padding: 8rpx 8rpx calc(8rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--line); background: var(--paper); }
.nav-item { flex: 1; min-width: 0; margin: 0; padding: 8rpx 2rpx; border: 0; border-radius: 16rpx; line-height: 1.4; color: var(--muted); background: transparent; font-size: 22rpx; }
.nav-item::after { border: 0; }
.nav-icon, .orders-icon { display: block; width: 40rpx; height: 40rpx; margin: 0 auto 5rpx; }
.orders-icon { box-sizing: border-box; width: 30rpx; border: 2rpx solid currentColor; border-radius: 4rpx; line-height: 30rpx; font-size: 32rpx; }
.selected { color: var(--accent); background: var(--brand-soft); font-weight: 650; }
.nav-label { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
