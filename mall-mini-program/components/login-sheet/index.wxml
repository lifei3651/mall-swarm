<view wx:if="{{visible}}" class="login-shell {{presentation === 'page' ? 'login-full-page' : 'login-modal'}}" style="--brand: {{themeColor}}; --brand-soft: {{themeSoftColor}}; {{themeStyle}};{{presentation !== 'page' ? 'background:transparent' : ''}}">
  <view wx:if="{{presentation !== 'page'}}" class="login-backdrop" bindtap="close" catchtouchmove="stop" aria-hidden="true" />
  <view class="login-panel" role="dialog" aria-label="商城账号登录" aria-modal="true">
    <view wx:if="{{presentation === 'page'}}" class="login-brand" aria-label="{{brandName}}">
      <image class="login-logo" src="{{brandLogo && !logoFailed ? brandLogo : '/assets/lingqi-logo-mark.png'}}" binderror="logoError" mode="aspectFit" aria-hidden="true" />
      <text class="login-brand-name">{{brandName}}</text>
    </view>
    <view class="login-heading">
      <view class="login-heading-copy">
        <text class="login-title">{{profileStep ? '完善头像昵称' : '微信快捷登录'}}</text>
        <text wx:if="{{!profileStep}}" class="login-subtitle">授权手机号即可登录，首次使用将自动创建商城账号</text>
      </view>
      <button wx:if="{{presentation !== 'page'}}" class="close-button" bindtap="close" disabled="{{submitting || profileSaving}}" aria-label="{{profileStep ? '跳过资料填写，继续进入商城' : '关闭登录，返回商城'}}">×</button>
    </view>
    <view wx:if="{{profileStep}}" class="login-content registration-profile">
      <view class="profile-intro">账号已创建，可直接使用微信资料，也可以稍后设置</view>
      <form bindsubmit="saveProfile">
        <button wx:if="{{!profileStarted}}" class="profile-wechat-entry" open-type="chooseAvatar" bindchooseavatar="chooseProfileAvatar" disabled="{{profileSaving}}" aria-label="使用微信资料，先选择头像再确认昵称">
          <text class="profile-wechat-title">使用微信头像和昵称</text>
          <text class="profile-wechat-caption">先选择头像，再确认昵称</text>
        </button>
        <block wx:else>
          <view class="registration-identity-row">
            <button class="registration-avatar" open-type="chooseAvatar" bindchooseavatar="chooseProfileAvatar" disabled="{{profileSaving}}" aria-label="重新选择微信头像">
              <image src="{{profileAvatar || '/assets/profile/user-round.png'}}" mode="aspectFill" />
              <text>更换头像</text>
            </button>
            <view class="registration-field"><text>昵称</text><input name="nickname" type="nickname" value="{{profileNickname}}" focus="{{profileNicknameFocus}}" bindinput="profileNicknameInput" bindblur="profileNicknameBlur" disabled="{{profileSaving}}" maxlength="20" placeholder="点击使用微信昵称" aria-label="昵称，可使用微信昵称或手动填写" /></view>
          </view>
          <view wx:if="{{profileError}}" class="login-error" role="alert">{{profileError}}</view>
          <button class="login-button profile-complete" form-type="submit" disabled="{{profileSaving}}" loading="{{profileSaving}}">完成</button>
        </block>
      </form>
      <text class="profile-optional">根据微信规则，头像与昵称需要分别由你确认，商城不会静默读取。</text>
      <button class="help-button profile-skip" bindtap="skipProfile" disabled="{{profileSaving}}">暂不设置</button>
    </view>
    <view wx:else class="login-content">
      <view wx:if="{{contextHint}}" class="login-context">登录后{{contextHint}}</view>
      <view wx:if="{{loading}}" class="login-loading">正在检查商城配置…</view>
      <block wx:else>
        <block wx:if="{{phoneEnabled}}">
          <button wx:if="{{agreed && inviteReady && !inviteBusy && !inviteConflict}}" class="login-button {{submitting || !enabled ? 'is-disabled' : ''}}" open-type="getPhoneNumber" loading="{{submitting}}" disabled="{{submitting || !enabled}}" bindtap="beginPhoneAuthorization" bindgetphonenumber="phoneLogin">微信手机号一键登录</button>
          <button wx:else class="login-button {{submitting || !enabled ? 'is-disabled' : ''}}" disabled="{{submitting || !enabled}}" bindtap="requireAgreement">微信手机号一键登录</button>
        </block>
        <button wx:else class="login-button {{submitting || !enabled ? 'is-disabled' : ''}}" loading="{{submitting}}" disabled="{{submitting || !enabled}}" bindtap="returningLogin">商城账号登录</button>
        <view class="agreement {{agreementRequired ? 'agreement-required' : ''}}">
          <checkbox-group bindchange="agreementChange" class="agreement-control"><checkbox class="agreement-checkbox" value="agreed" checked="{{agreed}}" disabled="{{submitting}}" color="{{themeColor}}" aria-label="我已阅读并同意用户服务协议和隐私政策" /></checkbox-group>
          <view class="agreement-copy"><text>我已阅读并同意</text><text class="privacy-link" bindtap="openAgreement" role="link">《用户服务协议》</text><text>和</text><text class="privacy-link" bindtap="openPrivacy" role="link">《隐私政策》</text></view>
        </view>
        <view wx:if="{{agreementRequired && !agreed}}" class="agreement-hint">请先阅读并勾选同意以上协议</view>
        <view wx:if="{{invitationEnabled && inviteExpanded}}" class="invite-tip">
          <text class="invite-caption">{{inviteFromLink ? '来自分享或扫码的邀请' : '邀请码（选填）'}} · 仅首次注册绑定，已有账号不换上级</text>
          <view wx:if="{{!inviteFromLink}}" class="invite-input-row"><input class="invite-input" value="{{inviteCode}}" maxlength="8" placeholder="输入8位邀请码" bindinput="invitationInput" disabled="{{submitting}}" aria-label="邀请码，选填" /><button class="help-button" bindtap="checkInvitation" disabled="{{submitting || inviteBusy}}">核对</button></view>
          <text wx:if="{{inviteBusy}}" class="invite-caption">正在核对邀请人…</text>
          <text wx:if="{{inviterName}}">邀请人：{{inviterName}}</text>
          <text wx:if="{{inviteConflict}}" class="invite-caption">又收到一份邀请，请明确选择。本次邀请：{{candidateName || '核对中'}}</text>
          <view wx:if="{{inviteConflict}}" class="login-help"><button class="help-button" data-choice="keep" bindtap="chooseInvitation" disabled="{{submitting || inviteBusy}}">保留当前邀请</button><button class="help-button" data-choice="new" bindtap="chooseInvitation" disabled="{{submitting || inviteBusy || !candidateValid}}">使用本次邀请</button></view>
          <text wx:if="{{inviteError}}" class="login-error" role="alert">{{inviteError}}</text>
          <view class="login-help"><button wx:if="{{inviteError}}" class="help-button" bindtap="checkInvitation" disabled="{{submitting || inviteBusy}}">重新核对</button><button class="help-button" bindtap="clearInvitation" disabled="{{submitting}}">不使用邀请</button></view>
        </view>
        <view wx:if="{{enabled && !phoneEnabled}}" class="login-notice">手机号快捷登录暂不可用，已关联此微信的商城账号仍可登录。</view>
        <view wx:if="{{loginNotice}}" class="login-notice">{{loginNotice}}</view>
        <view wx:if="{{error}}" class="login-error" role="alert">{{error}}</view>
        <view wx:if="{{!enabled || !phoneEnabled || showLoginHelp}}" class="login-help">
          <button wx:if="{{enabled && phoneEnabled && showLoginHelp}}" class="help-button" disabled="{{submitting}}" bindtap="returningLogin">使用已关联微信登录</button>
          <button class="help-button" disabled="{{submitting}}" bindtap="loadRuntime">重新检查服务</button>
          <button class="help-button ui-service-entry ui-service-entry--compact" disabled="{{submitting}}" open-type="contact"><text>联系商城客服</text><image class="ui-list-arrow" src="/assets/profile/chevron-right.png" mode="aspectFit" /></button>
        </view>
      </block>
      <view wx:if="{{!loading}}" class="login-alternatives">
        <button class="help-button" bindtap="openAccountLogin" disabled="{{submitting || authorizingPhone}}">账号登录</button>
        <text class="alternative-divider" aria-hidden="true">·</text>
        <button wx:if="{{invitationEnabled}}" class="help-button" bindtap="toggleInvitation" disabled="{{submitting}}">{{inviteExpanded ? '收起邀请码' : '使用邀请码'}}</button>
      </view>
    </view>
  </view>
</view>
