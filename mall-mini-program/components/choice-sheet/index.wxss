:host { display: block; }
.choice-trigger { display:flex; align-items:center; gap:16rpx; min-width:0; min-height:90rpx; padding:20rpx 24rpx; border:1rpx solid var(--line); border-radius:18rpx; background:var(--paper); color:var(--ink); font-size:27rpx; line-height:40rpx; }
.choice-trigger--menu { min-height:96rpx; padding:22rpx 0; border:0; border-bottom:1rpx solid var(--line); border-radius:0; font-size:28rpx; }
.choice-trigger--disabled { opacity:.5; }
.choice-label { flex:none; }
.choice-value { flex:1; min-width:0; overflow-wrap:anywhere; }
.choice-trigger--menu .choice-value { text-align:right; color:var(--muted); }
.choice-placeholder { color:var(--muted); }
.choice-arrow { flex:none; width:28rpx; height:28rpx; opacity:.55; }
.choice-overlay { position:fixed; inset:0; z-index:120; }
.choice-backdrop { position:absolute; inset:0; background:rgba(0,0,0,.42); }
.choice-panel { position:absolute; right:0; bottom:0; left:0; padding:0 0 env(safe-area-inset-bottom); border-radius:28rpx 28rpx 0 0; background:var(--paper); box-shadow:0 -8rpx 32rpx rgba(0,0,0,.08); }
.choice-head { display:flex; align-items:center; justify-content:space-between; min-height:104rpx; padding:0 30rpx; border-bottom:1rpx solid var(--line); color:var(--ink); font-size:30rpx; font-weight:600; }
.choice-cancel { width:auto; min-width:88rpx; min-height:88rpx; margin:0 -12rpx 0 0; padding:0 12rpx; border:0; background:transparent; color:var(--muted); font-size:26rpx; font-weight:400; line-height:88rpx; }
.choice-cancel::after { border:0; }
.choice-option { display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-height:96rpx; padding:20rpx 32rpx; border-bottom:1rpx solid var(--line); color:var(--ink); font-size:28rpx; line-height:40rpx; overflow-wrap:anywhere; }
.choice-option--selected,.choice-check { color:var(--brand); }
.choice-check { flex:none; font-size:30rpx; }
