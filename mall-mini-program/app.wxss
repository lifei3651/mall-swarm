page {
  --brand: #e7193f;
  --ink: #1e2532;
  --muted: #81899a;
  --line: #e9ebf0;
  --paper: #ffffff;
  --canvas: #f6f7f9;
  background: var(--canvas);
  color: var(--ink);
  font-size: 28rpx;
}

view, text, image, button, input, swiper, swiper-item { box-sizing: border-box; }
button::after { border: 0; }
.page { min-height: 100vh; padding: 24rpx 24rpx 48rpx; }
.card { background: #fff; border-radius: 24rpx; }
.muted { color: var(--muted); }
.empty { padding: 120rpx 36rpx; text-align: center; color: var(--muted); }
.primary-button { background: var(--brand); color: #fff; border-radius: 999rpx; font-weight: 600; }
.secondary-button { background: #fff; color: var(--ink); border: 1rpx solid var(--line); border-radius: 999rpx; }
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.product-card { overflow: hidden; background: #fff; border-radius: 22rpx; }
.product-cover { width: 100%; height: 320rpx; background: #eef0f3; display: block; }
.product-copy { padding: 18rpx; }
.product-title { min-height: 76rpx; line-height: 38rpx; font-weight: 600; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.product-subtitle { margin-top: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 24rpx; color: var(--muted); }
.product-price { margin-top: 14rpx; color: var(--brand); font-size: 34rpx; font-weight: 700; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 4rpx 20rpx; }
.section-head text:first-child { font-size: 34rpx; font-weight: 700; }
.safe-bottom { height: env(safe-area-inset-bottom); }
