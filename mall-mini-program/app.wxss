page {
  --brand: #e7193f;
  --brand-soft: #fff1f4;
  --ink: #1e2532;
  --muted: #687284;
  --line: #e8eaf0;
  --paper: #ffffff;
  --canvas: #f5f6f8;
  --price: #e7193f;
  --button: #e7193f;
  --accent: #e7193f;
  --header: #ffffff;
  --radius: 24rpx;
  --radius-card: 22rpx;
  --radius-control: 18rpx;
  --radius-pill: 999rpx;
  --space-page: 24rpx;
  --space-section: 20rpx;
  --control-height: 88rpx;
  --action-height: 56rpx;
  --action-font-size: 26rpx;
  --action-padding-x: 24rpx;
  --danger: #b42318;
  --danger-soft: #fff1f0;
  --warning: #9a5a16;
  --warning-soft: #fff7e8;
  --shadow: 0 10rpx 34rpx rgba(31, 38, 52, .06);
  background: var(--canvas);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.45;
}

view, text, image, button, input, textarea, picker, swiper, swiper-item { box-sizing: border-box; }
button::after { border: 0; }
button { font-size: 28rpx; font-family: inherit; }
/* Choice controls share one row geometry; pages retain native picker behaviour. */
.ui-select-row { display:flex; align-items:center; gap:16rpx; width:100%; min-width:0; min-height:96rpx; line-height:40rpx; padding:20rpx 22rpx; font-size:28rpx; }
.ui-select-label { flex:none; font-weight:400; color:var(--ink); }
.ui-select-value { flex:1; min-width:0; text-align:right; overflow-wrap:anywhere; color:var(--muted); }
.ui-select-row > text:only-of-type { flex:1; min-width:0; overflow-wrap:anywhere; }
.ui-select-arrow { flex:none; width:28rpx; height:28rpx; opacity:.55; }
.page { min-height: 100vh; padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); }
.card, .ui-card { background: var(--paper); border: 1rpx solid var(--line); border-radius: var(--radius-card); box-shadow: var(--shadow); }
.muted { color: var(--muted); }
.empty { padding: 120rpx 36rpx; text-align: center; color: var(--muted); line-height: 44rpx; }
.primary-button, .secondary-button, .danger-button, .ui-button { display: flex; align-items: center; justify-content: center; width: 100%; max-width: 100%; min-width: 0; min-height: var(--control-height); height: auto; padding: 22rpx 24rpx; border-radius: var(--radius-control) !important; line-height: 40rpx; text-align: center; white-space: normal; box-shadow: none !important; }
.primary-button, .ui-button--primary { background: var(--button) !important; color: #fff !important; border: 1rpx solid var(--button) !important; font-weight: 600; }
.secondary-button, .ui-button--secondary { background: #f1f3f6 !important; color: var(--ink) !important; border: 1rpx solid #e3e7ed !important; font-weight: 500; }
.danger-button, .ui-button--danger { background: var(--danger-soft) !important; color: var(--danger) !important; border: 1rpx solid #fecaca !important; font-weight: 600; }
.primary-button[disabled], .secondary-button[disabled], .danger-button[disabled], .ui-button[disabled] { background: #eef0f3 !important; color: #788292 !important; border-color: #e5e8ed !important; box-shadow: none !important; opacity: 1; }
.ui-utility-button { box-sizing:border-box; display:inline-flex; align-items:center; justify-content:center; width:auto !important; min-width:104rpx !important; min-height:52rpx; margin:0; padding:0 16rpx; border:1rpx solid #dce5e3 !important; border-radius:var(--radius-pill) !important; background:#f7f9f8 !important; color:#596562 !important; font-size:22rpx; font-weight:600; line-height:50rpx; white-space:nowrap; box-shadow:none !important; }
.ui-utility-button--primary { border-color:var(--button) !important; background:var(--button) !important; color:#fff !important; }

/*
 * 商城共用组件契约：页面只能控制位置与宽度，颜色、圆角和状态由这里统一。
 * 客服、帮助、设置等入口统一使用同一行结构；宫格场景仅增加 --tile 变体。
 */
.ui-list-row, .ui-service-entry { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; width: 100%; min-width: 0; min-height: 96rpx; margin: 0; padding: 22rpx 0; border: 0; border-bottom: 1rpx solid var(--line); border-radius: 0 !important; background: transparent !important; color: var(--ink) !important; font-size: 27rpx; font-weight: 400; line-height: 40rpx; text-align: left; white-space: normal; box-shadow: none !important; }
.ui-list-row:last-child, .ui-service-entry:last-child { border-bottom-color: transparent; }
.ui-list-row > view, .ui-service-entry > view { min-width: 0; flex: 1; }
.ui-list-caption { display: block; margin-top: 3rpx; color: var(--muted); font-size: 22rpx; line-height: 34rpx; overflow-wrap: anywhere; }
.ui-list-action { display: flex; align-items: center; flex: none; gap: 6rpx; color: var(--brand); font-size: 24rpx; white-space: nowrap; }
.ui-list-arrow { flex: none; width: 26rpx; height: 26rpx; opacity: .48; }
.ui-service-entry--tile { flex-direction: column; justify-content: center; min-height: 142rpx; padding: 14rpx 0; border-bottom: 0; text-align: center; }
.ui-service-entry--compact { min-height: 80rpx; padding: 16rpx 0; font-size: 24rpx; }
.ui-price { color: var(--price) !important; font-weight: 750; }
.ui-status-pill { display: inline-flex; align-items: center; flex: none; padding: 7rpx 13rpx; border-radius: var(--radius-pill) !important; background: var(--brand-soft) !important; color: var(--brand) !important; font-size: 22rpx; font-weight: 650; }
.ui-status-pill.is-closed { background: #f0f2f3 !important; color: #737d82 !important; }
.ui-action-bar, .ui-action-group { display: flex; align-items: center; flex-wrap: nowrap; justify-content: flex-end; gap: 12rpx; min-width: 0; }
.ui-action-button, .ui-order-action { box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; flex: none; width: auto !important; min-width: 0 !important; min-height: var(--action-height) !important; height: var(--action-height) !important; margin: 0; margin-left: 0 !important; margin-right: 0 !important; padding: 0 var(--action-padding-x) !important; border-radius: var(--radius-pill) !important; font-size: var(--action-font-size) !important; line-height: 1 !important; white-space: nowrap !important; }
.ui-action-button--primary, .ui-order-action--primary { order: 2; }
.ui-copy-action { box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; flex: none; width: auto !important; min-width: 0 !important; min-height: 52rpx !important; height: 52rpx !important; margin: 0; padding: 0 6rpx !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; color: var(--brand) !important; font-size: 22rpx !important; font-weight: 600; line-height: 52rpx !important; white-space: nowrap !important; box-shadow: none !important; }
.ui-copy-action::after { border: 0 !important; }
/*
 * 订单列表共用卡片：标题状态、真实商品快照、物流、金额、操作使用同一信息层级。
 * 页面只提供数据与事件，禁止再按订单状态单独放大按钮或拆散操作区。
 */
.ui-order-card { padding: 20rpx 22rpx; }
.ui-order-header, .ui-order-heading, .ui-order-product, .ui-order-logistics, .ui-order-summary, .ui-order-actions { display: flex; align-items: center; width: 100%; min-width: 0; }
.ui-order-header { justify-content: space-between; gap: 18rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid var(--line); }
.ui-order-heading { flex: 1; gap: 12rpx; overflow: hidden; }
.ui-order-merchant { min-width: 0; overflow: hidden; color: var(--ink); font-size: 27rpx; font-weight: 750; white-space: nowrap; text-overflow: ellipsis; }
.ui-order-copy { color: #697383 !important; }
.ui-order-status.is-active { color: var(--brand) !important; background: var(--brand-soft) !important; }
.ui-order-status.is-cancelled { color: #7b8492 !important; background: #f0f2f4 !important; }
.ui-order-status.is-completed { color: #596562 !important; background: #eef3f1 !important; }
.ui-order-products { border-bottom: 1rpx solid var(--line); }
.ui-order-product { align-items: stretch; gap: 18rpx; min-height: 198rpx; padding: 18rpx 0; color: var(--ink); border-bottom: 1rpx solid var(--line); }
.ui-order-product:last-child { border-bottom: 0; }
.ui-order-product > image { flex: none; width: 168rpx; height: 168rpx; border-radius: 12rpx; background: #eef0f3; }
.ui-order-product-copy { display: flex; flex: 1; flex-direction: column; justify-content: space-between; min-width: 0; overflow: hidden; }
.ui-order-product-name { display: -webkit-box; overflow: hidden; color: var(--ink); font-size: 29rpx; font-weight: 700; line-height: 38rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.ui-order-product-spec, .ui-order-product-prices { display: flex; align-items: baseline; justify-content: space-between; gap: 12rpx; min-width: 0; color: #8a929f; font-size: 24rpx; line-height: 32rpx; }
.ui-order-product-spec > text:first-child { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ui-order-product-spec > text:last-child, .ui-order-product-prices > text:last-child { flex: none; white-space: nowrap; }
.ui-order-service-tags { display: flex; gap: 8rpx; min-height: 32rpx; overflow: hidden; }
.ui-order-service-tags > text { flex: none; padding: 2rpx 10rpx; border-radius: 5rpx; color: var(--danger); background: var(--danger-soft); font-size: 22rpx; line-height: 30rpx; white-space: nowrap; }
.ui-order-product-prices { color: #6e7683; }
.ui-order-product-prices .ui-price { font-size: 27rpx; }
.ui-order-logistics { justify-content: space-between; gap: 14rpx; min-height: 58rpx; color: var(--muted); border-bottom: 1rpx solid var(--line); font-size: 22rpx; }
.ui-order-logistics > text:first-child { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.ui-order-logistics-action { flex: none; margin: 0; padding: 0; color: var(--brand); background: transparent; border: 0; font-size: 21rpx; font-weight: 650; line-height: 40rpx; white-space: nowrap; }
.ui-order-logistics-action::after { border: 0; }
.ui-order-summary { justify-content: space-between; gap: 18rpx; min-height: 66rpx; color: var(--muted); border-bottom: 1rpx solid var(--line); font-size: 22rpx; }
.ui-order-summary > view { display: flex; align-items: baseline; gap: 8rpx; color: #687180; white-space: nowrap; }
.ui-order-summary .ui-price { font-size: 30rpx; }
.ui-order-actions { flex-wrap: nowrap; justify-content: flex-end; gap: 12rpx; padding-top: 16rpx; overflow: hidden; }
.ui-order-action.secondary-button { color: var(--ink) !important; background: transparent !important; border-color: #d9dee5 !important; }
@media (max-width: 340px) {
  .ui-order-actions { gap: 8rpx; }
  .ui-order-actions .ui-order-action { min-height: 52rpx !important; height: 52rpx !important; padding: 0 12rpx !important; font-size: 24rpx !important; }
}
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.product-card { overflow: hidden; background: var(--paper); border: 1rpx solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
.product-cover { width: 100%; height: 296rpx; background: #eef0f3; display: block; }
.media-fallback { display: flex; align-items: center; justify-content: center; background: var(--brand-soft); }
.media-fallback image { width: 38%; height: 38%; opacity: .5; }
.product-copy { padding: 18rpx; }
.product-title { min-height: 76rpx; line-height: 38rpx; font-weight: 650; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.product-subtitle { margin-top: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-size: 24rpx; color: var(--muted); }
.product-price { margin-top: 14rpx; color: var(--price); font-size: 34rpx; font-weight: 750; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 4rpx 20rpx; }
.section-head text:first-child { font-size: 34rpx; font-weight: 750; }
.safe-bottom { height: env(safe-area-inset-bottom); }
