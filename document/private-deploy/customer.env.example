# 客户私有化部署环境变量模板
# 不要直接使用本文件启动。必须先执行 scripts/prepare-env.sh 生成权限为 600 的 .env。

DEPLOYMENT_ENV=production
COMPOSE_PROJECT_NAME=mall_customer
TZ=Asia/Shanghai
# 客户域名与来源
CUSTOMER_DOMAIN=mall.example.com
TEAM_DOMAIN=team.mall.example.com
ADMIN_DOMAIN=mall.example.com
API_BASE_URL=https://mall.example.com
CORS_ORIGINS=https://mall.example.com,https://team.mall.example.com

# 登录保持策略：后台7天/3个终端，商城30天/5个终端；密码修改或账号禁用仍会立即失效。
ADMIN_SESSION_HOURS=168
ADMIN_MAX_ACTIVE_SESSIONS=3
SHOP_SESSION_DAYS=30
SHOP_MAX_ACTIVE_SESSIONS=5

# 云防火墙是云厂商账号侧资源，部署程序必须看到三项真实确认后才允许启动。
CLOUD_FIREWALL_CONFIRMED=false
SSH_ALLOWED_CIDR=
CLOUD_FIREWALL_EVIDENCE=

# MySQL：只进入 Docker 内部数据网络，不映射任何宿主机端口。
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mall_distribution
DB_USER=mall_app
DB_PASSWORD=change_me_mysql_app_password
# MySQL 8 容器会自动建立 TLS；生产默认加密传输。外部托管数据库应升级为 VERIFY_IDENTITY 并配置可信 CA。
DB_SSL_MODE=REQUIRED

# Redis：只进入内部数据网络，不映射宿主机端口。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DATABASE=0

# 容器资源上限：按客户实际规格调整，但禁止留空或取消上限。
MYSQL_CPU_LIMIT=2.0
MYSQL_MEMORY_LIMIT=2g
MYSQL_PIDS_LIMIT=256
REDIS_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=512m
REDIS_PIDS_LIMIT=128
APP_CPU_LIMIT=2.0
APP_MEMORY_LIMIT=2g
APP_PIDS_LIMIT=256
NGINX_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=256m
NGINX_PIDS_LIMIT=128

# 身份证、银行卡和ERP凭证的数据库字段级加密密钥；丢失后密文无法恢复，必须纳入密钥备份。
DATA_ENCRYPTION_KEY=change_me_64_hex_data_encryption_key
DATA_ENCRYPTION_WRITE_ENABLED=true

# 客户资料初始化
CUSTOMER_NAME=客户公司名称
CUSTOMER_BRAND_NAME=客户商城名称
CUSTOMER_THEME_COLOR="#0f766e"
CUSTOMER_PRODUCT_TEMPLATE=standard

# 媒体文件
SHOP_MEDIA_STORAGE_DIR=/opt/lingqimall/uploads/products
SHOP_MEDIA_PRIVATE_STORAGE_DIR=/opt/lingqimall/uploads/private
SHOP_MEDIA_MAX_DIMENSION=1920
SHOP_MEDIA_MAX_PIXELS=25000000
SHOP_MEDIA_JPEG_QUALITY=0.82
SHOP_LOGISTICS_TRACKING_PROVIDER=NONE
SHOP_NEW_ARRIVAL_DAYS=30

# 私域直播。EXTERNAL 用于厂家固定 HTTPS 视频源；TENCENT 用于 App 主播短时推流。
SHOP_LIVE_PROVIDER=EXTERNAL
LIVE_PLAYBACK_ORIGIN=
TENCENT_LIVE_PUSH_DOMAIN=
TENCENT_LIVE_PLAY_DOMAIN=
TENCENT_LIVE_APP_NAME=live
TENCENT_LIVE_PUSH_AUTH_KEY=
TENCENT_LIVE_CALLBACK_AUTH_KEY=
TENCENT_LIVE_CREDENTIAL_SECONDS=7200

# 订单与支付基础参数
ORDER_PENDING_TIMEOUT_MINUTES=30
ORDER_PENDING_SCAN_INTERVAL_MS=60000
SCHEDULING_POOL_SIZE=4
ERP_SYNC_SCAN_INTERVAL_MS=60000
BONUS_CALCULATION_SCAN_INTERVAL_MS=5000
PAYMENT_LARGE_AMOUNT_VERIFY_ENABLED=false
PAYMENT_LARGE_AMOUNT_VERIFY_THRESHOLD=500
SHOP_WITHDRAWAL_DAILY_MAX_COUNT=2
SHOP_WITHDRAWAL_MONTHLY_MAX_COUNT=10
SHOP_WITHDRAWAL_MANUAL_REVIEW_THRESHOLD=1000.00

# 会员奖金自动转账：与商城收款分开签约和验收；默认全部关闭。
WITHDRAWAL_PAYOUT_ENABLED=false
WITHDRAWAL_PAYOUT_ALIPAY_ENABLED=false
WITHDRAWAL_PAYOUT_WECHAT_ENABLED=false
WITHDRAWAL_PAYOUT_WECHAT_SCENE_ID=
WITHDRAWAL_PAYOUT_WECHAT_REPORT_INFO_TYPE=
WITHDRAWAL_PAYOUT_WECHAT_REPORT_INFO_CONTENT=

# 微信小程序登录：每个客户必须使用自己的微信主体和密钥，审核完成前保持关闭。
WECHAT_MINI_PROGRAM_ENABLED=false
WECHAT_MINI_PROGRAM_PHONE_AUTH_ENABLED=false
WECHAT_MINI_PROGRAM_APP_ID=
WECHAT_MINI_PROGRAM_APP_SECRET=
WECHAT_MINI_PROGRAM_PRIVACY_VERSION=MINI_PROGRAM_PRIVACY_V1
WECHAT_MINI_PROGRAM_CONNECT_TIMEOUT_MS=5000
WECHAT_MINI_PROGRAM_READ_TIMEOUT_MS=10000

# 微信支付：程序已接入API v3；客户完成签约、AppID绑定和真机小额联调前保持关闭。
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MERCHANT_SERIAL_NUMBER=
WECHAT_PAY_CERT_DIR=./secrets/wechat-pay
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat-pay/apiclient_key.pem
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=/run/secrets/wechat-pay/wechatpay_public_key.pem
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_REFUND_NOTIFY_URL=
WECHAT_PAY_CONNECT_TIMEOUT_MS=5000
WECHAT_PAY_READ_TIMEOUT_MS=10000

# 支付宝：未开通时保持 false 且资料留空；启用后预检会强制校验 HTTPS 回调和全部字段。
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_CONNECT_TIMEOUT_MS=5000
ALIPAY_READ_TIMEOUT_MS=10000

# 阿里云短信：未开通时保持 false 且资料留空；启用后预检会强制校验全部字段。
SMS_PROVIDER_ENABLED=false

# 实名认证：默认关闭；开通腾讯云实名认证服务后填写，只保存在服务器受限环境文件中。
SHOP_REAL_NAME_ENABLED=false
TENCENT_FACEID_SECRET_ID=
TENCENT_FACEID_SECRET_KEY=
TENCENT_FACEID_REGION=ap-guangzhou
TENCENT_FACEID_ENDPOINT=faceid.tencentcloudapi.com
SHOP_REAL_NAME_DAILY_MAX_ATTEMPTS=5
TENCENT_FACEID_CONNECT_TIMEOUT_SECONDS=5
TENCENT_FACEID_READ_TIMEOUT_SECONDS=10
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
SMS_ALIYUN_CONNECT_TIMEOUT_MS=5000
SMS_ALIYUN_READ_TIMEOUT_MS=10000
SMS_ALIYUN_SIGN_NAME=
SMS_TEMPLATE_REGISTER=
SMS_TEMPLATE_LOGIN=
SMS_TEMPLATE_RESET_PASSWORD=
SMS_TEMPLATE_TRANSFER=
SMS_TEMPLATE_WITHDRAW=
SMS_TEMPLATE_PAYMENT=
SMS_TEMPLATE_PAYMENT_PASSWORD=

# 业务通知发送内核：与上方验证码短信完全隔离。本候选默认全部关闭；资料、审核模板、预算、授权和验收缺一不可。
EXTERNAL_NOTIFICATION_ENABLED=false
EXTERNAL_NOTIFICATION_WORKER_ENABLED=false
EXTERNAL_NOTIFICATION_BATCH_SIZE=20
EXTERNAL_NOTIFICATION_LEASE_SECONDS=120
EXTERNAL_NOTIFICATION_TASK_TTL_HOURS=72
EXTERNAL_NOTIFICATION_MAX_ATTEMPTS=5
EXTERNAL_NOTIFICATION_BASE_RETRY_SECONDS=60
EXTERNAL_NOTIFICATION_MAX_RETRY_SECONDS=21600
EXTERNAL_NOTIFICATION_UNKNOWN_QUERY_LIMIT=12
NOTIFICATION_SMS_ALIYUN_ENABLED=false
NOTIFICATION_SMS_ALIYUN_ACCESS_KEY_ID=
NOTIFICATION_SMS_ALIYUN_ACCESS_KEY_SECRET=
NOTIFICATION_SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
NOTIFICATION_SMS_ALIYUN_SIGN_NAME=
NOTIFICATION_SMS_ALIYUN_RECEIPT_SECRET=
NOTIFICATION_SMS_ALIYUN_CONNECT_TIMEOUT_MS=5000
NOTIFICATION_SMS_ALIYUN_READ_TIMEOUT_MS=10000
NOTIFICATION_SMS_UNIT_COST=0.0500
NOTIFICATION_SMS_TEMPLATE_LOGIN_PASSWORD_CHANGED=
NOTIFICATION_SMS_TEMPLATE_PAY_PASSWORD_CHANGED=
NOTIFICATION_SMS_TEMPLATE_PHONE_CHANGED=
NOTIFICATION_SMS_TEMPLATE_ORDER_SHIPPED=
NOTIFICATION_SMS_TEMPLATE_AFTER_SALE_UPDATED=
NOTIFICATION_SMS_TEMPLATE_REFUND_RESULT=
# App 推送和小程序本轮没有真实供应商；生产部署必须保持以下三项 false。
NOTIFICATION_MOCK_ENABLED=false
NOTIFICATION_MOCK_APP_PUSH_ENABLED=false
NOTIFICATION_MOCK_MINI_PROGRAM_ENABLED=false
