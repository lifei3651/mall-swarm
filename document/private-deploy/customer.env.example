# 客户私有化部署环境变量模板
# 使用前复制为 .env，并为每个客户生成独立强密码。

COMPOSE_PROJECT_NAME=mall_customer
TZ=Asia/Shanghai
SERVER_ADDRESS=0.0.0.0

# 业务域名
CUSTOMER_DOMAIN=mall.example.com
ADMIN_DOMAIN=admin.example.com
API_BASE_URL=https://mall.example.com
CORS_ORIGINS=https://mall.example.com,https://admin.example.com

# MySQL
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mall
DB_USER=mall_app
DB_PASSWORD=change_me_mysql_app_password
DB_SSL_MODE=REQUIRED

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DATABASE=0

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=mall

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=mall
RABBITMQ_PASS=change_me_rabbitmq_password
RABBITMQ_VHOST=/mall

# Elasticsearch
ES_HOST=http://elasticsearch
ES_PORT=9200

# Nacos
NACOS_SERVER=nacos-registry:8848

# Monitor
MONITOR_ADMIN_USER=monitor_admin
MONITOR_ADMIN_PASSWORD=change_me_monitor_password

# Sa-Token / JWT
SA_TOKEN_JWT_KEY=change_me_very_long_random_jwt_secret
SA_TOKEN_TIMEOUT=86400
SA_TOKEN_ACTIVE_TIMEOUT=1800

# 客户资料初始化
CUSTOMER_NAME=客户公司名称
CUSTOMER_BRAND_NAME=客户商城名称
CUSTOMER_THEME_COLOR=#0f766e
CUSTOMER_PRODUCT_TEMPLATE=standard

# 媒体文件（必须挂载持久化目录，不能只放在容器临时层）
SHOP_MEDIA_STORAGE_DIR=/opt/lingqimall/uploads/products
SHOP_MEDIA_PRIVATE_STORAGE_DIR=/opt/lingqimall/uploads/private
SHOP_MEDIA_MAX_DIMENSION=1920
SHOP_MEDIA_MAX_PIXELS=25000000
SHOP_MEDIA_JPEG_QUALITY=0.82
SHOP_LOGISTICS_TRACKING_PROVIDER=NONE

# 订单与支付基础参数
ORDER_PENDING_TIMEOUT_MINUTES=30
ORDER_PENDING_SCAN_INTERVAL_MS=60000
PAYMENT_LARGE_AMOUNT_VERIFY_ENABLED=false
PAYMENT_LARGE_AMOUNT_VERIFY_THRESHOLD=500

# 支付宝手机网站支付（仅填写客户自己的应用信息；密钥禁止提交 Git）
ALIPAY_ENABLED=false
ALIPAY_APP_ID=客户支付宝应用APPID
ALIPAY_PRIVATE_KEY=请填一行格式的应用私钥
ALIPAY_PUBLIC_KEY=请填一行格式的支付宝公钥
ALIPAY_NOTIFY_URL=https://mall.example.com/api/pay/alipay/notify
ALIPAY_RETURN_URL=https://mall.example.com/api/pay/alipay/return

# 阿里云短信（按客户申请的签名、模板填写；未开通时保持 false）
SMS_PROVIDER_ENABLED=false
SMS_ALIYUN_ACCESS_KEY_ID=客户短信AccessKeyId
SMS_ALIYUN_ACCESS_KEY_SECRET=客户短信AccessKeySecret
SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
SMS_ALIYUN_SIGN_NAME=客户短信签名
SMS_TEMPLATE_REGISTER=客户注册模板CODE
SMS_TEMPLATE_LOGIN=客户登录模板CODE
SMS_TEMPLATE_RESET_PASSWORD=客户重置密码模板CODE
SMS_TEMPLATE_TRANSFER=客户转账模板CODE
SMS_TEMPLATE_WITHDRAW=客户提现模板CODE
SMS_TEMPLATE_PAYMENT=客户支付验证模板CODE
SMS_TEMPLATE_PAYMENT_PASSWORD=客户支付密码模板CODE
