# 客户私有化部署环境变量模板
# 不要直接使用本文件启动。必须先执行 scripts/prepare-env.sh 生成权限为 600 的 .env。

DEPLOYMENT_ENV=production
COMPOSE_PROJECT_NAME=mall_customer
TZ=Asia/Shanghai
# 客户域名与来源
CUSTOMER_DOMAIN=mall.example.com
TEAM_DOMAIN=team.mall.example.com
ADMIN_DOMAIN=mall.example.com
API_BASE_URL=https://mall.example.com
CORS_ORIGINS=https://mall.example.com,https://team.mall.example.com

# 云防火墙是云厂商账号侧资源，部署程序必须看到三项真实确认后才允许启动。
CLOUD_FIREWALL_CONFIRMED=false
SSH_ALLOWED_CIDR=
CLOUD_FIREWALL_EVIDENCE=

# MySQL：只进入 Docker 内部数据网络，不映射任何宿主机端口。
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mall_distribution
DB_USER=mall_app
DB_PASSWORD=change_me_mysql_app_password
# MySQL 8 容器会自动建立 TLS；生产默认加密传输。外部托管数据库应升级为 VERIFY_IDENTITY 并配置可信 CA。
DB_SSL_MODE=REQUIRED

# Redis：只进入内部数据网络，不映射宿主机端口。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_DATABASE=0

# 容器资源上限：按客户实际规格调整，但禁止留空或取消上限。
MYSQL_CPU_LIMIT=2.0
MYSQL_MEMORY_LIMIT=2g
MYSQL_PIDS_LIMIT=256
REDIS_CPU_LIMIT=1.0
REDIS_MEMORY_LIMIT=512m
REDIS_PIDS_LIMIT=128
APP_CPU_LIMIT=2.0
APP_MEMORY_LIMIT=2g
APP_PIDS_LIMIT=256
NGINX_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=256m
NGINX_PIDS_LIMIT=128

# 会话密钥
SA_TOKEN_JWT_KEY=change_me_very_long_random_jwt_secret
# 身份证、银行卡和ERP凭证的数据库字段级加密密钥；丢失后密文无法恢复，必须纳入密钥备份。
DATA_ENCRYPTION_KEY=change_me_64_hex_data_encryption_key
DATA_ENCRYPTION_WRITE_ENABLED=true
SA_TOKEN_TIMEOUT=43200
SA_TOKEN_ACTIVE_TIMEOUT=1800

# 客户资料初始化
CUSTOMER_NAME=客户公司名称
CUSTOMER_BRAND_NAME=客户商城名称
CUSTOMER_THEME_COLOR="#0f766e"
CUSTOMER_PRODUCT_TEMPLATE=standard

# 媒体文件
SHOP_MEDIA_STORAGE_DIR=/opt/lingqimall/uploads/products
SHOP_MEDIA_PRIVATE_STORAGE_DIR=/opt/lingqimall/uploads/private
SHOP_MEDIA_MAX_DIMENSION=1920
SHOP_MEDIA_MAX_PIXELS=25000000
SHOP_MEDIA_JPEG_QUALITY=0.82
SHOP_LOGISTICS_TRACKING_PROVIDER=NONE

# 订单与支付基础参数
ORDER_PENDING_TIMEOUT_MINUTES=30
ORDER_PENDING_SCAN_INTERVAL_MS=60000
SCHEDULING_POOL_SIZE=4
ERP_SYNC_SCAN_INTERVAL_MS=60000
BONUS_CALCULATION_SCAN_INTERVAL_MS=5000
PAYMENT_LARGE_AMOUNT_VERIFY_ENABLED=false
PAYMENT_LARGE_AMOUNT_VERIFY_THRESHOLD=500
SHOP_WITHDRAWAL_DAILY_MAX_COUNT=5
SHOP_WITHDRAWAL_MONTHLY_MAX_COUNT=50
SHOP_WITHDRAWAL_DAILY_MAX_AMOUNT=100000.00
SHOP_WITHDRAWAL_MONTHLY_MAX_AMOUNT=1000000.00

# 支付宝：未开通时保持 false 且资料留空；启用后预检会强制校验 HTTPS 回调和全部字段。
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_CONNECT_TIMEOUT_MS=5000
ALIPAY_READ_TIMEOUT_MS=10000

# 阿里云短信：未开通时保持 false 且资料留空；启用后预检会强制校验全部字段。
SMS_PROVIDER_ENABLED=false
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_ENDPOINT=dysmsapi.aliyuncs.com
SMS_ALIYUN_CONNECT_TIMEOUT_MS=5000
SMS_ALIYUN_READ_TIMEOUT_MS=10000
SMS_ALIYUN_SIGN_NAME=
SMS_TEMPLATE_REGISTER=
SMS_TEMPLATE_LOGIN=
SMS_TEMPLATE_RESET_PASSWORD=
SMS_TEMPLATE_TRANSFER=
SMS_TEMPLATE_WITHDRAW=
SMS_TEMPLATE_PAYMENT=
SMS_TEMPLATE_PAYMENT_PASSWORD=
