# 构建产物（避免 git add . 把编译结果和大型包带入提交）
target/
dist/
*.jar
*.class

# 项目构建启动器必须随仓库保留
!.mvn/wrapper/maven-wrapper.jar
!mall-shop-web/android/gradle/wrapper/gradle-wrapper.jar

# 依赖目录
node_modules/
__pycache__/
*.pyc

# macOS
.DS_Store

# 日志与临时文件
*.log
*.tmp

# 本地 IDE 配置
.idea/

# 本地密钥与 Codex 会话文件（禁止进入仓库）
.env
.env.*
!.env.example
!*.env.example
!mall-shop-web/.env.android
!mall-shop-web/.env.public
!mall-shop-web/.env.team
.codex/

# 客户私有部署产生的运行数据、证书、验收报告和真实配置
document/private-deploy/data/
document/private-deploy/certs/
document/private-deploy/logs/
document/private-deploy/reports/
document/private-deploy/backups/
document/private-deploy/html/
