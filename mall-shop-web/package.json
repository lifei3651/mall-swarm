{
  "name": "lingqi-mall-storefront",
  "version": "1.0.0",
  "description": "用户商城前台",
  "author": "长沙灵启软件开发有限公司",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode public",
    "dev:team": "vite --mode team",
    "dev:integrated": "vite --mode integrated",
    "build": "npm run build:public && npm run build:team && npm run build:integrated",
    "build:public": "vite build --mode public && npm run check:public-surface",
    "build:team": "vite build --mode team && npm run check:team-surface",
    "build:integrated": "vite build --mode integrated && npm run check:integrated-surface",
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "check:team-surface": "node scripts/check-team-surface.mjs",
    "check:integrated-surface": "node scripts/check-integrated-surface.mjs",
    "test": "node --test tests/*.test.mjs",
    "build:android:web": "vite build --mode android",
    "sync:android": "npm run build:android:web && cap sync android",
    "build:android": "npm run sync:android && bash scripts/build-android.sh",
    "open:android": "cap open android",
    "preview": "vite preview",
    "preview:integrated": "vite preview --outDir dist-integrated --port 4175"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.4.2",
    "axios": "^1.6.5",
    "element-china-area-data": "^6.1.0",
    "hls.js": "^1.6.13",
    "lucide-vue-next": "^0.468.0",
    "qrcode": "^1.5.4",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.1.5"
  }
}
