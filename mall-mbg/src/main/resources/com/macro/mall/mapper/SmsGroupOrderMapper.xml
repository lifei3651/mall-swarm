<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.mall.mapper.SmsGroupOrderMapper">
  <resultMap id="BaseResultMap" type="com.macro.mall.model.SmsGroupOrder">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="group_buy_id" jdbcType="BIGINT" property="groupBuyId" />
    <result column="group_no" jdbcType="VARCHAR" property="groupNo" />
    <result column="order_id" jdbcType="BIGINT" property="orderId" />
    <result column="order_sn" jdbcType="VARCHAR" property="orderSn" />
    <result column="member_id" jdbcType="BIGINT" property="memberId" />
    <result column="member_name" jdbcType="VARCHAR" property="memberName" />
    <result column="is_leader" jdbcType="INTEGER" property="isLeader" />
    <result column="status" jdbcType="INTEGER" property="status" />
    <result column="expire_time" jdbcType="TIMESTAMP" property="expireTime" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
  </resultMap>
  <select id="selectByGroupNo" parameterType="java.lang.String" resultMap="BaseResultMap">select * from sms_group_order where group_no=#{groupNo} order by create_time</select>
  <select id="selectByMemberId" parameterType="java.lang.Long" resultMap="BaseResultMap">select * from sms_group_order where member_id=#{memberId} order by create_time desc</select>
  <select id="selectByGroupBuyId" parameterType="java.lang.Long" resultMap="BaseResultMap">select * from sms_group_order where group_buy_id=#{groupBuyId}</select>
  <select id="countByGroupBuyIdAndMemberId" resultType="int">select count(*) from sms_group_order where group_buy_id=#{groupBuyId} and member_id=#{memberId} and status in (0,1)</select>
  <select id="countActiveByGroupNo" resultType="int">select count(*) from sms_group_order where group_no=#{groupNo} and status=0</select>
  <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">select * from sms_group_order where id=#{id}</select>
  <insert id="insert" parameterType="com.macro.mall.model.SmsGroupOrder" useGeneratedKeys="true" keyProperty="id">insert into sms_group_order(group_buy_id,group_no,order_id,order_sn,member_id,member_name,is_leader,status,expire_time) values(#{groupBuyId},#{groupNo},#{orderId},#{orderSn},#{memberId},#{memberName},#{isLeader},#{status},#{expireTime})</insert>
  <update id="updateByPrimaryKey" parameterType="com.macro.mall.model.SmsGroupOrder">update sms_group_order set group_buy_id=#{groupBuyId},group_no=#{groupNo},order_id=#{orderId},order_sn=#{orderSn},member_id=#{memberId},member_name=#{memberName},is_leader=#{isLeader},status=#{status},expire_time=#{expireTime} where id=#{id}</update>
</mapper>
